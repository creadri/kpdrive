#: src/daemon.rs:112
msgid "Signed out. Sign in from the account window."
msgstr "Utloggad. Logga in från kontofönstret."

#: src/daemon.rs:114 src/daemon.rs:401
msgid "Syncing…"
msgstr "Synkroniserar…"

#: src/daemon.rs:116 src/daemon.rs:404
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} objekt synkroniserat"
msgstr[1] "{n} objekt synkroniserade"

#: src/daemon.rs:126 ui/qml/main.qml:409
msgid "Open folder"
msgstr "Öppna mapp"

#: src/daemon.rs:136
msgid "Account and logs…"
msgstr "Konto och logg…"

#: src/daemon.rs:143 ui/qml/main.qml:396
msgid "Sync now"
msgstr "Synkronisera nu"

#: src/daemon.rs:155
msgid "Pause sync"
msgstr "Pausa synkroniseringen"

#: src/daemon.rs:168
msgid "Quit"
msgstr "Avsluta"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:328
msgid "{reason}; retrying"
msgstr "{reason}; försöker igen"

#: src/daemon.rs:339
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive går att nå igen, efter {duration}"

#: src/daemon.rs:350
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} sekund"
msgstr[1] "{n} sekunder"

#: src/daemon.rs:351
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minut"
msgstr[1] "{n} minuter"

#: src/daemon.rs:352
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} timme"
msgstr[1] "{n} timmar"

#: src/daemon.rs:382
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"Synkroniseringstjänsten körs inte. Starta den med: kpdrive sync --watch"

#: src/daemon.rs:385
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"En synkroniseringstjänst körs, men den är för gammal för att kunna berätta "
"vad den gör. Starta om den."

#: src/daemon.rs:391
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Utloggad. Synkroniseringen återupptas när du loggar in."

#: src/daemon.rs:395
msgid "{reason}. Still trying."
msgstr "{reason}. Försöker fortfarande."

#: src/daemon.rs:396
msgid "Last sync failed: {reason}"
msgstr "Senaste synkroniseringen misslyckades: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:410
msgid "just now"
msgstr "just nu"

#: src/daemon.rs:412
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "för {n} minut sedan"
msgstr[1] "för {n} minuter sedan"

#: src/daemon.rs:415
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "för {n} timme sedan"
msgstr[1] "för {n} timmar sedan"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:419
msgid "{items}, checked {ago}"
msgstr "{items}, kontrollerat {ago}"

#: src/daemon.rs:637
msgid "Signed in again. Syncing resumed."
msgstr "Inloggad igen. Synkroniseringen har återupptagits."

#: src/daemon.rs:712
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Utloggad. Logga in från kontofönstret för att återuppta synkroniseringen."

#: src/daemon.rs:745
msgid "Sync resumed"
msgstr "Synkroniseringen återupptagen"

#: src/daemon.rs:762
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} foto hämtat"
msgstr[1] "{n} foton hämtade"

#: src/daemon.rs:783
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} foto uppladdat till Proton Photos"
msgstr[1] "{n} foton uppladdade till Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:334
msgid "Sign out"
msgstr "Logga ut"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} foto"
msgstr[1] "{n} foton"

#: src/pause.rs:20
msgid "Paused"
msgstr "Pausad"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "Pausad vid nätström"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "Pausad vid batteridrift"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "Pausad vid låg batterinivå"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "Pausad vid anslutning till {network}"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Synkronisera till den och behåll det som redan finns"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Flytta undan den och börja med en tom mapp"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"{folder} innehåller redan {n} objekt, som synkroniseringen slår samman med "
"Proton Drive."
msgstr[1] ""
"{folder} innehåller redan {n} objekt, som synkroniseringen slår samman med "
"Proton Drive."

#: ui/src/bridge.rs:237
msgid "Starting…"
msgstr "Startar…"

#: ui/src/bridge.rs:288
msgid "Confirm the code {code} in your browser"
msgstr "Bekräfta koden {code} i webbläsaren"

#: ui/src/bridge.rs:302
msgid "Sign-in failed: {reason}"
msgstr "Inloggningen misslyckades: {reason}"

#: ui/src/bridge.rs:314
msgid "Signed out"
msgstr "Utloggad"

#: ui/src/bridge.rs:317
msgid "Sign-out failed: {reason}"
msgstr "Utloggningen misslyckades: {reason}"

#: ui/src/bridge.rs:382
msgid "{note}. Restart the sync daemon to use it."
msgstr ""
"{note}. Starta om synkroniseringstjänsten så att ändringen börjar gälla."

#: ui/src/bridge.rs:385
msgid "Cannot change the folder: {reason}"
msgstr "Det går inte att byta mapp: {reason}"

#: ui/src/bridge.rs:392
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Ingen synkroniseringsmapp än. Kör: kpdrive setup"

#: ui/src/bridge.rs:396
msgid "Cannot create the ignore file: {reason}"
msgstr "Det går inte att skapa ignoreringsfilen: {reason}"

#: ui/src/bridge.rs:434
msgid "Checking the account…"
msgstr "Kontrollerar kontot…"

#: ui/src/bridge.rs:440
msgid "Opening the browser…"
msgstr "Öppnar webbläsaren…"

#: ui/src/bridge.rs:446
msgid "Signing out…"
msgstr "Loggar ut…"

#: ui/src/bridge.rs:472
msgid "Cannot read the log: {reason}"
msgstr "Det går inte att läsa loggen: {reason}"

#: ui/src/bridge.rs:482 ui/src/bridge.rs:510 ui/src/bridge.rs:524
#: ui/src/bridge.rs:539 ui/src/bridge.rs:573 ui/src/bridge.rs:614
#: ui/src/bridge.rs:627 ui/src/bridge.rs:645
msgid "Cannot save the setting: {reason}"
msgstr "Det går inte att spara inställningen: {reason}"

#: ui/src/bridge.rs:490
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos hämtas vid nästa synkronisering"

#: ui/src/bridge.rs:491
msgid "Proton Photos will be left alone"
msgstr "Proton Photos lämnas orört"

#: ui/src/bridge.rs:516
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr "Foton som läggs i den mappen laddas upp till Proton Photos"

#: ui/src/bridge.rs:517
msgid "No longer uploading photos"
msgstr "Foton laddas inte längre upp"

#: ui/src/bridge.rs:607
msgid "Photos will be downloaded into that folder from the next pass"
msgstr "Foton hämtas till den mappen från och med nästa synkronisering"

#: ui/src/bridge.rs:632
msgid "Storing everything from now on"
msgstr "Lagrar allt från och med nu"

#: ui/src/bridge.rs:633
msgid "Storing warnings and errors from now on"
msgstr "Lagrar varningar och fel från och med nu"

#: ui/src/bridge.rs:634
msgid "Storing errors from now on"
msgstr "Lagrar fel från och med nu"

#: ui/src/bridge.rs:650
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "tog bort {n} loggfil som är äldre än {days} dagar"
msgstr[1] "tog bort {n} loggfiler som är äldre än {days} dagar"

#: ui/src/bridge.rs:651
msgid "Cannot prune the log: {reason}"
msgstr "Det går inte att rensa loggen: {reason}"

#: ui/qml/main.qml:28
msgid "Choose the Proton Drive folder"
msgstr "Välj Proton Drive-mappen"

#: ui/qml/main.qml:35
msgid "Choose where Proton Photos are downloaded"
msgstr "Välj vart Proton Photos hämtas"

#: ui/qml/main.qml:42
msgid "Choose the folder to upload photos from"
msgstr "Välj mappen som foton laddas upp från"

#: ui/qml/main.qml:53
msgid "The folder is not empty"
msgstr "Mappen är inte tom"

#: ui/qml/main.qml:104
msgid "Opened {what}"
msgstr "Öppnade {what}"

#: ui/qml/main.qml:106
msgid "Could not open {what} ({url})"
msgstr "Det gick inte att öppna {what} ({url})"

#: ui/qml/main.qml:186
msgid "Account & activity"
msgstr "Konto och aktivitet"

#: ui/qml/main.qml:187
msgid "Settings"
msgstr "Inställningar"

#: ui/qml/main.qml:188 ui/qml/main.qml:633
msgid "Logs"
msgstr "Logg"

#: ui/qml/main.qml:189
msgid "About"
msgstr "Om"

#: ui/qml/main.qml:269
msgid "Not signed in"
msgstr "Inte inloggad"

#: ui/qml/main.qml:276
msgid "Signed in to Proton Drive"
msgstr "Inloggad på Proton Drive"

#: ui/qml/main.qml:277
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Logga in för att synkronisera den här datorn med Proton Drive."

#: ui/qml/main.qml:294
msgid "Storage:"
msgstr "Lagring:"

#: ui/qml/main.qml:323
msgid "{used} of {total} used"
msgstr "{used} av {total} använt"

#: ui/qml/main.qml:331
msgid "Account:"
msgstr "Konto:"

#: ui/qml/main.qml:334
msgid "Sign in"
msgstr "Logga in"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:341
msgid "Refresh"
msgstr "Uppdatera"

#: ui/qml/main.qml:350
msgid "On the web:"
msgstr "På webben:"

#: ui/qml/main.qml:353
msgid "Drive on the web"
msgstr "Drive på webben"

#: ui/qml/main.qml:358
msgid "Proton account"
msgstr "Proton-konto"

#: ui/qml/main.qml:366
msgid "Activity"
msgstr "Aktivitet"

#: ui/qml/main.qml:373
msgid "Sync:"
msgstr "Synkronisering:"

#: ui/qml/main.qml:404
msgid "Resume"
msgstr "Återuppta"

#: ui/qml/main.qml:404
msgid "Pause"
msgstr "Pausa"

#: ui/qml/main.qml:429
msgid "Files"
msgstr "Filer"

#: ui/qml/main.qml:433
msgid "Sync folder:"
msgstr "Synkroniseringsmapp:"

#: ui/qml/main.qml:437
msgid "nowhere yet"
msgstr "ingen än"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:443 ui/qml/main.qml:490 ui/qml/main.qml:533
msgid "Change…"
msgstr "Ändra…"

#: ui/qml/main.qml:450
msgid "Ignored paths:"
msgstr "Ignorerade sökvägar:"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves
#. alone
#: ui/qml/main.qml:452
msgid "Ignore file…"
msgstr "Ignoreringsfil…"

#: ui/qml/main.qml:459
msgid "Photos"
msgstr "Foton"

#: ui/qml/main.qml:463
msgid "Download:"
msgstr "Hämtning:"

#: ui/qml/main.qml:467
msgid "Also download Proton Photos"
msgstr "Hämta även Proton Photos"

#: ui/qml/main.qml:473
msgid ""
"Your timeline is copied here every half hour. Nothing in Proton Photos is "
"changed or deleted by it."
msgstr ""
"Din tidslinje kopieras hit varje halvtimme. Ingenting i Proton Photos ändras "
"eller tas bort av det."

#: ui/qml/main.qml:481
msgid "Download folder:"
msgstr "Hämtningsmapp:"

#: ui/qml/main.qml:485
msgid "your Pictures folder"
msgstr "din mapp Bilder"

#: ui/qml/main.qml:497
msgid "Upload:"
msgstr "Uppladdning:"

#: ui/qml/main.qml:501
msgid "Upload photos from a folder"
msgstr "Ladda upp foton från en mapp"

#: ui/qml/main.qml:515
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""
"Foton och videor som läggs i den här mappen laddas upp till Proton Photos "
"inom en minut och försvinner sedan från mappen. Det som inte kan laddas upp "
"stannar kvar."

#: ui/qml/main.qml:523
msgid "Upload folder:"
msgstr "Uppladdningsmapp:"

#: ui/qml/main.qml:540
msgid "After upload:"
msgstr "Efter uppladdning:"

#: ui/qml/main.qml:542
msgid "Delete instead of moving to the trash"
msgstr "Ta bort i stället för att flytta till papperskorgen"

#: ui/qml/main.qml:549
msgid "Network"
msgstr "Nätverk"

#: ui/qml/main.qml:553 ui/qml/main.qml:598
msgid "Pause while on:"
msgstr "Pausa vid:"

#: ui/qml/main.qml:573
msgid "{network} (connected)"
msgstr "{network} (ansluten)"

#: ui/qml/main.qml:584
msgid ""
"Syncing pauses while any ticked network is connected, such as a phone's "
"hotspot. A sync already under way finishes first."
msgstr ""
"Synkroniseringen pausas medan något markerat nätverk är anslutet, till "
"exempel en telefons surfzon. En synkronisering som redan pågår slutförs "
"först."

#: ui/qml/main.qml:585
msgid "NetworkManager lists no networks to choose from."
msgstr "NetworkManager listar inga nätverk att välja bland."

#: ui/qml/main.qml:594
msgid "Power"
msgstr "Ström"

#: ui/qml/main.qml:604
msgid "AC power"
msgstr "Nätström"

#: ui/qml/main.qml:605
msgid "Battery"
msgstr "Batteri"

#: ui/qml/main.qml:606
msgid "Low battery"
msgstr "Låg batterinivå"

#: ui/qml/main.qml:614
msgid "{power} (now)"
msgstr "{power} (nu)"

#: ui/qml/main.qml:624
msgid ""
"Low battery is the level set in the system's power management settings. A "
"sync already under way finishes first."
msgstr ""
"Låg batterinivå är den nivå som anges i systemets inställningar för "
"energisparhantering. En synkronisering som redan pågår slutförs först."

#: ui/qml/main.qml:637
msgid "Keep logs for:"
msgstr "Spara loggen i:"

#. TRANSLATORS: after the number in "Keep logs for: [30] days"
#: ui/qml/main.qml:646
msgid "days"
msgstr "dagar"

#. TRANSLATORS: label before a dropdown choosing which log levels are written
#. to disk
#: ui/qml/main.qml:651
msgid "Store:"
msgstr "Spara:"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:656
msgid "Warnings and errors"
msgstr "Varningar och fel"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:658
msgid "Everything"
msgstr "Allt"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:660
msgid "Errors only"
msgstr "Endast fel"

#: ui/qml/main.qml:681
msgid "Search the log"
msgstr "Sök i loggen"

#: ui/qml/main.qml:686
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} rad"
msgstr[1] "{n} rader"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:736
msgid "Copy"
msgstr "Kopiera"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:742
msgid "Select all"
msgstr "Markera allt"

#: ui/qml/main.qml:759
msgid "No lines match"
msgstr "Inga rader matchar"

#: ui/qml/main.qml:759
msgid "Nothing logged yet"
msgstr "Inget loggat än"

#: ui/qml/main.qml:761
msgid "No line since the sync daemon started contains “{term}”."
msgstr "Ingen rad sedan synkroniseringstjänsten startade innehåller ”{term}”."

#: ui/qml/main.qml:762
msgid "This shows what has happened since the sync daemon started."
msgstr "Här visas vad som har hänt sedan synkroniseringstjänsten startade."

#: ui/qml/main.qml:794
msgid "Proton Drive sync client for KDE Plasma"
msgstr "Proton Drive-synkroniseringsklient för KDE Plasma"


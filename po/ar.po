#: src/daemon.rs:98
msgid "Signed out. Sign in from the account window."
msgstr "خرجتَ من الحساب. سجّل الدخول من نافذة الحساب."

#: src/daemon.rs:100 src/daemon.rs:341
msgid "Syncing…"
msgstr "تجري المزامنة…"

#: src/daemon.rs:102 src/daemon.rs:344
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "لا عناصر متزامنة"
msgstr[1] "عنصر واحد متزامن"
msgstr[2] "عنصران متزامنان"
msgstr[3] "{n} عناصر متزامنة"
msgstr[4] "{n} عنصرًا متزامنًا"
msgstr[5] "{n} عنصر متزامن"

#: src/daemon.rs:112 ui/qml/main.qml:313
msgid "Open folder"
msgstr "افتح المجلد"

#: src/daemon.rs:122
msgid "Account and logs…"
msgstr "الحساب والسجلات…"

#: src/daemon.rs:129 ui/qml/main.qml:291
msgid "Sync now"
msgstr "زامن الآن"

#: src/daemon.rs:139
msgid "Quit"
msgstr "أنهِ"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:273
msgid "{reason}; retrying"
msgstr "{reason}؛ تُعاد المحاولة"

#: src/daemon.rs:284
msgid "Proton Drive is reachable again, after {duration}"
msgstr "عاد Proton Drive متاحًا بعد {duration}"

#: src/daemon.rs:295
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} ثانية"
msgstr[1] "ثانية واحدة"
msgstr[2] "ثانيتان"
msgstr[3] "{n} ثوانٍ"
msgstr[4] "{n} ثانية"
msgstr[5] "{n} ثانية"

#: src/daemon.rs:296
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} دقيقة"
msgstr[1] "دقيقة واحدة"
msgstr[2] "دقيقتان"
msgstr[3] "{n} دقائق"
msgstr[4] "{n} دقيقة"
msgstr[5] "{n} دقيقة"

#: src/daemon.rs:297
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} ساعة"
msgstr[1] "ساعة واحدة"
msgstr[2] "ساعتان"
msgstr[3] "{n} ساعات"
msgstr[4] "{n} ساعة"
msgstr[5] "{n} ساعة"

#: src/daemon.rs:325
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "خدمة المزامنة لا تعمل. شغّلها بالأمر: kpdrive sync --watch"

#: src/daemon.rs:328
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr "خدمة المزامنة تعمل لكنها أقدم من أن تُبلّغ عمّا تفعله. أعد تشغيلها."

#: src/daemon.rs:331
msgid "Signed out. Syncing resumes once you sign in."
msgstr "خرجتَ من الحساب. تستأنف المزامنة بمجرد تسجيل الدخول."

#: src/daemon.rs:335
msgid "{reason}. Still trying."
msgstr "{reason}. ما زالت المحاولة جارية."

#: src/daemon.rs:336
msgid "Last sync failed: {reason}"
msgstr "فشلت آخر مزامنة: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:350
msgid "just now"
msgstr "منذ لحظات"

#: src/daemon.rs:352
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "منذ {n} دقيقة"
msgstr[1] "منذ دقيقة واحدة"
msgstr[2] "منذ دقيقتين"
msgstr[3] "منذ {n} دقائق"
msgstr[4] "منذ {n} دقيقة"
msgstr[5] "منذ {n} دقيقة"

#: src/daemon.rs:355
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "منذ {n} ساعة"
msgstr[1] "منذ ساعة واحدة"
msgstr[2] "منذ ساعتين"
msgstr[3] "منذ {n} ساعات"
msgstr[4] "منذ {n} ساعة"
msgstr[5] "منذ {n} ساعة"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:359
msgid "{items}, checked {ago}"
msgstr "{items}، آخر فحص {ago}"

#: src/daemon.rs:576
msgid "Signed in again. Syncing resumed."
msgstr "سجّلت الدخول مجددًا. استؤنفت المزامنة."

#: src/daemon.rs:630
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "خرجتَ من الحساب. سجّل الدخول من نافذة الحساب لاستئناف المزامنة."

#: src/daemon.rs:663
msgid "Sync resumed"
msgstr "استؤنفت المزامنة"

#: src/daemon.rs:680
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "لم تُنزَّل أي صورة"
msgstr[1] "نُزِّلت صورة واحدة"
msgstr[2] "نُزِّلت صورتان"
msgstr[3] "نُزِّلت {n} صور"
msgstr[4] "نُزِّلت {n} صورة"
msgstr[5] "نُزِّلت {n} صورة"

#: src/i18n.rs:111 ui/qml/main.qml:336
msgid "Sign out"
msgstr "تسجيل الخروج"

#: src/i18n.rs:112 src/i18n.rs:113
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "لا صور"
msgstr[1] "صورة واحدة"
msgstr[2] "صورتان"
msgstr[3] "{n} صور"
msgstr[4] "{n} صورة"
msgstr[5] "{n} صورة"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "زامن داخله مع الإبقاء على محتوياته"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "أزحه جانبًا وابدأ من مجلد فارغ"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] "يحتوي {folder} على {n} عنصر ستدمجه المزامنة مع Proton Drive."
msgstr[1] "يحتوي {folder} على عنصر واحد ستدمجه المزامنة مع Proton Drive."
msgstr[2] "يحتوي {folder} على عنصرين ستدمجهما المزامنة مع Proton Drive."
msgstr[3] "يحتوي {folder} على {n} عناصر ستدمجها المزامنة مع Proton Drive."
msgstr[4] "يحتوي {folder} على {n} عنصرًا ستدمجها المزامنة مع Proton Drive."
msgstr[5] "يحتوي {folder} على {n} عنصر ستدمجها المزامنة مع Proton Drive."

#: ui/src/bridge.rs:175
msgid "Starting…"
msgstr "يجري البدء…"

#: ui/src/bridge.rs:217
msgid "Confirm the code {code} in your browser"
msgstr "أكّد الرمز {code} في المتصفح"

#: ui/src/bridge.rs:231
msgid "Sign-in failed: {reason}"
msgstr "فشل تسجيل الدخول: {reason}"

#: ui/src/bridge.rs:243
msgid "Signed out"
msgstr "خرجتَ من الحساب"

#: ui/src/bridge.rs:246
msgid "Sign-out failed: {reason}"
msgstr "فشل تسجيل الخروج: {reason}"

#: ui/src/bridge.rs:305
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. أعد تشغيل خدمة المزامنة لاستخدامه."

#: ui/src/bridge.rs:308
msgid "Cannot change the folder: {reason}"
msgstr "تعذّر تغيير المجلد: {reason}"

#: ui/src/bridge.rs:315
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "لا يوجد مجلد مزامنة بعد. نفّذ: kpdrive setup"

#: ui/src/bridge.rs:319
msgid "Cannot create the ignore file: {reason}"
msgstr "تعذّر إنشاء ملف التجاهل: {reason}"

#: ui/src/bridge.rs:356
msgid "Checking the account…"
msgstr "يجري فحص الحساب…"

#: ui/src/bridge.rs:362
msgid "Opening the browser…"
msgstr "يجري فتح المتصفح…"

#: ui/src/bridge.rs:368
msgid "Signing out…"
msgstr "يجري تسجيل الخروج…"

#: ui/src/bridge.rs:394
msgid "Cannot read the log: {reason}"
msgstr "تعذّرت قراءة السجل: {reason}"

#: ui/src/bridge.rs:404 ui/src/bridge.rs:425 ui/src/bridge.rs:443
msgid "Cannot save the setting: {reason}"
msgstr "تعذّر حفظ الإعداد: {reason}"

#: ui/src/bridge.rs:412
msgid "Proton Photos will be downloaded with the next sync"
msgstr "ستُنزَّل صور Proton Photos مع المزامنة التالية"

#: ui/src/bridge.rs:413
msgid "Proton Photos will be left alone"
msgstr "ستُترك صور Proton Photos دون تغيير"

#: ui/src/bridge.rs:430
msgid "Storing everything from now on"
msgstr "سيُخزَّن كل شيء من الآن فصاعدًا"

#: ui/src/bridge.rs:431
msgid "Storing warnings and errors from now on"
msgstr "ستُخزَّن التحذيرات والأخطاء من الآن فصاعدًا"

#: ui/src/bridge.rs:432
msgid "Storing errors from now on"
msgstr "ستُخزَّن الأخطاء من الآن فصاعدًا"

#: ui/src/bridge.rs:448
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "لم يُزَل أي ملف سجل أقدم من {days} يومًا"
msgstr[1] "أُزيل ملف سجل واحد أقدم من {days} يومًا"
msgstr[2] "أُزيل ملفا سجل أقدم من {days} يومًا"
msgstr[3] "أُزيلت {n} ملفات سجل أقدم من {days} يومًا"
msgstr[4] "أُزيل {n} ملف سجل أقدم من {days} يومًا"
msgstr[5] "أُزيل {n} ملف سجل أقدم من {days} يومًا"

#: ui/src/bridge.rs:449
msgid "Cannot prune the log: {reason}"
msgstr "تعذّر تنظيف السجل: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "اختر مجلد Proton Drive"

#: ui/qml/main.qml:38
msgid "The folder is not empty"
msgstr "المجلد ليس فارغًا"

#: ui/qml/main.qml:73
msgid "Opened {what}"
msgstr "فُتح {what}"

#: ui/qml/main.qml:75
msgid "Could not open {what} ({url})"
msgstr "تعذّر فتح {what} ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:131
msgid "Account"
msgstr "الحساب"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:133
msgid "Logs"
msgstr "السجلات"

#: ui/qml/main.qml:164
msgid "Not signed in"
msgstr "لم تسجّل الدخول"

#: ui/qml/main.qml:171
msgid "Signed in to Proton Drive"
msgstr "مسجَّل الدخول إلى Proton Drive"

#: ui/qml/main.qml:172
msgid "Sign in to sync this computer with Proton Drive."
msgstr "سجّل الدخول لمزامنة هذا الحاسوب مع Proton Drive."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:193
msgid "Storage"
msgstr "التخزين"

#: ui/qml/main.qml:221
msgid "{used} of {total} used"
msgstr "مُستخدَم {used} من {total}"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:233
msgid "Syncing to"
msgstr "المزامنة إلى"

#: ui/qml/main.qml:237
msgid "nowhere yet"
msgstr "لا مكان بعد"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:244
msgid "Change…"
msgstr "غيّر…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:251
msgid "Ignore file…"
msgstr "ملف التجاهل…"

#: ui/qml/main.qml:263
msgid "Also download Proton Photos"
msgstr "نزّل Proton Photos أيضًا"

#: ui/qml/main.qml:271
msgid ""
"Read-only: your timeline is copied into {folder}. Photos are never uploaded, "
"changed or deleted in Proton Photos, and the copy is checked every half hour."
msgstr "للقراءة فقط: يُنسخ خطك الزمني إلى {folder}. لا تُرفع الصور ولا تُعدَّل ولا تُحذف في Proton Photos، وتُفحص النسخة كل نصف ساعة."

#: ui/qml/main.qml:272
msgid "your Pictures folder"
msgstr "مجلد الصور لديك"

#: ui/qml/main.qml:319
msgid "Drive on the web"
msgstr "Drive على الويب"

#: ui/qml/main.qml:324
msgid "Proton account"
msgstr "حساب Proton"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:330
msgid "Refresh"
msgstr "أنعش"

#: ui/qml/main.qml:336
msgid "Sign in"
msgstr "تسجيل الدخول"

#: ui/qml/main.qml:379
msgid "Read the licence"
msgstr "اقرأ الرخصة"

#: ui/qml/main.qml:397
msgid "Search the log"
msgstr "ابحث في السجل"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:443
msgid "Copy"
msgstr "انسخ"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:449
msgid "Select all"
msgstr "اختر الكل"

#: ui/qml/main.qml:466
msgid "No lines match"
msgstr "لا سطور مطابقة"

#: ui/qml/main.qml:466
msgid "Nothing logged yet"
msgstr "لم يُسجَّل شيء بعد"

#: ui/qml/main.qml:468
msgid "No line since the sync daemon started contains “{term}”."
msgstr "لا يحتوي أي سطر منذ بدء خدمة المزامنة على «{term}»."

#: ui/qml/main.qml:469
msgid "This shows what has happened since the sync daemon started."
msgstr "يعرض هذا ما حدث منذ بدء خدمة المزامنة."

#. TRANSLATORS: start of "Keep logs for [30] days"; the number and "days" follow
#: ui/qml/main.qml:478
msgid "Keep logs for"
msgstr "احفظ السجلات مدة"

#. TRANSLATORS: end of "Keep logs for [30] days"
#: ui/qml/main.qml:488
msgid "days"
msgstr "يومًا"

#. TRANSLATORS: verb, label before a dropdown choosing which log levels are written to disk
#: ui/qml/main.qml:493
msgid "Store"
msgstr "خزّن"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:501
msgid "Warnings and errors"
msgstr "التحذيرات والأخطاء"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:503
msgid "Everything"
msgstr "كل شيء"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:505
msgid "Errors only"
msgstr "الأخطاء فقط"

#: ui/qml/main.qml:514
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "لا سطور"
msgstr[1] "سطر واحد"
msgstr[2] "سطران"
msgstr[3] "{n} سطور"
msgstr[4] "{n} سطرًا"
msgstr[5] "{n} سطر"

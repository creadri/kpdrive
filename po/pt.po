#: src/daemon.rs:98
msgid "Signed out. Sign in from the account window."
msgstr "Sessão terminada. Inicie sessão a partir da janela da conta."

#: src/daemon.rs:100 src/daemon.rs:341
msgid "Syncing…"
msgstr "A sincronizar…"

#: src/daemon.rs:102 src/daemon.rs:344
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} item sincronizado"
msgstr[1] "{n} itens sincronizados"

#: src/daemon.rs:112 ui/qml/main.qml:313
msgid "Open folder"
msgstr "Abrir pasta"

#: src/daemon.rs:122
msgid "Account and logs…"
msgstr "Conta e registos…"

#: src/daemon.rs:129 ui/qml/main.qml:291
msgid "Sync now"
msgstr "Sincronizar agora"

#: src/daemon.rs:139
msgid "Quit"
msgstr "Sair"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:273
msgid "{reason}; retrying"
msgstr "{reason}; a tentar novamente"

#: src/daemon.rs:284
msgid "Proton Drive is reachable again, after {duration}"
msgstr "O Proton Drive está novamente acessível, após {duration}"

#: src/daemon.rs:295
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} segundo"
msgstr[1] "{n} segundos"

#: src/daemon.rs:296
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuto"
msgstr[1] "{n} minutos"

#: src/daemon.rs:297
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} hora"
msgstr[1] "{n} horas"

#: src/daemon.rs:325
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "O serviço de sincronização não está em execução. Inicie-o com: kpdrive sync --watch"

#: src/daemon.rs:328
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr "Está em execução um serviço de sincronização demasiado antigo para indicar o que está a fazer. Reinicie-o."

#: src/daemon.rs:331
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Sessão terminada. A sincronização é retomada assim que iniciar sessão."

#: src/daemon.rs:335
msgid "{reason}. Still trying."
msgstr "{reason}. A continuar a tentar."

#: src/daemon.rs:336
msgid "Last sync failed: {reason}"
msgstr "A última sincronização falhou: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:350
msgid "just now"
msgstr "agora mesmo"

#: src/daemon.rs:352
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "há {n} minuto"
msgstr[1] "há {n} minutos"

#: src/daemon.rs:355
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "há {n} hora"
msgstr[1] "há {n} horas"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:359
msgid "{items}, checked {ago}"
msgstr "{items}, última verificação {ago}"

#: src/daemon.rs:576
msgid "Signed in again. Syncing resumed."
msgstr "Sessão iniciada novamente. Sincronização retomada."

#: src/daemon.rs:630
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "Sessão terminada. Inicie sessão a partir da janela da conta para retomar a sincronização."

#: src/daemon.rs:663
msgid "Sync resumed"
msgstr "Sincronização retomada"

#: src/daemon.rs:680
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} fotografia transferida"
msgstr[1] "{n} fotografias transferidas"

#: src/i18n.rs:111 ui/qml/main.qml:336
msgid "Sign out"
msgstr "Terminar sessão"

#: src/i18n.rs:112 src/i18n.rs:113
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} fotografia"
msgstr[1] "{n} fotografias"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Sincronizar para esta pasta e manter o que já lá está"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Mover a pasta para o lado e começar com uma pasta vazia"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] "{folder} já contém {n} item, que a sincronização irá juntar ao Proton Drive."
msgstr[1] "{folder} já contém {n} itens, que a sincronização irá juntar ao Proton Drive."

#: ui/src/bridge.rs:175
msgid "Starting…"
msgstr "A iniciar…"

#: ui/src/bridge.rs:217
msgid "Confirm the code {code} in your browser"
msgstr "Confirme o código {code} no navegador"

#: ui/src/bridge.rs:231
msgid "Sign-in failed: {reason}"
msgstr "Falha ao iniciar sessão: {reason}"

#: ui/src/bridge.rs:243
msgid "Signed out"
msgstr "Sessão terminada"

#: ui/src/bridge.rs:246
msgid "Sign-out failed: {reason}"
msgstr "Falha ao terminar sessão: {reason}"

#: ui/src/bridge.rs:305
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Reinicie o serviço de sincronização para aplicar a alteração."

#: ui/src/bridge.rs:308
msgid "Cannot change the folder: {reason}"
msgstr "Não é possível alterar a pasta: {reason}"

#: ui/src/bridge.rs:315
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Ainda não existe uma pasta de sincronização. Execute: kpdrive setup"

#: ui/src/bridge.rs:319
msgid "Cannot create the ignore file: {reason}"
msgstr "Não é possível criar o ficheiro de exclusões: {reason}"

#: ui/src/bridge.rs:356
msgid "Checking the account…"
msgstr "A verificar a conta…"

#: ui/src/bridge.rs:362
msgid "Opening the browser…"
msgstr "A abrir o navegador…"

#: ui/src/bridge.rs:368
msgid "Signing out…"
msgstr "A terminar sessão…"

#: ui/src/bridge.rs:394
msgid "Cannot read the log: {reason}"
msgstr "Não é possível ler o registo: {reason}"

#: ui/src/bridge.rs:404 ui/src/bridge.rs:425 ui/src/bridge.rs:443
msgid "Cannot save the setting: {reason}"
msgstr "Não é possível guardar a definição: {reason}"

#: ui/src/bridge.rs:412
msgid "Proton Photos will be downloaded with the next sync"
msgstr "O Proton Photos será transferido na próxima sincronização"

#: ui/src/bridge.rs:413
msgid "Proton Photos will be left alone"
msgstr "O Proton Photos não será transferido"

#: ui/src/bridge.rs:430
msgid "Storing everything from now on"
msgstr "A partir de agora será registado tudo"

#: ui/src/bridge.rs:431
msgid "Storing warnings and errors from now on"
msgstr "A partir de agora serão registados avisos e erros"

#: ui/src/bridge.rs:432
msgid "Storing errors from now on"
msgstr "A partir de agora serão registados apenas erros"

#: ui/src/bridge.rs:448
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "removido {n} ficheiro de registo com mais de {days} dias"
msgstr[1] "removidos {n} ficheiros de registo com mais de {days} dias"

#: ui/src/bridge.rs:449
msgid "Cannot prune the log: {reason}"
msgstr "Não é possível limpar o registo: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "Escolha a pasta do Proton Drive"

#: ui/qml/main.qml:38
msgid "The folder is not empty"
msgstr "A pasta não está vazia"

#: ui/qml/main.qml:73
msgid "Opened {what}"
msgstr "{what} aberto"

#: ui/qml/main.qml:75
msgid "Could not open {what} ({url})"
msgstr "Não foi possível abrir {what} ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:131
msgid "Account"
msgstr "Conta"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:133
msgid "Logs"
msgstr "Registos"

#: ui/qml/main.qml:164
msgid "Not signed in"
msgstr "Sessão não iniciada"

#: ui/qml/main.qml:171
msgid "Signed in to Proton Drive"
msgstr "Sessão iniciada no Proton Drive"

#: ui/qml/main.qml:172
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Inicie sessão para sincronizar este computador com o Proton Drive."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:193
msgid "Storage"
msgstr "Armazenamento"

#: ui/qml/main.qml:221
msgid "{used} of {total} used"
msgstr "{used} de {total} utilizados"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:233
msgid "Syncing to"
msgstr "A sincronizar para"

#: ui/qml/main.qml:237
msgid "nowhere yet"
msgstr "ainda em lado nenhum"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:244
msgid "Change…"
msgstr "Alterar…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:251
msgid "Ignore file…"
msgstr "Ficheiro de exclusões…"

#: ui/qml/main.qml:263
msgid "Also download Proton Photos"
msgstr "Transferir também o Proton Photos"

#: ui/qml/main.qml:271
msgid ""
"Read-only: your timeline is copied into {folder}. Photos are never uploaded, "
"changed or deleted in Proton Photos, and the copy is checked every half hour."
msgstr "Apenas leitura: a sua cronologia é copiada para {folder}. As fotografias nunca são enviadas, alteradas ou eliminadas no Proton Photos, e a cópia é verificada a cada meia hora."

#: ui/qml/main.qml:272
msgid "your Pictures folder"
msgstr "a sua pasta Imagens"

#: ui/qml/main.qml:319
msgid "Drive on the web"
msgstr "Drive na Web"

#: ui/qml/main.qml:324
msgid "Proton account"
msgstr "Conta Proton"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:330
msgid "Refresh"
msgstr "Atualizar"

#: ui/qml/main.qml:336
msgid "Sign in"
msgstr "Iniciar sessão"

#: ui/qml/main.qml:379
msgid "Read the licence"
msgstr "Ler a licença"

#: ui/qml/main.qml:397
msgid "Search the log"
msgstr "Procurar no registo"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:443
msgid "Copy"
msgstr "Copiar"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:449
msgid "Select all"
msgstr "Selecionar tudo"

#: ui/qml/main.qml:466
msgid "No lines match"
msgstr "Nenhuma linha corresponde"

#: ui/qml/main.qml:466
msgid "Nothing logged yet"
msgstr "Ainda nada registado"

#: ui/qml/main.qml:468
msgid "No line since the sync daemon started contains “{term}”."
msgstr "Nenhuma linha desde o arranque do serviço de sincronização contém «{term}»."

#: ui/qml/main.qml:469
msgid "This shows what has happened since the sync daemon started."
msgstr "Mostra o que aconteceu desde o arranque do serviço de sincronização."

#. TRANSLATORS: start of "Keep logs for [30] days"; the number and "days" follow
#: ui/qml/main.qml:478
msgid "Keep logs for"
msgstr "Manter os registos durante"

#. TRANSLATORS: end of "Keep logs for [30] days"
#: ui/qml/main.qml:488
msgid "days"
msgstr "dias"

#. TRANSLATORS: verb, label before a dropdown choosing which log levels are written to disk
#: ui/qml/main.qml:493
msgid "Store"
msgstr "Registar"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:501
msgid "Warnings and errors"
msgstr "Avisos e erros"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:503
msgid "Everything"
msgstr "Tudo"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:505
msgid "Errors only"
msgstr "Apenas erros"

#: ui/qml/main.qml:514
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} linha"
msgstr[1] "{n} linhas"

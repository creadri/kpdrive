msgstr "{used} de {total} utilizados"

#: ui/qml/main.qml:384 ui/qml/main.qml:489
msgid "Account:"
msgstr "Conta:"

#: ui/qml/main.qml:387
msgid "Sign in"
msgstr "Iniciar sessão"


#: ui/qml/main.qml:394
msgid "Refresh"
msgstr "Atualizar"

#: ui/qml/main.qml:401
msgid "Remove account…"
msgstr "Remover conta…"

#: ui/qml/main.qml:410
msgid "On the web:"
msgstr "Na Web:"

#: ui/qml/main.qml:413
msgid "Drive on the web"
msgstr "Drive na Web"

#: ui/qml/main.qml:418
msgid "Proton account"
msgstr "Conta Proton"

#: ui/qml/main.qml:426
msgid "Activity"
msgstr "Atividade"

#: ui/qml/main.qml:433
msgid "Sync:"
msgstr "Sincronização:"

#: ui/qml/main.qml:464
msgid "Resume"
msgstr "Retomar"

#: ui/qml/main.qml:464
msgid "Pause"
msgstr "Pausar"

#: ui/qml/main.qml:497
msgid "Files"
msgstr "Ficheiros"

#: ui/qml/main.qml:501
msgid "Sync folder:"
msgstr "Pasta de sincronização:"

#: ui/qml/main.qml:505
msgid "nowhere yet"
msgstr "ainda em lado nenhum"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:511 ui/qml/main.qml:558 ui/qml/main.qml:601
msgid "Change…"
msgstr "Alterar…"

#: ui/qml/main.qml:518
msgid "Ignored paths:"
msgstr "Caminhos excluídos:"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves
#. alone
#: ui/qml/main.qml:520
msgid "Ignore file…"
msgstr "Ficheiro de exclusões…"

#: ui/qml/main.qml:527
msgid "Photos"
msgstr "Fotografias"

#: ui/qml/main.qml:531
msgid "Download:"
msgstr "Transferência:"

#: ui/qml/main.qml:535
msgid "Also download Proton Photos"
msgstr "Transferir também o Proton Photos"

#: ui/qml/main.qml:541
msgid ""
"Your timeline is copied here every half hour. Nothing in Proton Photos is "
"changed or deleted by it."
msgstr ""
"A sua cronologia é copiada para aqui a cada meia hora. Nada no Proton Photos "
"é alterado ou eliminado por isso."

#: ui/qml/main.qml:549
msgid "Download folder:"
msgstr "Pasta de transferência:"

#: ui/qml/main.qml:553
msgid "your Pictures folder"
msgstr "a sua pasta Imagens"

#: ui/qml/main.qml:565
msgid "Upload:"
msgstr "Envio:"

#: ui/qml/main.qml:569
msgid "Upload photos from a folder"
msgstr "Enviar fotografias a partir de uma pasta"

#: ui/qml/main.qml:583
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""
"As fotografias e os vídeos colocados nesta pasta são enviados para o Proton "
"Photos no espaço de um minuto e depois saem da pasta. O que não puder ser "
"enviado fica na pasta."

#: ui/qml/main.qml:591
msgid "Upload folder:"
msgstr "Pasta de envio:"

#: ui/qml/main.qml:608
msgid "After upload:"
msgstr "Após o envio:"

#: ui/qml/main.qml:610
msgid "Delete instead of moving to the trash"
msgstr "Eliminar em vez de mover para o lixo"

#: ui/qml/main.qml:617
msgid "Network"
msgstr "Rede"

#: ui/qml/main.qml:621 ui/qml/main.qml:666
msgid "Pause while on:"
msgstr "Pausar em:"

#: ui/qml/main.qml:641
msgid "{network} (connected)"
msgstr "{network} (ligado)"

#: ui/qml/main.qml:652
msgid ""
"Syncing pauses while any ticked network is connected, such as a phone's "
"hotspot. A sync already under way finishes first."
msgstr ""
"A sincronização fica em pausa enquanto estiver ligado a qualquer rede "
"assinalada, como o hotspot de um telemóvel. Uma sincronização já em curso "
"termina primeiro."

#: ui/qml/main.qml:653
msgid "NetworkManager lists no networks to choose from."
msgstr "O NetworkManager não apresenta redes para escolher."

#: ui/qml/main.qml:662
msgid "Power"
msgstr "Energia"

#: ui/qml/main.qml:672
msgid "AC power"
msgstr "Corrente elétrica"

#: ui/qml/main.qml:673
msgid "Battery"
msgstr "Bateria"

#: ui/qml/main.qml:674
msgid "Low battery"
msgstr "Bateria fraca"

#: ui/qml/main.qml:682
msgid "{power} (now)"
msgstr "{power} (atual)"

#: ui/qml/main.qml:692
msgid ""
"Low battery is the level set in the system's power management settings. A "
"sync already under way finishes first."
msgstr ""
"A bateria fraca corresponde ao nível definido nas definições de gestão de "
"energia do sistema. Uma sincronização já em curso termina primeiro."

#: ui/qml/main.qml:705
msgid "Keep logs for:"
msgstr "Manter registos durante:"

#. TRANSLATORS: after the number in "Keep logs for: [30] days"
#: ui/qml/main.qml:714
msgid "days"
msgstr "dias"

#. TRANSLATORS: label before a dropdown choosing which log levels are written
#. to disk
#: ui/qml/main.qml:719
msgid "Store:"
msgstr "Registar:"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:724
msgid "Warnings and errors"
msgstr "Avisos e erros"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:726
msgid "Everything"
msgstr "Tudo"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:728
msgid "Errors only"
msgstr "Apenas erros"

#: ui/qml/main.qml:749
msgid "Search the log"
msgstr "Procurar no registo"

#: ui/qml/main.qml:754
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} linha"
msgstr[1] "{n} linhas"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:804
msgid "Copy"
msgstr "Copiar"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:810
msgid "Select all"
msgstr "Selecionar tudo"

#: ui/qml/main.qml:827
msgid "No lines match"
msgstr "Nenhuma linha corresponde"

#: ui/qml/main.qml:827
msgid "Nothing logged yet"
msgstr "Ainda nada registado"

#: ui/qml/main.qml:829
msgid "No line since the sync daemon started contains “{term}”."
msgstr ""
"Nenhuma linha desde o arranque do serviço de sincronização contém «{term}»."

#: ui/qml/main.qml:830
msgid "This shows what has happened since the sync daemon started."
msgstr "Mostra o que aconteceu desde o arranque do serviço de sincronização."

#: ui/qml/main.qml:862
msgid "Proton Drive sync client for KDE Plasma"
msgstr "Cliente de sincronização do Proton Drive para o KDE Plasma"


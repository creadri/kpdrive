#: src/daemon.rs:112
msgid "Signed out. Sign in from the account window."
msgstr "Sessão terminada. Inicie sessão a partir da janela da conta."

#: src/daemon.rs:114 src/daemon.rs:401
msgid "Syncing…"
msgstr "A sincronizar…"

#: src/daemon.rs:116 src/daemon.rs:404
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} item sincronizado"
msgstr[1] "{n} itens sincronizados"

#: src/daemon.rs:126 ui/qml/main.qml:409
msgid "Open folder"
msgstr "Abrir pasta"

#: src/daemon.rs:136
msgid "Account and logs…"
msgstr "Conta e registos…"

#: src/daemon.rs:143 ui/qml/main.qml:396
msgid "Sync now"
msgstr "Sincronizar agora"

#: src/daemon.rs:155
msgid "Pause sync"
msgstr "Pausar sincronização"

#: src/daemon.rs:168
msgid "Quit"
msgstr "Sair"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:328
msgid "{reason}; retrying"
msgstr "{reason}; a tentar novamente"

#: src/daemon.rs:339
msgid "Proton Drive is reachable again, after {duration}"
msgstr "O Proton Drive está novamente acessível, após {duration}"

#: src/daemon.rs:350
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} segundo"
msgstr[1] "{n} segundos"

#: src/daemon.rs:351
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuto"
msgstr[1] "{n} minutos"

#: src/daemon.rs:352
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} hora"
msgstr[1] "{n} horas"

#: src/daemon.rs:382
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"O serviço de sincronização não está em execução. Inicie-o com: kpdrive sync "
"--watch"

#: src/daemon.rs:385
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Está em execução um serviço de sincronização demasiado antigo para indicar o "
"que está a fazer. Reinicie-o."

#: src/daemon.rs:391
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Sessão terminada. A sincronização é retomada assim que iniciar sessão."

#: src/daemon.rs:395
msgid "{reason}. Still trying."
msgstr "{reason}. A continuar a tentar."

#: src/daemon.rs:396
msgid "Last sync failed: {reason}"
msgstr "A última sincronização falhou: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:410
msgid "just now"
msgstr "agora mesmo"

#: src/daemon.rs:412
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "há {n} minuto"
msgstr[1] "há {n} minutos"

#: src/daemon.rs:415
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "há {n} hora"
msgstr[1] "há {n} horas"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:419
msgid "{items}, checked {ago}"
msgstr "{items}, última verificação {ago}"

#: src/daemon.rs:637
msgid "Signed in again. Syncing resumed."
msgstr "Sessão iniciada novamente. Sincronização retomada."

#: src/daemon.rs:712
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Sessão terminada. Inicie sessão a partir da janela da conta para retomar a "
"sincronização."

#: src/daemon.rs:745
msgid "Sync resumed"
msgstr "Sincronização retomada"

#: src/daemon.rs:762
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} fotografia transferida"
msgstr[1] "{n} fotografias transferidas"

#: src/daemon.rs:783
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} fotografia enviada para o Proton Photos"
msgstr[1] "{n} fotografias enviadas para o Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:334
msgid "Sign out"
msgstr "Terminar sessão"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} fotografia"
msgstr[1] "{n} fotografias"

#: src/pause.rs:20
msgid "Paused"
msgstr "Em pausa"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "Em pausa enquanto ligado à corrente elétrica"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "Em pausa enquanto a funcionar com bateria"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "Em pausa enquanto a bateria está fraca"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "Em pausa enquanto ligado a {network}"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Sincronizar para esta pasta e manter o que já lá está"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Mover a pasta para o lado e começar com uma pasta vazia"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"{folder} já contém {n} item, que a sincronização irá juntar ao Proton Drive."
msgstr[1] ""
"{folder} já contém {n} itens, que a sincronização irá juntar ao Proton Drive."

#: ui/src/bridge.rs:237
msgid "Starting…"
msgstr "A iniciar…"

#: ui/src/bridge.rs:288
msgid "Confirm the code {code} in your browser"
msgstr "Confirme o código {code} no navegador"

#: ui/src/bridge.rs:302
msgid "Sign-in failed: {reason}"
msgstr "Falha ao iniciar sessão: {reason}"

#: ui/src/bridge.rs:314
msgid "Signed out"
msgstr "Sessão terminada"

#: ui/src/bridge.rs:317
msgid "Sign-out failed: {reason}"
msgstr "Falha ao terminar sessão: {reason}"

#: ui/src/bridge.rs:382
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Reinicie o serviço de sincronização para aplicar a alteração."

#: ui/src/bridge.rs:385
msgid "Cannot change the folder: {reason}"
msgstr "Não é possível alterar a pasta: {reason}"

#: ui/src/bridge.rs:392
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Ainda não existe uma pasta de sincronização. Execute: kpdrive setup"

#: ui/src/bridge.rs:396
msgid "Cannot create the ignore file: {reason}"
msgstr "Não é possível criar o ficheiro de exclusões: {reason}"

#: ui/src/bridge.rs:434
msgid "Checking the account…"
msgstr "A verificar a conta…"

#: ui/src/bridge.rs:440
msgid "Opening the browser…"
msgstr "A abrir o navegador…"

#: ui/src/bridge.rs:446
msgid "Signing out…"
msgstr "A terminar sessão…"

#: ui/src/bridge.rs:472
msgid "Cannot read the log: {reason}"
msgstr "Não é possível ler o registo: {reason}"

#: ui/src/bridge.rs:482 ui/src/bridge.rs:510 ui/src/bridge.rs:524
#: ui/src/bridge.rs:539 ui/src/bridge.rs:573 ui/src/bridge.rs:614
#: ui/src/bridge.rs:627 ui/src/bridge.rs:645
msgid "Cannot save the setting: {reason}"
msgstr "Não é possível guardar a definição: {reason}"

#: ui/src/bridge.rs:490
msgid "Proton Photos will be downloaded with the next sync"
msgstr "O Proton Photos será transferido na próxima sincronização"

#: ui/src/bridge.rs:491
msgid "Proton Photos will be left alone"
msgstr "O Proton Photos não será transferido"

#: ui/src/bridge.rs:516
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr ""
"As fotografias colocadas nessa pasta serão enviadas para o Proton Photos"

#: ui/src/bridge.rs:517
msgid "No longer uploading photos"
msgstr "As fotografias já não são enviadas"

#: ui/src/bridge.rs:607
msgid "Photos will be downloaded into that folder from the next pass"
msgstr ""
"A partir da próxima passagem, as fotografias serão transferidas para essa "
"pasta"

#: ui/src/bridge.rs:632
msgid "Storing everything from now on"
msgstr "A partir de agora será registado tudo"

#: ui/src/bridge.rs:633
msgid "Storing warnings and errors from now on"
msgstr "A partir de agora serão registados avisos e erros"

#: ui/src/bridge.rs:634
msgid "Storing errors from now on"
msgstr "A partir de agora serão registados apenas erros"

#: ui/src/bridge.rs:650
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "removido {n} ficheiro de registo com mais de {days} dias"
msgstr[1] "removidos {n} ficheiros de registo com mais de {days} dias"

#: ui/src/bridge.rs:651
msgid "Cannot prune the log: {reason}"
msgstr "Não é possível limpar o registo: {reason}"

#: ui/qml/main.qml:28
msgid "Choose the Proton Drive folder"
msgstr "Escolha a pasta do Proton Drive"

#: ui/qml/main.qml:35
msgid "Choose where Proton Photos are downloaded"
msgstr "Escolha onde transferir o Proton Photos"

#: ui/qml/main.qml:42
msgid "Choose the folder to upload photos from"
msgstr "Escolha a pasta a partir da qual enviar fotografias"

#: ui/qml/main.qml:53
msgid "The folder is not empty"
msgstr "A pasta não está vazia"

#: ui/qml/main.qml:104
msgid "Opened {what}"
msgstr "{what} aberto"

#: ui/qml/main.qml:106
msgid "Could not open {what} ({url})"
msgstr "Não foi possível abrir {what} ({url})"

#: ui/qml/main.qml:186
msgid "Account & activity"
msgstr "Conta e atividade"

#: ui/qml/main.qml:187
msgid "Settings"
msgstr "Definições"

#: ui/qml/main.qml:188 ui/qml/main.qml:633
msgid "Logs"
msgstr "Registos"

#: ui/qml/main.qml:189
msgid "About"
msgstr "Acerca"

#: ui/qml/main.qml:269
msgid "Not signed in"
msgstr "Sessão não iniciada"

#: ui/qml/main.qml:276
msgid "Signed in to Proton Drive"
msgstr "Sessão iniciada no Proton Drive"

#: ui/qml/main.qml:277
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Inicie sessão para sincronizar este computador com o Proton Drive."

#: ui/qml/main.qml:294
msgid "Storage:"
msgstr "Armazenamento:"

#: ui/qml/main.qml:323
msgid "{used} of {total} used"
msgstr "{used} de {total} utilizados"

#: ui/qml/main.qml:331
msgid "Account:"
msgstr "Conta:"

#: ui/qml/main.qml:334
msgid "Sign in"
msgstr "Iniciar sessão"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:341
msgid "Refresh"
msgstr "Atualizar"

#: ui/qml/main.qml:350
msgid "On the web:"
msgstr "Na Web:"

#: ui/qml/main.qml:353
msgid "Drive on the web"
msgstr "Drive na Web"

#: ui/qml/main.qml:358
msgid "Proton account"
msgstr "Conta Proton"

#: ui/qml/main.qml:366
msgid "Activity"
msgstr "Atividade"

#: ui/qml/main.qml:373
msgid "Sync:"
msgstr "Sincronização:"

#: ui/qml/main.qml:404
msgid "Resume"
msgstr "Retomar"

#: ui/qml/main.qml:404
msgid "Pause"
msgstr "Pausar"

#: ui/qml/main.qml:429
msgid "Files"
msgstr "Ficheiros"

#: ui/qml/main.qml:433
msgid "Sync folder:"
msgstr "Pasta de sincronização:"

#: ui/qml/main.qml:437
msgid "nowhere yet"
msgstr "ainda em lado nenhum"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:443 ui/qml/main.qml:490 ui/qml/main.qml:533
msgid "Change…"
msgstr "Alterar…"

#: ui/qml/main.qml:450
msgid "Ignored paths:"
msgstr "Caminhos excluídos:"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves
#. alone
#: ui/qml/main.qml:452
msgid "Ignore file…"
msgstr "Ficheiro de exclusões…"

#: ui/qml/main.qml:459
msgid "Photos"
msgstr "Fotografias"

#: ui/qml/main.qml:463
msgid "Download:"
msgstr "Transferência:"

#: ui/qml/main.qml:467
msgid "Also download Proton Photos"
msgstr "Transferir também o Proton Photos"

#: ui/qml/main.qml:473
msgid ""
"Your timeline is copied here every half hour. Nothing in Proton Photos is "
"changed or deleted by it."
msgstr ""
"A sua cronologia é copiada para aqui a cada meia hora. Nada no Proton Photos "
"é alterado ou eliminado por isso."

#: ui/qml/main.qml:481
msgid "Download folder:"
msgstr "Pasta de transferência:"

#: ui/qml/main.qml:485
msgid "your Pictures folder"
msgstr "a sua pasta Imagens"

#: ui/qml/main.qml:497
msgid "Upload:"
msgstr "Envio:"

#: ui/qml/main.qml:501
msgid "Upload photos from a folder"
msgstr "Enviar fotografias a partir de uma pasta"

#: ui/qml/main.qml:515
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""
"As fotografias e os vídeos colocados nesta pasta são enviados para o Proton "
"Photos no espaço de um minuto e depois saem da pasta. O que não puder ser "
"enviado fica na pasta."

#: ui/qml/main.qml:523
msgid "Upload folder:"
msgstr "Pasta de envio:"

#: ui/qml/main.qml:540
msgid "After upload:"
msgstr "Após o envio:"

#: ui/qml/main.qml:542
msgid "Delete instead of moving to the trash"
msgstr "Eliminar em vez de mover para o lixo"

#: ui/qml/main.qml:549
msgid "Network"
msgstr "Rede"

#: ui/qml/main.qml:553 ui/qml/main.qml:598
msgid "Pause while on:"
msgstr "Pausar em:"

#: ui/qml/main.qml:573
msgid "{network} (connected)"
msgstr "{network} (ligado)"

#: ui/qml/main.qml:584
msgid ""
"Syncing pauses while any ticked network is connected, such as a phone's "
"hotspot. A sync already under way finishes first."
msgstr ""
"A sincronização fica em pausa enquanto estiver ligado a qualquer rede "
"assinalada, como o hotspot de um telemóvel. Uma sincronização já em curso "
"termina primeiro."

#: ui/qml/main.qml:585
msgid "NetworkManager lists no networks to choose from."
msgstr "O NetworkManager não apresenta redes para escolher."

#: ui/qml/main.qml:594
msgid "Power"
msgstr "Energia"

#: ui/qml/main.qml:604
msgid "AC power"
msgstr "Corrente elétrica"

#: ui/qml/main.qml:605
msgid "Battery"
msgstr "Bateria"

#: ui/qml/main.qml:606
msgid "Low battery"
msgstr "Bateria fraca"

#: ui/qml/main.qml:614
msgid "{power} (now)"
msgstr "{power} (atual)"

#: ui/qml/main.qml:624
msgid ""
"Low battery is the level set in the system's power management settings. A "
"sync already under way finishes first."
msgstr ""
"A bateria fraca corresponde ao nível definido nas definições de gestão de "
"energia do sistema. Uma sincronização já em curso termina primeiro."

#: ui/qml/main.qml:637
msgid "Keep logs for:"
msgstr "Manter registos durante:"

#. TRANSLATORS: after the number in "Keep logs for: [30] days"
#: ui/qml/main.qml:646
msgid "days"
msgstr "dias"

#. TRANSLATORS: label before a dropdown choosing which log levels are written
#. to disk
#: ui/qml/main.qml:651
msgid "Store:"
msgstr "Registar:"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:656
msgid "Warnings and errors"
msgstr "Avisos e erros"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:658
msgid "Everything"
msgstr "Tudo"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:660
msgid "Errors only"
msgstr "Apenas erros"

#: ui/qml/main.qml:681
msgid "Search the log"
msgstr "Procurar no registo"

#: ui/qml/main.qml:686
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} linha"
msgstr[1] "{n} linhas"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:736
msgid "Copy"
msgstr "Copiar"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:742
msgid "Select all"
msgstr "Selecionar tudo"

#: ui/qml/main.qml:759
msgid "No lines match"
msgstr "Nenhuma linha corresponde"

#: ui/qml/main.qml:759
msgid "Nothing logged yet"
msgstr "Ainda nada registado"

#: ui/qml/main.qml:761
msgid "No line since the sync daemon started contains “{term}”."
msgstr ""
"Nenhuma linha desde o arranque do serviço de sincronização contém «{term}»."

#: ui/qml/main.qml:762
msgid "This shows what has happened since the sync daemon started."
msgstr "Mostra o que aconteceu desde o arranque do serviço de sincronização."

#: ui/qml/main.qml:794
msgid "Proton Drive sync client for KDE Plasma"
msgstr "Cliente de sincronização do Proton Drive para o KDE Plasma"

#: ui/qml/main.qml:802
msgid "Version:"
msgstr "Versão:"

#: ui/qml/main.qml:807
msgid "Licence:"
msgstr "Licença:"

#: ui/qml/main.qml:811
msgid "Read the licence"
msgstr "Ler a licença"

#: ui/qml/main.qml:818
msgid "Project:"
msgstr "Projeto:"

#: ui/qml/main.qml:821
msgid "Source code"
msgstr "Código-fonte"


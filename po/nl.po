#: src/daemon.rs:98
msgid "Signed out. Sign in from the account window."
msgstr "Afgemeld. Meld u aan via het accountvenster."

#: src/daemon.rs:100 src/daemon.rs:341
msgid "Syncing…"
msgstr "Bezig met synchroniseren…"

#: src/daemon.rs:102 src/daemon.rs:344
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} item gesynchroniseerd"
msgstr[1] "{n} items gesynchroniseerd"

#: src/daemon.rs:112 ui/qml/main.qml:313
msgid "Open folder"
msgstr "Map openen"

#: src/daemon.rs:122
msgid "Account and logs…"
msgstr "Account en logboek…"

#: src/daemon.rs:129 ui/qml/main.qml:291
msgid "Sync now"
msgstr "Nu synchroniseren"

#: src/daemon.rs:139
msgid "Quit"
msgstr "Afsluiten"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:273
msgid "{reason}; retrying"
msgstr "{reason}; nieuwe poging"

#: src/daemon.rs:284
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive is weer bereikbaar, na {duration}"

#: src/daemon.rs:295
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} seconde"
msgstr[1] "{n} seconden"

#: src/daemon.rs:296
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuut"
msgstr[1] "{n} minuten"

#: src/daemon.rs:297
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} uur"
msgstr[1] "{n} uur"

#: src/daemon.rs:325
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "De synchronisatiedienst is niet actief. Start deze met: kpdrive sync --watch"

#: src/daemon.rs:328
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr "Er is een synchronisatiedienst actief, maar die is te oud om te melden waarmee hij bezig is. Start deze opnieuw."

#: src/daemon.rs:331
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Afgemeld. Het synchroniseren gaat verder zodra u zich aanmeldt."

#: src/daemon.rs:335
msgid "{reason}. Still trying."
msgstr "{reason}. Er wordt nog geprobeerd."

#: src/daemon.rs:336
msgid "Last sync failed: {reason}"
msgstr "Laatste synchronisatie mislukt: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:350
msgid "just now"
msgstr "zojuist"

#: src/daemon.rs:352
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} minuut geleden"
msgstr[1] "{n} minuten geleden"

#: src/daemon.rs:355
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} uur geleden"
msgstr[1] "{n} uur geleden"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:359
msgid "{items}, checked {ago}"
msgstr "{items}, laatst gecontroleerd {ago}"

#: src/daemon.rs:576
msgid "Signed in again. Syncing resumed."
msgstr "Opnieuw aangemeld. Synchroniseren hervat."

#: src/daemon.rs:630
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "Afgemeld. Meld u aan via het accountvenster om het synchroniseren te hervatten."

#: src/daemon.rs:663
msgid "Sync resumed"
msgstr "Synchroniseren hervat"

#: src/daemon.rs:680
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} foto gedownload"
msgstr[1] "{n} foto's gedownload"

#: src/i18n.rs:111 ui/qml/main.qml:336
msgid "Sign out"
msgstr "Afmelden"

#: src/i18n.rs:112 src/i18n.rs:113
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} foto"
msgstr[1] "{n} foto's"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Hierin synchroniseren en behouden wat er al staat"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Deze map opzijzetten en met een lege map beginnen"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] "{folder} bevat al {n} item, dat bij het synchroniseren met Proton Drive wordt samengevoegd."
msgstr[1] "{folder} bevat al {n} items, die bij het synchroniseren met Proton Drive worden samengevoegd."

#: ui/src/bridge.rs:175
msgid "Starting…"
msgstr "Bezig met starten…"

#: ui/src/bridge.rs:217
msgid "Confirm the code {code} in your browser"
msgstr "Bevestig de code {code} in uw browser"

#: ui/src/bridge.rs:231
msgid "Sign-in failed: {reason}"
msgstr "Aanmelden mislukt: {reason}"

#: ui/src/bridge.rs:243
msgid "Signed out"
msgstr "Afgemeld"

#: ui/src/bridge.rs:246
msgid "Sign-out failed: {reason}"
msgstr "Afmelden mislukt: {reason}"

#: ui/src/bridge.rs:305
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Start de synchronisatiedienst opnieuw om de wijziging toe te passen."

#: ui/src/bridge.rs:308
msgid "Cannot change the folder: {reason}"
msgstr "Kan de map niet wijzigen: {reason}"

#: ui/src/bridge.rs:315
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Nog geen synchronisatiemap. Voer uit: kpdrive setup"

#: ui/src/bridge.rs:319
msgid "Cannot create the ignore file: {reason}"
msgstr "Kan het negeerbestand niet aanmaken: {reason}"

#: ui/src/bridge.rs:356
msgid "Checking the account…"
msgstr "Bezig met controleren van het account…"

#: ui/src/bridge.rs:362
msgid "Opening the browser…"
msgstr "Bezig met openen van de browser…"

#: ui/src/bridge.rs:368
msgid "Signing out…"
msgstr "Bezig met afmelden…"

#: ui/src/bridge.rs:394
msgid "Cannot read the log: {reason}"
msgstr "Kan het logboek niet lezen: {reason}"

#: ui/src/bridge.rs:404 ui/src/bridge.rs:425 ui/src/bridge.rs:443
msgid "Cannot save the setting: {reason}"
msgstr "Kan de instelling niet opslaan: {reason}"

#: ui/src/bridge.rs:412
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos wordt bij de volgende synchronisatie gedownload"

#: ui/src/bridge.rs:413
msgid "Proton Photos will be left alone"
msgstr "Proton Photos wordt niet gedownload"

#: ui/src/bridge.rs:430
msgid "Storing everything from now on"
msgstr "Vanaf nu wordt alles vastgelegd"

#: ui/src/bridge.rs:431
msgid "Storing warnings and errors from now on"
msgstr "Vanaf nu worden waarschuwingen en fouten vastgelegd"

#: ui/src/bridge.rs:432
msgid "Storing errors from now on"
msgstr "Vanaf nu worden alleen fouten vastgelegd"

#: ui/src/bridge.rs:448
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "{n} logbestand ouder dan {days} dagen verwijderd"
msgstr[1] "{n} logbestanden ouder dan {days} dagen verwijderd"

#: ui/src/bridge.rs:449
msgid "Cannot prune the log: {reason}"
msgstr "Kan het logboek niet opschonen: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "Kies de Proton Drive-map"

#: ui/qml/main.qml:38
msgid "The folder is not empty"
msgstr "De map is niet leeg"

#: ui/qml/main.qml:73
msgid "Opened {what}"
msgstr "{what} geopend"

#: ui/qml/main.qml:75
msgid "Could not open {what} ({url})"
msgstr "Kan {what} ({url}) niet openen"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:131
msgid "Account"
msgstr "Account"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:133
msgid "Logs"
msgstr "Logboek"

#: ui/qml/main.qml:164
msgid "Not signed in"
msgstr "Niet aangemeld"

#: ui/qml/main.qml:171
msgid "Signed in to Proton Drive"
msgstr "Aangemeld bij Proton Drive"

#: ui/qml/main.qml:172
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Meld u aan om deze computer met Proton Drive te synchroniseren."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:193
msgid "Storage"
msgstr "Opslagruimte"

#: ui/qml/main.qml:221
msgid "{used} of {total} used"
msgstr "{used} van {total} gebruikt"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:233
msgid "Syncing to"
msgstr "Synchroniseren naar"

#: ui/qml/main.qml:237
msgid "nowhere yet"
msgstr "nog nergens"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:244
msgid "Change…"
msgstr "Wijzigen…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:251
msgid "Ignore file…"
msgstr "Negeerbestand…"

#: ui/qml/main.qml:263
msgid "Also download Proton Photos"
msgstr "Ook Proton Photos downloaden"

#: ui/qml/main.qml:271
msgid ""
"Read-only: your timeline is copied into {folder}. Photos are never uploaded, "
"changed or deleted in Proton Photos, and the copy is checked every half hour."
msgstr "Alleen-lezen: uw tijdlijn wordt naar {folder} gekopieerd. Foto's worden nooit geüpload, gewijzigd of verwijderd in Proton Photos, en de kopie wordt elk half uur gecontroleerd."

#: ui/qml/main.qml:272
msgid "your Pictures folder"
msgstr "uw map Afbeeldingen"

#: ui/qml/main.qml:319
msgid "Drive on the web"
msgstr "Drive op het web"

#: ui/qml/main.qml:324
msgid "Proton account"
msgstr "Proton-account"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:330
msgid "Refresh"
msgstr "Vernieuwen"

#: ui/qml/main.qml:336
msgid "Sign in"
msgstr "Aanmelden"

#: ui/qml/main.qml:379
msgid "Read the licence"
msgstr "De licentie lezen"

#: ui/qml/main.qml:397
msgid "Search the log"
msgstr "Zoeken in logboek"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:443
msgid "Copy"
msgstr "Kopiëren"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:449
msgid "Select all"
msgstr "Alles selecteren"

#: ui/qml/main.qml:466
msgid "No lines match"
msgstr "Geen overeenkomende regels"

#: ui/qml/main.qml:466
msgid "Nothing logged yet"
msgstr "Nog niets vastgelegd"

#: ui/qml/main.qml:468
msgid "No line since the sync daemon started contains “{term}”."
msgstr "Geen enkele regel sinds de start van de synchronisatiedienst bevat “{term}”."

#: ui/qml/main.qml:469
msgid "This shows what has happened since the sync daemon started."
msgstr "Dit toont wat er is gebeurd sinds de synchronisatiedienst is gestart."

#. TRANSLATORS: start of "Keep logs for [30] days"; the number and "days" follow
#: ui/qml/main.qml:478
msgid "Keep logs for"
msgstr "Logboek bewaren gedurende"

#. TRANSLATORS: end of "Keep logs for [30] days"
#: ui/qml/main.qml:488
msgid "days"
msgstr "dagen"

#. TRANSLATORS: verb, label before a dropdown choosing which log levels are written to disk
#: ui/qml/main.qml:493
msgid "Store"
msgstr "Vastleggen"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:501
msgid "Warnings and errors"
msgstr "Waarschuwingen en fouten"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:503
msgid "Everything"
msgstr "Alles"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:505
msgid "Errors only"
msgstr "Alleen fouten"

#: ui/qml/main.qml:514
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} regel"
msgstr[1] "{n} regels"

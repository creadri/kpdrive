#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:660
msgid "Errors only"
msgstr "Alleen fouten"

#: ui/qml/main.qml:681
msgid "Search the log"
msgstr "Zoeken in logboek"


msgstr "De map is niet leeg"

#: ui/qml/main.qml:80
msgid "Remove {account}?"
msgstr "{account} verwijderen?"

#: ui/qml/main.qml:81
msgid ""
"kpdrive signs this account out and forgets what it synced. The files in "
"{folder} stay where they are."
msgstr ""
"kpdrive meldt dit account af en vergeet wat het heeft gesynchroniseerd. De "
"bestanden in {folder} blijven staan waar ze staan."

#: ui/qml/main.qml:82
msgid "its folder"
msgstr "de bijbehorende map"

#: ui/qml/main.qml:86

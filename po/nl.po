#: src/daemon.rs:112
msgid "Signed out. Sign in from the account window."
msgstr "Afgemeld. Meld u aan via het accountvenster."

#: src/daemon.rs:114 src/daemon.rs:401
msgid "Syncing…"
msgstr "Bezig met synchroniseren…"

#: src/daemon.rs:116 src/daemon.rs:404
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} item gesynchroniseerd"
msgstr[1] "{n} items gesynchroniseerd"

#: src/daemon.rs:126 ui/qml/main.qml:409
msgid "Open folder"
msgstr "Map openen"

#: src/daemon.rs:136
msgid "Account and logs…"
msgstr "Account en logboek…"

#: src/daemon.rs:143 ui/qml/main.qml:396
msgid "Sync now"
msgstr "Nu synchroniseren"

#: src/daemon.rs:155
msgid "Pause sync"
msgstr "Synchroniseren pauzeren"

#: src/daemon.rs:168
msgid "Quit"
msgstr "Afsluiten"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:328
msgid "{reason}; retrying"
msgstr "{reason}; nieuwe poging"

#: src/daemon.rs:339
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive is weer bereikbaar, na {duration}"

#: src/daemon.rs:350
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} seconde"
msgstr[1] "{n} seconden"

#: src/daemon.rs:351
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuut"
msgstr[1] "{n} minuten"

#: src/daemon.rs:352
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} uur"
msgstr[1] "{n} uur"

#: src/daemon.rs:382
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"De synchronisatiedienst is niet actief. Start deze met: kpdrive sync --watch"

#: src/daemon.rs:385
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Er is een synchronisatiedienst actief, maar die is te oud om te melden "
"waarmee hij bezig is. Start deze opnieuw."

#: src/daemon.rs:391
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Afgemeld. Het synchroniseren gaat verder zodra u zich aanmeldt."

#: src/daemon.rs:395
msgid "{reason}. Still trying."
msgstr "{reason}. Er wordt nog geprobeerd."

#: src/daemon.rs:396
msgid "Last sync failed: {reason}"
msgstr "Laatste synchronisatie mislukt: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:410
msgid "just now"
msgstr "zojuist"

#: src/daemon.rs:412
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} minuut geleden"
msgstr[1] "{n} minuten geleden"

#: src/daemon.rs:415
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} uur geleden"
msgstr[1] "{n} uur geleden"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:419
msgid "{items}, checked {ago}"
msgstr "{items}, laatst gecontroleerd {ago}"

#: src/daemon.rs:637
msgid "Signed in again. Syncing resumed."
msgstr "Opnieuw aangemeld. Synchroniseren hervat."

#: src/daemon.rs:712
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Afgemeld. Meld u aan via het accountvenster om het synchroniseren te "
"hervatten."

#: src/daemon.rs:745
msgid "Sync resumed"
msgstr "Synchroniseren hervat"

#: src/daemon.rs:762
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} foto gedownload"
msgstr[1] "{n} foto's gedownload"

#: src/daemon.rs:783
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} foto geüpload naar Proton Photos"
msgstr[1] "{n} foto's geüpload naar Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:334
msgid "Sign out"
msgstr "Afmelden"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} foto"
msgstr[1] "{n} foto's"

#: src/pause.rs:20
msgid "Paused"
msgstr "Gepauzeerd"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "Gepauzeerd tijdens gebruik van netstroom"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "Gepauzeerd tijdens gebruik van de batterij"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "Gepauzeerd zolang de batterij bijna leeg is"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "Gepauzeerd zolang er verbinding is met {network}"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Hierin synchroniseren en behouden wat er al staat"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Deze map opzijzetten en met een lege map beginnen"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"{folder} bevat al {n} item, dat bij het synchroniseren met Proton Drive "
"wordt samengevoegd."
msgstr[1] ""
"{folder} bevat al {n} items, die bij het synchroniseren met Proton Drive "
"worden samengevoegd."

#: ui/src/bridge.rs:237
msgid "Starting…"
msgstr "Bezig met starten…"

#: ui/src/bridge.rs:288
msgid "Confirm the code {code} in your browser"
msgstr "Bevestig de code {code} in uw browser"

#: ui/src/bridge.rs:302
msgid "Sign-in failed: {reason}"
msgstr "Aanmelden mislukt: {reason}"

#: ui/src/bridge.rs:314
msgid "Signed out"
msgstr "Afgemeld"

#: ui/src/bridge.rs:317
msgid "Sign-out failed: {reason}"
msgstr "Afmelden mislukt: {reason}"

#: ui/src/bridge.rs:382
msgid "{note}. Restart the sync daemon to use it."
msgstr ""
"{note}. Start de synchronisatiedienst opnieuw om de wijziging toe te passen."

#: ui/src/bridge.rs:385
msgid "Cannot change the folder: {reason}"
msgstr "Kan de map niet wijzigen: {reason}"

#: ui/src/bridge.rs:392
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Nog geen synchronisatiemap. Voer uit: kpdrive setup"

#: ui/src/bridge.rs:396
msgid "Cannot create the ignore file: {reason}"
msgstr "Kan het negeerbestand niet aanmaken: {reason}"

#: ui/src/bridge.rs:434
msgid "Checking the account…"
msgstr "Bezig met controleren van het account…"

#: ui/src/bridge.rs:440
msgid "Opening the browser…"
msgstr "Bezig met openen van de browser…"

#: ui/src/bridge.rs:446
msgid "Signing out…"
msgstr "Bezig met afmelden…"

#: ui/src/bridge.rs:472
msgid "Cannot read the log: {reason}"
msgstr "Kan het logboek niet lezen: {reason}"

#: ui/src/bridge.rs:482 ui/src/bridge.rs:510 ui/src/bridge.rs:524
#: ui/src/bridge.rs:539 ui/src/bridge.rs:573 ui/src/bridge.rs:614
#: ui/src/bridge.rs:627 ui/src/bridge.rs:645
msgid "Cannot save the setting: {reason}"
msgstr "Kan de instelling niet opslaan: {reason}"

#: ui/src/bridge.rs:490
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos wordt bij de volgende synchronisatie gedownload"

#: ui/src/bridge.rs:491
msgid "Proton Photos will be left alone"
msgstr "Proton Photos wordt niet gedownload"

#: ui/src/bridge.rs:516
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr ""
"Foto's die in die map worden geplaatst, worden geüpload naar Proton Photos"

#: ui/src/bridge.rs:517
msgid "No longer uploading photos"
msgstr "Er worden geen foto's meer geüpload"

#: ui/src/bridge.rs:607
msgid "Photos will be downloaded into that folder from the next pass"
msgstr "Vanaf de volgende ronde worden foto's in die map gedownload"

#: ui/src/bridge.rs:632
msgid "Storing everything from now on"
msgstr "Vanaf nu wordt alles vastgelegd"

#: ui/src/bridge.rs:633
msgid "Storing warnings and errors from now on"
msgstr "Vanaf nu worden waarschuwingen en fouten vastgelegd"

#: ui/src/bridge.rs:634
msgid "Storing errors from now on"
msgstr "Vanaf nu worden alleen fouten vastgelegd"

#: ui/src/bridge.rs:650
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "{n} logbestand ouder dan {days} dagen verwijderd"
msgstr[1] "{n} logbestanden ouder dan {days} dagen verwijderd"

#: ui/src/bridge.rs:651
msgid "Cannot prune the log: {reason}"
msgstr "Kan het logboek niet opschonen: {reason}"

#: ui/qml/main.qml:28

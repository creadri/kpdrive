#: ui/qml/main.qml:184
msgid "Signed in to Proton Drive"
msgstr "Přihlášeno k Proton Drive"

#: ui/qml/main.qml:185
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Přihlaste se, chcete-li tento počítač synchronizovat s Proton Drive."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:206
msgid "Storage"

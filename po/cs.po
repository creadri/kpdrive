#: src/daemon.rs:102
msgid "Signed out. Sign in from the account window."
msgstr "Odhlášeno. Přihlaste se v okně účtu."

#: src/daemon.rs:104 src/daemon.rs:371
msgid "Syncing…"
msgstr "Synchronizuje se…"

#: src/daemon.rs:106 src/daemon.rs:374
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} položka synchronizována"
msgstr[1] "{n} položky synchronizovány"
msgstr[2] "{n} položek synchronizováno"

#: src/daemon.rs:116 ui/qml/main.qml:382
msgid "Open folder"
msgstr "Otevřít složku"

#: src/daemon.rs:126
msgid "Account and logs…"
msgstr "Účet a záznamy…"

#: src/daemon.rs:133 ui/qml/main.qml:360
msgid "Sync now"
msgstr "Synchronizovat nyní"

#: src/daemon.rs:143
msgid "Quit"
msgstr "Ukončit"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:303
msgid "{reason}; retrying"
msgstr "{reason}; zkouší se znovu"

#: src/daemon.rs:314
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive je opět dostupný ({duration})"

#: src/daemon.rs:325
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} sekunda"
msgstr[1] "{n} sekundy"
msgstr[2] "{n} sekund"

#: src/daemon.rs:326
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuta"
msgstr[1] "{n} minuty"
msgstr[2] "{n} minut"

#: src/daemon.rs:327
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} hodina"
msgstr[1] "{n} hodiny"
msgstr[2] "{n} hodin"

#: src/daemon.rs:355
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "Služba synchronizace neběží. Spusťte ji příkazem: kpdrive sync --watch"

#: src/daemon.rs:358
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Služba synchronizace běží, ale je příliš stará na to, aby sdělila, co dělá. "
"Restartujte ji."

#: src/daemon.rs:361
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Odhlášeno. Synchronizace bude pokračovat po přihlášení."

#: src/daemon.rs:365
msgid "{reason}. Still trying."
msgstr "{reason}. Pokusy pokračují."

#: src/daemon.rs:366
msgid "Last sync failed: {reason}"
msgstr "Poslední synchronizace selhala: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:380
msgid "just now"
msgstr "právě teď"

#: src/daemon.rs:382
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "před {n} minutou"
msgstr[1] "před {n} minutami"
msgstr[2] "před {n} minutami"

#: src/daemon.rs:385
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "před {n} hodinou"
msgstr[1] "před {n} hodinami"
msgstr[2] "před {n} hodinami"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:389
msgid "{items}, checked {ago}"
msgstr "{items}, zkontrolováno {ago}"

#: src/daemon.rs:606
msgid "Signed in again. Syncing resumed."
msgstr "Znovu přihlášeno. Synchronizace pokračuje."

#: src/daemon.rs:660
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "Odhlášeno. Přihlaste se v okně účtu, aby synchronizace pokračovala."

#: src/daemon.rs:693
msgid "Sync resumed"
msgstr "Synchronizace obnovena"

#: src/daemon.rs:710
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "Stažena {n} fotografie"
msgstr[1] "Staženy {n} fotografie"
msgstr[2] "Staženo {n} fotografií"

#: src/daemon.rs:731
#, fuzzy
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "Stahovat také Proton Photos"
msgstr[1] "Stahovat také Proton Photos"
msgstr[2] "Stahovat také Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:405
msgid "Sign out"
msgstr "Odhlásit se"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} fotografie"
msgstr[1] "{n} fotografie"
msgstr[2] "{n} fotografií"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Synchronizovat do ní a zachovat, co v ní už je"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Přesunout ji stranou a začít s prázdnou složkou"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"Složka {folder} už obsahuje {n} položku. Synchronizace její obsah sloučí s "
"Proton Drive."
msgstr[1] ""
"Složka {folder} už obsahuje {n} položky. Synchronizace její obsah sloučí s "
"Proton Drive."
msgstr[2] ""
"Složka {folder} už obsahuje {n} položek. Synchronizace její obsah sloučí s "
"Proton Drive."

#: ui/src/bridge.rs:189
msgid "Starting…"
msgstr "Spouští se…"

#: ui/src/bridge.rs:233
msgid "Confirm the code {code} in your browser"
msgstr "Potvrďte kód {code} v prohlížeči"

#: ui/src/bridge.rs:247
msgid "Sign-in failed: {reason}"
msgstr "Přihlášení selhalo: {reason}"

#: ui/src/bridge.rs:259
msgid "Signed out"
msgstr "Odhlášeno"

#: ui/src/bridge.rs:262
msgid "Sign-out failed: {reason}"
msgstr "Odhlášení selhalo: {reason}"

#: ui/src/bridge.rs:324
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Restartujte službu synchronizace, aby se změna projevila."

#: ui/src/bridge.rs:327
msgid "Cannot change the folder: {reason}"
msgstr "Nelze změnit složku: {reason}"

#: ui/src/bridge.rs:334
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Složka pro synchronizaci zatím není nastavena. Spusťte: kpdrive setup"

#: ui/src/bridge.rs:338
msgid "Cannot create the ignore file: {reason}"
msgstr "Nelze vytvořit soubor ignorovaných cest: {reason}"

#: ui/src/bridge.rs:375
msgid "Checking the account…"
msgstr "Kontroluje se účet…"

#: ui/src/bridge.rs:381
msgid "Opening the browser…"
msgstr "Otevírá se prohlížeč…"

#: ui/src/bridge.rs:387
msgid "Signing out…"
msgstr "Odhlašování…"

#: ui/src/bridge.rs:413
msgid "Cannot read the log: {reason}"
msgstr "Nelze přečíst záznam: {reason}"

#: ui/src/bridge.rs:423 ui/src/bridge.rs:451 ui/src/bridge.rs:467
#: ui/src/bridge.rs:480 ui/src/bridge.rs:498
msgid "Cannot save the setting: {reason}"
msgstr "Nelze uložit nastavení: {reason}"

#: ui/src/bridge.rs:431
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos budou staženy při příští synchronizaci"

#: ui/src/bridge.rs:432
msgid "Proton Photos will be left alone"
msgstr "Proton Photos budou ponechány beze změny"

#: ui/src/bridge.rs:457
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr ""

#: ui/src/bridge.rs:458
msgid "No longer uploading photos"
msgstr ""

#: ui/src/bridge.rs:485
msgid "Storing everything from now on"
msgstr "Od teď se ukládá vše"

#: ui/src/bridge.rs:486
msgid "Storing warnings and errors from now on"
msgstr "Od teď se ukládají varování a chyby"

#: ui/src/bridge.rs:487
msgid "Storing errors from now on"
msgstr "Od teď se ukládají pouze chyby"

#: ui/src/bridge.rs:503
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "odstraněn {n} soubor záznamu starší než {days} dní"
msgstr[1] "odstraněny {n} soubory záznamu starší než {days} dní"
msgstr[2] "odstraněno {n} souborů záznamu starších než {days} dní"

#: ui/src/bridge.rs:504
msgid "Cannot prune the log: {reason}"
msgstr "Nelze pročistit záznam: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "Vyberte složku pro Proton Drive"

#: ui/qml/main.qml:34
msgid "Choose the folder to upload photos from"
msgstr ""

#: ui/qml/main.qml:45
msgid "The folder is not empty"
msgstr "Složka není prázdná"

#: ui/qml/main.qml:80
msgid "Opened {what}"
msgstr "Otevřeno: {what}"

#: ui/qml/main.qml:82
msgid "Could not open {what} ({url})"
msgstr "Nelze otevřít: {what} ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:138
msgid "Account"
msgstr "Účet"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:140
msgid "Logs"

#: src/daemon.rs:98
msgid "Signed out. Sign in from the account window."
msgstr "Выполнен выход. Войдите в окне учётной записи."

#: src/daemon.rs:100 src/daemon.rs:341
msgid "Syncing…"
msgstr "Синхронизация…"

#: src/daemon.rs:102 src/daemon.rs:344
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} элемент синхронизирован"
msgstr[1] "{n} элемента синхронизированы"
msgstr[2] "{n} элементов синхронизировано"

#: src/daemon.rs:112 ui/qml/main.qml:313
msgid "Open folder"
msgstr "Открыть папку"

#: src/daemon.rs:122
msgid "Account and logs…"
msgstr "Учётная запись и журнал…"

#: src/daemon.rs:129 ui/qml/main.qml:291
msgid "Sync now"
msgstr "Синхронизировать сейчас"

#: src/daemon.rs:139
msgid "Quit"
msgstr "Выход"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:273
msgid "{reason}; retrying"
msgstr "{reason}; выполняется повторная попытка"

#: src/daemon.rs:284
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive снова доступен ({duration})"

#: src/daemon.rs:295
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} секунда"
msgstr[1] "{n} секунды"
msgstr[2] "{n} секунд"

#: src/daemon.rs:296
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} минута"
msgstr[1] "{n} минуты"
msgstr[2] "{n} минут"

#: src/daemon.rs:297
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} час"
msgstr[1] "{n} часа"
msgstr[2] "{n} часов"

#: src/daemon.rs:325
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "Служба синхронизации не запущена. Запустите её командой: kpdrive sync --watch"

#: src/daemon.rs:328
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr "Служба синхронизации запущена, но слишком старая, чтобы сообщить, чем она занята. Перезапустите её."

#: src/daemon.rs:331
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Выполнен выход. Синхронизация возобновится после входа."

#: src/daemon.rs:335
msgid "{reason}. Still trying."
msgstr "{reason}. Попытки продолжаются."

#: src/daemon.rs:336
msgid "Last sync failed: {reason}"
msgstr "Последняя синхронизация не удалась: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:350
msgid "just now"
msgstr "только что"

#: src/daemon.rs:352
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} минуту назад"
msgstr[1] "{n} минуты назад"
msgstr[2] "{n} минут назад"

#: src/daemon.rs:355
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} час назад"
msgstr[1] "{n} часа назад"
msgstr[2] "{n} часов назад"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:359
msgid "{items}, checked {ago}"
msgstr "{items}, проверено {ago}"

#: src/daemon.rs:576
msgid "Signed in again. Syncing resumed."
msgstr "Вход выполнен снова. Синхронизация возобновлена."

#: src/daemon.rs:630
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "Выполнен выход. Войдите в окне учётной записи, чтобы возобновить синхронизацию."

#: src/daemon.rs:663
msgid "Sync resumed"
msgstr "Синхронизация возобновлена"

#: src/daemon.rs:680
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "Загружена {n} фотография"
msgstr[1] "Загружено {n} фотографии"
msgstr[2] "Загружено {n} фотографий"

#: src/i18n.rs:111 ui/qml/main.qml:336
msgid "Sign out"
msgstr "Выйти"

#: src/i18n.rs:112 src/i18n.rs:113
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} фотография"
msgstr[1] "{n} фотографии"
msgstr[2] "{n} фотографий"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Синхронизировать в неё и сохранить то, что в ней уже есть"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Отложить её в сторону и начать с пустой папки"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] "В папке {folder} уже есть {n} элемент. Синхронизация объединит её содержимое с Proton Drive."
msgstr[1] "В папке {folder} уже есть {n} элемента. Синхронизация объединит её содержимое с Proton Drive."
msgstr[2] "В папке {folder} уже есть {n} элементов. Синхронизация объединит её содержимое с Proton Drive."

#: ui/src/bridge.rs:175
msgid "Starting…"
msgstr "Запуск…"

#: ui/src/bridge.rs:217
msgid "Confirm the code {code} in your browser"
msgstr "Подтвердите код {code} в браузере"

#: ui/src/bridge.rs:231
msgid "Sign-in failed: {reason}"
msgstr "Не удалось войти: {reason}"

#: ui/src/bridge.rs:243
msgid "Signed out"
msgstr "Выход выполнен"

#: ui/src/bridge.rs:246
msgid "Sign-out failed: {reason}"
msgstr "Не удалось выйти: {reason}"

#: ui/src/bridge.rs:305
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Перезапустите службу синхронизации, чтобы изменение вступило в силу."

#: ui/src/bridge.rs:308
msgid "Cannot change the folder: {reason}"
msgstr "Не удалось изменить папку: {reason}"

#: ui/src/bridge.rs:315
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Папка синхронизации ещё не задана. Выполните: kpdrive setup"

#: ui/src/bridge.rs:319
msgid "Cannot create the ignore file: {reason}"
msgstr "Не удалось создать файл исключений: {reason}"

#: ui/src/bridge.rs:356
msgid "Checking the account…"
msgstr "Проверка учётной записи…"

#: ui/src/bridge.rs:362
msgid "Opening the browser…"
msgstr "Открытие браузера…"

#: ui/src/bridge.rs:368
msgid "Signing out…"
msgstr "Выполняется выход…"

#: ui/src/bridge.rs:394
msgid "Cannot read the log: {reason}"
msgstr "Не удалось прочитать журнал: {reason}"

#: ui/src/bridge.rs:404 ui/src/bridge.rs:425 ui/src/bridge.rs:443
msgid "Cannot save the setting: {reason}"
msgstr "Не удалось сохранить параметр: {reason}"

#: ui/src/bridge.rs:412
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos будут загружены при следующей синхронизации"

#: ui/src/bridge.rs:413
msgid "Proton Photos will be left alone"
msgstr "Proton Photos останутся нетронутыми"

#: ui/src/bridge.rs:430
msgid "Storing everything from now on"
msgstr "Теперь сохраняется всё"

#: ui/src/bridge.rs:431
msgid "Storing warnings and errors from now on"
msgstr "Теперь сохраняются предупреждения и ошибки"

#: ui/src/bridge.rs:432
msgid "Storing errors from now on"
msgstr "Теперь сохраняются только ошибки"

#: ui/src/bridge.rs:448
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "удалён {n} файл журнала старше {days} дней"
msgstr[1] "удалено {n} файла журнала старше {days} дней"
msgstr[2] "удалено {n} файлов журнала старше {days} дней"

#: ui/src/bridge.rs:449
msgid "Cannot prune the log: {reason}"
msgstr "Не удалось очистить журнал: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "Выберите папку для Proton Drive"

#: ui/qml/main.qml:38
msgid "The folder is not empty"
msgstr "Папка не пуста"

#: ui/qml/main.qml:73
msgid "Opened {what}"
msgstr "Открыто: {what}"

#: ui/qml/main.qml:75
msgid "Could not open {what} ({url})"
msgstr "Не удалось открыть: {what} ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:131
msgid "Account"
msgstr "Учётная запись"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:133
msgid "Logs"
msgstr "Журнал"

#: ui/qml/main.qml:164
msgid "Not signed in"
msgstr "Вход не выполнен"

#: ui/qml/main.qml:171
msgid "Signed in to Proton Drive"
msgstr "Выполнен вход в Proton Drive"

#: ui/qml/main.qml:172
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Войдите, чтобы синхронизировать этот компьютер с Proton Drive."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:193
msgid "Storage"
msgstr "Хранилище"

#: ui/qml/main.qml:221
msgid "{used} of {total} used"
msgstr "Использовано {used} из {total}"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:233
msgid "Syncing to"
msgstr "Папка синхронизации"

#: ui/qml/main.qml:237
msgid "nowhere yet"
msgstr "ещё не выбрана"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:244
msgid "Change…"
msgstr "Изменить…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:251
msgid "Ignore file…"
msgstr "Файл исключений…"

#: ui/qml/main.qml:263
msgid "Also download Proton Photos"
msgstr "Также загружать Proton Photos"

#: ui/qml/main.qml:271
msgid ""
"Read-only: your timeline is copied into {folder}. Photos are never uploaded, "
"changed or deleted in Proton Photos, and the copy is checked every half hour."
msgstr "Только чтение: ваша лента копируется сюда: {folder}. Фотографии никогда не выгружаются, не изменяются и не удаляются в Proton Photos, а копия проверяется каждые полчаса."

#: ui/qml/main.qml:272
msgid "your Pictures folder"
msgstr "папка «Изображения»"

#: ui/qml/main.qml:319
msgid "Drive on the web"
msgstr "Drive в браузере"

#: ui/qml/main.qml:324
msgid "Proton account"
msgstr "Учётная запись Proton"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:330
msgid "Refresh"
msgstr "Обновить"

#: ui/qml/main.qml:336
msgid "Sign in"
msgstr "Войти"

#: ui/qml/main.qml:379
msgid "Read the licence"
msgstr "Прочитать лицензию"

#: ui/qml/main.qml:397
msgid "Search the log"
msgstr "Поиск в журнале"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:443
msgid "Copy"
msgstr "Копировать"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:449
msgid "Select all"
msgstr "Выделить всё"

#: ui/qml/main.qml:466
msgid "No lines match"
msgstr "Нет совпадающих строк"

#: ui/qml/main.qml:466
msgid "Nothing logged yet"
msgstr "Записей пока нет"

#: ui/qml/main.qml:468
msgid "No line since the sync daemon started contains “{term}”."
msgstr "Ни одна строка с момента запуска службы синхронизации не содержит «{term}»."

#: ui/qml/main.qml:469
msgid "This shows what has happened since the sync daemon started."
msgstr "Здесь показано, что произошло с момента запуска службы синхронизации."

#. TRANSLATORS: start of "Keep logs for [30] days"; the number and "days" follow
#: ui/qml/main.qml:478
msgid "Keep logs for"
msgstr "Хранить журнал"

#. TRANSLATORS: end of "Keep logs for [30] days"
#: ui/qml/main.qml:488
msgid "days"
msgstr "дней"

#. TRANSLATORS: verb, label before a dropdown choosing which log levels are written to disk
#: ui/qml/main.qml:493
msgid "Store"
msgstr "Сохранять"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:501
msgid "Warnings and errors"
msgstr "Предупреждения и ошибки"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:503
msgid "Everything"
msgstr "Всё"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:505
msgid "Errors only"
msgstr "Только ошибки"

#: ui/qml/main.qml:514
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} строка"
msgstr[1] "{n} строки"
msgstr[2] "{n} строк"

#: src/daemon.rs:143 ui/qml/main.qml:396
msgid "Sync now"
msgstr "지금 동기화"

#: src/daemon.rs:155
msgid "Pause sync"
msgstr "동기화 일시 중지"

#: src/daemon.rs:168
msgid "Quit"
msgstr "종료"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:328
msgid "{reason}; retrying"
msgstr "{reason}. 다시 시도합니다"

#: src/daemon.rs:339
msgid "Proton Drive is reachable again, after {duration}"
msgstr "{duration} 만에 Proton Drive에 다시 연결되었습니다"

#: src/daemon.rs:350
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n}초"

#: src/daemon.rs:351
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n}분"

#: src/daemon.rs:352
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n}시간"

#: src/daemon.rs:382
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"동기화 데몬이 실행 중이 아닙니다. 다음 명령으로 시작하십시오: kpdrive sync --"
"watch"

#: src/daemon.rs:385
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"동기화 데몬이 실행 중이지만 버전이 오래되어 진행 상태를 알릴 수 없습니다. 다"
"시 시작하십시오."

#: src/daemon.rs:391
msgid "Signed out. Syncing resumes once you sign in."
msgstr "로그아웃되었습니다. 로그인하면 동기화를 재개합니다."

#: src/daemon.rs:395
msgid "{reason}. Still trying."
msgstr "{reason}. 계속 시도합니다."

#: src/daemon.rs:396
msgid "Last sync failed: {reason}"
msgstr "마지막 동기화 실패: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:410
msgid "just now"
msgstr "방금 전"

#: src/daemon.rs:412
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n}분 전"

#: src/daemon.rs:415
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n}시간 전"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:419
msgid "{items}, checked {ago}"
msgstr "{items}, {ago} 확인함"

#: src/daemon.rs:637
msgid "Signed in again. Syncing resumed."
msgstr "다시 로그인했습니다. 동기화를 재개했습니다."

#: src/daemon.rs:712
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "로그아웃되었습니다. 동기화를 재개하려면 계정 창에서 로그인하십시오."

#: src/daemon.rs:745
msgid "Sync resumed"
msgstr "동기화 재개됨"

#: src/daemon.rs:762
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "사진 {n}장을 다운로드했습니다"

#: src/daemon.rs:783
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "사진 {n}장을 Proton Photos에 업로드했습니다"

#: src/i18n.rs:155 ui/qml/main.qml:334
msgid "Sign out"
msgstr "로그아웃"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "사진 {n}장"

#: src/pause.rs:20
msgid "Paused"
msgstr "일시 중지됨"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "AC 전원 사용 중이므로 일시 중지됨"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "배터리 사용 중이므로 일시 중지됨"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "배터리 부족으로 일시 중지됨"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "{network}에 연결되어 있어 일시 중지됨"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "이 폴더에 동기화하고 기존 내용 유지"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "폴더를 옮겨 두고 빈 폴더에서 시작"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"{folder} 폴더에 이미 항목 {n}개가 있으며, 동기화하면 Proton Drive와 병합됩니"
"다."

#: ui/src/bridge.rs:237
msgid "Starting…"
msgstr "시작하는 중…"

#: ui/src/bridge.rs:288

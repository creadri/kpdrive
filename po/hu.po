#: ui/qml/main.qml:269
msgid "Not signed in"
msgstr "Nincs bejelentkezve"

#: ui/qml/main.qml:276
msgid "Signed in to Proton Drive"
msgstr "Bejelentkezve a Proton Drive szolgáltatásba"

#: ui/qml/main.qml:277
msgid "Sign in to sync this computer with Proton Drive."
msgstr ""
"Jelentkezzen be, hogy szinkronizálja ezt a számítógépet a Proton Drive "
"szolgáltatással."

#: ui/qml/main.qml:294
msgid "Storage:"
msgstr "Tárhely:"

#: ui/qml/main.qml:323

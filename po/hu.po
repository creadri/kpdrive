#: src/daemon.rs:112
msgid "Signed out. Sign in from the account window."
msgstr "Kijelentkezve. Jelentkezzen be a fiók ablakából."

#: src/daemon.rs:114 src/daemon.rs:401
msgid "Syncing…"
msgstr "Szinkronizálás…"

#: src/daemon.rs:116 src/daemon.rs:404
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} elem szinkronban"
msgstr[1] "{n} elem szinkronban"

#: src/daemon.rs:126 ui/qml/main.qml:409
msgid "Open folder"
msgstr "Mappa megnyitása"

#: src/daemon.rs:136
msgid "Account and logs…"
msgstr "Fiók és naplók…"

#: src/daemon.rs:143 ui/qml/main.qml:396
msgid "Sync now"
msgstr "Szinkronizálás most"

#: src/daemon.rs:155
msgid "Pause sync"
msgstr "Szinkronizálás szüneteltetése"

#: src/daemon.rs:168
msgid "Quit"
msgstr "Kilépés"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:328
msgid "{reason}; retrying"
msgstr "{reason}; újrapróbálkozás"

#: src/daemon.rs:339
msgid "Proton Drive is reachable again, after {duration}"
msgstr "A Proton Drive ismét elérhető, {duration} után"

#: src/daemon.rs:350
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} másodperc"
msgstr[1] "{n} másodperc"

#: src/daemon.rs:351
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} perc"
msgstr[1] "{n} perc"

#: src/daemon.rs:352
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} óra"
msgstr[1] "{n} óra"

#: src/daemon.rs:382
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"A szinkronizálási szolgáltatás nem fut. Indítsa el ezzel: kpdrive sync --"
"watch"

#: src/daemon.rs:385
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Fut egy szinkronizálási szolgáltatás, de túl régi ahhoz, hogy jelezze, mit "
"csinál. Indítsa újra."

#: src/daemon.rs:391
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Kijelentkezve. A szinkronizálás a bejelentkezés után folytatódik."

#: src/daemon.rs:395
msgid "{reason}. Still trying."
msgstr "{reason}. A próbálkozás folytatódik."

#: src/daemon.rs:396
msgid "Last sync failed: {reason}"
msgstr "A legutóbbi szinkronizálás sikertelen: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:410
msgid "just now"
msgstr "éppen most"

#: src/daemon.rs:412
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} perce"
msgstr[1] "{n} perce"

#: src/daemon.rs:415
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} órája"
msgstr[1] "{n} órája"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:419
msgid "{items}, checked {ago}"
msgstr "{items}, ellenőrizve {ago}"

#: src/daemon.rs:637
msgid "Signed in again. Syncing resumed."
msgstr "Ismét bejelentkezve. A szinkronizálás folytatódik."

#: src/daemon.rs:712
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Kijelentkezve. Jelentkezzen be a fiók ablakából a szinkronizálás "
"folytatásához."

#: src/daemon.rs:745
msgid "Sync resumed"
msgstr "Szinkronizálás folytatva"

#: src/daemon.rs:762
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} fénykép letöltve"
msgstr[1] "{n} fénykép letöltve"

#: src/daemon.rs:783
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} fénykép feltöltve a Proton Photos szolgáltatásba"
msgstr[1] "{n} fénykép feltöltve a Proton Photos szolgáltatásba"

#: src/i18n.rs:155 ui/qml/main.qml:334
msgid "Sign out"
msgstr "Kijelentkezés"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} fénykép"
msgstr[1] "{n} fénykép"

#: src/pause.rs:20
msgid "Paused"
msgstr "Szüneteltetve"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "Szüneteltetve hálózati tápellátás alatt"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "Szüneteltetve akkumulátoros üzem alatt"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "Szüneteltetve, amíg az akkumulátor töltöttsége alacsony"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "Szüneteltetve, amíg a(z) {network} hálózathoz csatlakozik"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Szinkronizálás bele, a meglévő tartalom megtartásával"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Félretétele és indulás üres mappából"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"A(z) {folder} mappa már tartalmaz {n} elemet, amelyet a szinkronizálás "
"egyesít a Proton Drive tartalmával."
msgstr[1] ""
"A(z) {folder} mappa már tartalmaz {n} elemet, amelyeket a szinkronizálás "
"egyesít a Proton Drive tartalmával."

#: ui/src/bridge.rs:237
msgid "Starting…"
msgstr "Indítás…"

#: ui/src/bridge.rs:288
msgid "Confirm the code {code} in your browser"
msgstr "Erősítse meg a(z) {code} kódot a böngészőjében"

#: ui/src/bridge.rs:302
msgid "Sign-in failed: {reason}"
msgstr "A bejelentkezés sikertelen: {reason}"

#: ui/src/bridge.rs:314
msgid "Signed out"
msgstr "Kijelentkezve"

#: ui/src/bridge.rs:317
msgid "Sign-out failed: {reason}"
msgstr "A kijelentkezés sikertelen: {reason}"

#: ui/src/bridge.rs:382
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. A használatához indítsa újra a szinkronizálási szolgáltatást."

#: ui/src/bridge.rs:385
msgid "Cannot change the folder: {reason}"
msgstr "A mappa nem módosítható: {reason}"

#: ui/src/bridge.rs:392
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Még nincs szinkronizálási mappa. Futtassa: kpdrive setup"

#: ui/src/bridge.rs:396
msgid "Cannot create the ignore file: {reason}"
msgstr "A mellőzési fájl nem hozható létre: {reason}"

#: ui/src/bridge.rs:434
msgid "Checking the account…"
msgstr "A fiók ellenőrzése…"

#: ui/src/bridge.rs:440
msgid "Opening the browser…"
msgstr "A böngésző megnyitása…"

#: ui/src/bridge.rs:446
msgid "Signing out…"
msgstr "Kijelentkezés…"

#: ui/src/bridge.rs:472
msgid "Cannot read the log: {reason}"
msgstr "A napló nem olvasható: {reason}"

#: ui/src/bridge.rs:482 ui/src/bridge.rs:510 ui/src/bridge.rs:524
#: ui/src/bridge.rs:539 ui/src/bridge.rs:573 ui/src/bridge.rs:614
#: ui/src/bridge.rs:627 ui/src/bridge.rs:645
msgid "Cannot save the setting: {reason}"
msgstr "A beállítás nem menthető: {reason}"

#: ui/src/bridge.rs:490
msgid "Proton Photos will be downloaded with the next sync"
msgstr "A Proton Photos tartalma a következő szinkronizáláskor letöltődik"

#: ui/src/bridge.rs:491
msgid "Proton Photos will be left alone"
msgstr "A Proton Photos érintetlen marad"

#: ui/src/bridge.rs:516
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr ""
"Az abba a mappába tett fényképek feltöltődnek a Proton Photos szolgáltatásba"

#: ui/src/bridge.rs:517
msgid "No longer uploading photos"
msgstr "A fényképek feltöltése leállt"

#: ui/src/bridge.rs:607
msgid "Photos will be downloaded into that folder from the next pass"
msgstr "A fényképek a következő körtől abba a mappába töltődnek le"

#: ui/src/bridge.rs:632
msgid "Storing everything from now on"
msgstr "Mostantól minden tárolva lesz"

#: ui/src/bridge.rs:633
msgid "Storing warnings and errors from now on"
msgstr "Mostantól a figyelmeztetések és a hibák lesznek tárolva"

#: ui/src/bridge.rs:634
msgid "Storing errors from now on"
msgstr "Mostantól csak a hibák lesznek tárolva"

#: ui/src/bridge.rs:650
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "{days} napnál régebbi {n} naplófájl eltávolítva"
msgstr[1] "{days} napnál régebbi {n} naplófájl eltávolítva"

#: ui/src/bridge.rs:651
msgid "Cannot prune the log: {reason}"
msgstr "A napló nem tisztítható: {reason}"

#: ui/qml/main.qml:28
msgid "Choose the Proton Drive folder"
msgstr "Válassza ki a Proton Drive mappát"

#: ui/qml/main.qml:35
msgid "Choose where Proton Photos are downloaded"
msgstr "Válassza ki, hová töltődjön le a Proton Photos"

#: ui/qml/main.qml:42
msgid "Choose the folder to upload photos from"
msgstr "Válassza ki a mappát, ahonnan a fényképek feltöltődnek"

#: ui/qml/main.qml:53
msgid "The folder is not empty"
msgstr "A mappa nem üres"

#: ui/qml/main.qml:104
msgid "Opened {what}"
msgstr "{what} megnyitva"

#: ui/qml/main.qml:106

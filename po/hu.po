#: src/daemon.rs:98
msgid "Signed out. Sign in from the account window."
msgstr "Kijelentkezve. Jelentkezzen be a fiók ablakából."

#: src/daemon.rs:100 src/daemon.rs:341
msgid "Syncing…"
msgstr "Szinkronizálás…"

#: src/daemon.rs:102 src/daemon.rs:344
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} elem szinkronban"
msgstr[1] "{n} elem szinkronban"

#: src/daemon.rs:112 ui/qml/main.qml:313
msgid "Open folder"
msgstr "Mappa megnyitása"

#: src/daemon.rs:122
msgid "Account and logs…"
msgstr "Fiók és naplók…"

#: src/daemon.rs:129 ui/qml/main.qml:291
msgid "Sync now"
msgstr "Szinkronizálás most"

#: src/daemon.rs:139
msgid "Quit"
msgstr "Kilépés"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:273
msgid "{reason}; retrying"
msgstr "{reason}; újrapróbálkozás"

#: src/daemon.rs:284
msgid "Proton Drive is reachable again, after {duration}"
msgstr "A Proton Drive ismét elérhető, {duration} után"

#: src/daemon.rs:295
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} másodperc"
msgstr[1] "{n} másodperc"

#: src/daemon.rs:296
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} perc"
msgstr[1] "{n} perc"

#: src/daemon.rs:297
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} óra"
msgstr[1] "{n} óra"

#: src/daemon.rs:325
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "A szinkronizálási szolgáltatás nem fut. Indítsa el ezzel: kpdrive sync --watch"

#: src/daemon.rs:328
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr "Fut egy szinkronizálási szolgáltatás, de túl régi ahhoz, hogy jelezze, mit csinál. Indítsa újra."

#: src/daemon.rs:331
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Kijelentkezve. A szinkronizálás a bejelentkezés után folytatódik."

#: src/daemon.rs:335
msgid "{reason}. Still trying."
msgstr "{reason}. A próbálkozás folytatódik."

#: src/daemon.rs:336
msgid "Last sync failed: {reason}"
msgstr "A legutóbbi szinkronizálás sikertelen: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:350
msgid "just now"
msgstr "éppen most"

#: src/daemon.rs:352
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} perce"
msgstr[1] "{n} perce"

#: src/daemon.rs:355
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} órája"
msgstr[1] "{n} órája"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:359
msgid "{items}, checked {ago}"
msgstr "{items}, ellenőrizve {ago}"

#: src/daemon.rs:576
msgid "Signed in again. Syncing resumed."
msgstr "Ismét bejelentkezve. A szinkronizálás folytatódik."

#: src/daemon.rs:630
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "Kijelentkezve. Jelentkezzen be a fiók ablakából a szinkronizálás folytatásához."

#: src/daemon.rs:663
msgid "Sync resumed"
msgstr "Szinkronizálás folytatva"

#: src/daemon.rs:680
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} fénykép letöltve"
msgstr[1] "{n} fénykép letöltve"

#: src/i18n.rs:111 ui/qml/main.qml:336
msgid "Sign out"
msgstr "Kijelentkezés"

#: src/i18n.rs:112 src/i18n.rs:113
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} fénykép"
msgstr[1] "{n} fénykép"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Szinkronizálás bele, a meglévő tartalom megtartásával"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Félretétele és indulás üres mappából"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] "A(z) {folder} mappa már tartalmaz {n} elemet, amelyet a szinkronizálás egyesít a Proton Drive tartalmával."
msgstr[1] "A(z) {folder} mappa már tartalmaz {n} elemet, amelyeket a szinkronizálás egyesít a Proton Drive tartalmával."

#: ui/src/bridge.rs:175
msgid "Starting…"
msgstr "Indítás…"

#: ui/src/bridge.rs:217
msgid "Confirm the code {code} in your browser"
msgstr "Erősítse meg a(z) {code} kódot a böngészőjében"

#: ui/src/bridge.rs:231
msgid "Sign-in failed: {reason}"
msgstr "A bejelentkezés sikertelen: {reason}"

#: ui/src/bridge.rs:243
msgid "Signed out"
msgstr "Kijelentkezve"

#: ui/src/bridge.rs:246
msgid "Sign-out failed: {reason}"
msgstr "A kijelentkezés sikertelen: {reason}"

#: ui/src/bridge.rs:305
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. A használatához indítsa újra a szinkronizálási szolgáltatást."

#: ui/src/bridge.rs:308
msgid "Cannot change the folder: {reason}"
msgstr "A mappa nem módosítható: {reason}"

#: ui/src/bridge.rs:315
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Még nincs szinkronizálási mappa. Futtassa: kpdrive setup"

#: ui/src/bridge.rs:319
msgid "Cannot create the ignore file: {reason}"
msgstr "A mellőzési fájl nem hozható létre: {reason}"

#: ui/src/bridge.rs:356
msgid "Checking the account…"
msgstr "A fiók ellenőrzése…"

#: ui/src/bridge.rs:362
msgid "Opening the browser…"
msgstr "A böngésző megnyitása…"

#: ui/src/bridge.rs:368
msgid "Signing out…"
msgstr "Kijelentkezés…"

#: ui/src/bridge.rs:394
msgid "Cannot read the log: {reason}"
msgstr "A napló nem olvasható: {reason}"

#: ui/src/bridge.rs:404 ui/src/bridge.rs:425 ui/src/bridge.rs:443
msgid "Cannot save the setting: {reason}"
msgstr "A beállítás nem menthető: {reason}"

#: ui/src/bridge.rs:412
msgid "Proton Photos will be downloaded with the next sync"
msgstr "A Proton Photos tartalma a következő szinkronizáláskor letöltődik"

#: ui/src/bridge.rs:413
msgid "Proton Photos will be left alone"
msgstr "A Proton Photos érintetlen marad"

#: ui/src/bridge.rs:430
msgid "Storing everything from now on"
msgstr "Mostantól minden tárolva lesz"

#: ui/src/bridge.rs:431
msgid "Storing warnings and errors from now on"
msgstr "Mostantól a figyelmeztetések és a hibák lesznek tárolva"

#: ui/src/bridge.rs:432
msgid "Storing errors from now on"
msgstr "Mostantól csak a hibák lesznek tárolva"

#: ui/src/bridge.rs:448
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "{days} napnál régebbi {n} naplófájl eltávolítva"
msgstr[1] "{days} napnál régebbi {n} naplófájl eltávolítva"

#: ui/src/bridge.rs:449
msgid "Cannot prune the log: {reason}"
msgstr "A napló nem tisztítható: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "Válassza ki a Proton Drive mappát"

#: ui/qml/main.qml:38
msgid "The folder is not empty"
msgstr "A mappa nem üres"

#: ui/qml/main.qml:73
msgid "Opened {what}"
msgstr "{what} megnyitva"

#: ui/qml/main.qml:75
msgid "Could not open {what} ({url})"
msgstr "{what} nem nyitható meg ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:131
msgid "Account"
msgstr "Fiók"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:133
msgid "Logs"
msgstr "Naplók"

#: ui/qml/main.qml:164
msgid "Not signed in"
msgstr "Nincs bejelentkezve"

#: ui/qml/main.qml:171
msgid "Signed in to Proton Drive"
msgstr "Bejelentkezve a Proton Drive szolgáltatásba"

#: ui/qml/main.qml:172
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Jelentkezzen be, hogy szinkronizálja ezt a számítógépet a Proton Drive szolgáltatással."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:193
msgid "Storage"
msgstr "Tárhely"

#: ui/qml/main.qml:221
msgid "{used} of {total} used"
msgstr "{used} / {total} felhasználva"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:233
msgid "Syncing to"
msgstr "Szinkronizálás ide:"

#: ui/qml/main.qml:237
msgid "nowhere yet"
msgstr "még sehová"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:244
msgid "Change…"
msgstr "Módosítás…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:251
msgid "Ignore file…"
msgstr "Mellőzési fájl…"

#: ui/qml/main.qml:263
msgid "Also download Proton Photos"
msgstr "A Proton Photos letöltése is"

#: ui/qml/main.qml:271
msgid ""
"Read-only: your timeline is copied into {folder}. Photos are never uploaded, "
"changed or deleted in Proton Photos, and the copy is checked every half hour."
msgstr "Csak olvasható: az idővonaláról másolat készül. Célmappa: {folder}. A fényképek soha nem kerülnek feltöltésre, módosításra vagy törlésre a Proton Photos szolgáltatásban, és a másolat félóránként ellenőrzésre kerül."

#: ui/qml/main.qml:272
msgid "your Pictures folder"
msgstr "a Képek mappája"

#: ui/qml/main.qml:319
msgid "Drive on the web"
msgstr "A Drive a weben"

#: ui/qml/main.qml:324
msgid "Proton account"
msgstr "Proton fiók"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:330
msgid "Refresh"
msgstr "Frissítés"

#: ui/qml/main.qml:336
msgid "Sign in"
msgstr "Bejelentkezés"

#: ui/qml/main.qml:379
msgid "Read the licence"
msgstr "A licenc elolvasása"

#: ui/qml/main.qml:397
msgid "Search the log"
msgstr "Keresés a naplóban"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:443
msgid "Copy"
msgstr "Másolás"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:449
msgid "Select all"
msgstr "Az összes kijelölése"

#: ui/qml/main.qml:466
msgid "No lines match"
msgstr "Nincs egyező sor"

#: ui/qml/main.qml:466
msgid "Nothing logged yet"
msgstr "Még nincs naplóbejegyzés"

#: ui/qml/main.qml:468
msgid "No line since the sync daemon started contains “{term}”."
msgstr "A szinkronizálási szolgáltatás indítása óta egyetlen sor sem tartalmazza ezt: „{term}”."

#: ui/qml/main.qml:469
msgid "This shows what has happened since the sync daemon started."
msgstr "Itt látható, hogy mi történt a szinkronizálási szolgáltatás indítása óta."

#. TRANSLATORS: start of "Keep logs for [30] days"; the number and "days" follow
#: ui/qml/main.qml:478
msgid "Keep logs for"
msgstr "Naplók megőrzése"

#. TRANSLATORS: end of "Keep logs for [30] days"
#: ui/qml/main.qml:488
msgid "days"
msgstr "napig"

#. TRANSLATORS: verb, label before a dropdown choosing which log levels are written to disk
#: ui/qml/main.qml:493
msgid "Store"
msgstr "Tárolás"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:501
msgid "Warnings and errors"
msgstr "Figyelmeztetések és hibák"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:503
msgid "Everything"
msgstr "Minden"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:505
msgid "Errors only"
msgstr "Csak hibák"

#: ui/qml/main.qml:514
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} sor"
msgstr[1] "{n} sor"

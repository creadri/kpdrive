#: ui/qml/main.qml:583
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""
"Az ebbe a mappába tett fényképek és videók egy percen belül feltöltődnek a "
"Proton Photos szolgáltatásba, majd kikerülnek a mappából. Ami nem tölthető "
"fel, az a mappában marad."

#: ui/qml/main.qml:591
msgid "Upload folder:"
msgstr "Feltöltési mappa:"

#: ui/qml/main.qml:608
msgid "After upload:"
msgstr "Feltöltés után:"


msgstr "Proton fiók"

#: ui/qml/main.qml:366
msgid "Activity"
msgstr "Tevékenység"

#: ui/qml/main.qml:373
msgid "Sync:"
msgstr "Szinkronizálás:"

#: ui/qml/main.qml:404
msgid "Resume"
msgstr "Folytatás"

#: ui/qml/main.qml:404
msgid "Pause"
msgstr "Szüneteltetés"

#: ui/qml/main.qml:429
msgid "Files"
msgstr "Fájlok"

#: ui/qml/main.qml:433
msgid "Sync folder:"
msgstr "Szinkronizált mappa:"

#: ui/qml/main.qml:437
msgid "nowhere yet"
msgstr "még sehová"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:443 ui/qml/main.qml:490 ui/qml/main.qml:533
msgid "Change…"
msgstr "Módosítás…"

#: ui/qml/main.qml:450
msgid "Ignored paths:"
msgstr "Mellőzött útvonalak:"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves
#. alone

#: src/daemon.rs:67 src/daemon.rs:174
msgid "Signed out. Sign in from the account window."
msgstr "Kijelentkezve. Jelentkezzen be a fiók ablakából."

#: src/daemon.rs:69 src/daemon.rs:535
msgid "Syncing…"
msgstr "Szinkronizálás…"

#: src/daemon.rs:71 src/daemon.rs:538
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} elem szinkronban"
msgstr[1] "{n} elem szinkronban"

#: src/daemon.rs:199 src/daemon.rs:201 ui/qml/main.qml:469
msgid "Open folder"
msgstr "Mappa megnyitása"

#: src/daemon.rs:211
msgid "Account and logs…"
msgstr "Fiók és naplók…"

#: src/daemon.rs:218 ui/qml/main.qml:456
msgid "Sync now"
msgstr "Szinkronizálás most"

#: src/daemon.rs:230
msgid "Pause sync"
msgstr "Szinkronizálás szüneteltetése"

#: src/daemon.rs:243
msgid "Quit"
msgstr "Kilépés"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:430
msgid "{reason}; retrying"
msgstr "{reason}; újrapróbálkozás"

#: src/daemon.rs:441
msgid "Proton Drive is reachable again, after {duration}"
msgstr "A Proton Drive ismét elérhető, {duration} után"

#: src/daemon.rs:452
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} másodperc"
msgstr[1] "{n} másodperc"

#: src/daemon.rs:453
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} perc"
msgstr[1] "{n} perc"

#: src/daemon.rs:454
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} óra"
msgstr[1] "{n} óra"

#: src/daemon.rs:502
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"A szinkronizálási szolgáltatás nem fut. Indítsa el ezzel: kpdrive sync --"
"watch"

#: src/daemon.rs:505
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Fut egy szinkronizálási szolgáltatás, de túl régi ahhoz, hogy jelezze, mit "
"csinál. Indítsa újra."

#: src/daemon.rs:516 src/daemon.rs:525
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Kijelentkezve. A szinkronizálás a bejelentkezés után folytatódik."

#: src/daemon.rs:529
msgid "{reason}. Still trying."
msgstr "{reason}. A próbálkozás folytatódik."

#: src/daemon.rs:530
msgid "Last sync failed: {reason}"
msgstr "A legutóbbi szinkronizálás sikertelen: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:544
msgid "just now"
msgstr "éppen most"

#: src/daemon.rs:546
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} perce"
msgstr[1] "{n} perce"

#: src/daemon.rs:549
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} órája"
msgstr[1] "{n} órája"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:553
msgid "{items}, checked {ago}"
msgstr "{items}, ellenőrizve {ago}"

#: src/daemon.rs:924
msgid "Signed in again. Syncing resumed."
msgstr "Ismét bejelentkezve. A szinkronizálás folytatódik."

#: src/daemon.rs:938
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Kijelentkezve. Jelentkezzen be a fiók ablakából a szinkronizálás "
"folytatásához."

#: src/daemon.rs:1050
msgid "Sync resumed"
msgstr "Szinkronizálás folytatva"

#: src/daemon.rs:1067
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} fénykép letöltve"
msgstr[1] "{n} fénykép letöltve"

#: src/daemon.rs:1086
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} fénykép feltöltve a Proton Photos szolgáltatásba"
msgstr[1] "{n} fénykép feltöltve a Proton Photos szolgáltatásba"

#: src/i18n.rs:155 ui/qml/main.qml:387
msgid "Sign out"
msgstr "Kijelentkezés"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} fénykép"
msgstr[1] "{n} fénykép"

#: src/pause.rs:20
msgid "Paused"
msgstr "Szüneteltetve"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "Szüneteltetve hálózati tápellátás alatt"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "Szüneteltetve akkumulátoros üzem alatt"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "Szüneteltetve, amíg az akkumulátor töltöttsége alacsony"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "Szüneteltetve, amíg a(z) {network} hálózathoz csatlakozik"

#: src/sync.rs:124
msgid "Sync into it and keep what is already there"
msgstr "Szinkronizálás bele, a meglévő tartalom megtartásával"

#: src/sync.rs:125
msgid "Move it aside and start from an empty folder"
msgstr "Félretétele és indulás üres mappából"

#: src/sync.rs:163
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"A(z) {folder} mappa már tartalmaz {n} elemet, amelyet a szinkronizálás "
"egyesít a Proton Drive tartalmával."
msgstr[1] ""
"A(z) {folder} mappa már tartalmaz {n} elemet, amelyeket a szinkronizálás "
"egyesít a Proton Drive tartalmával."

#: ui/src/bridge.rs:260
msgid "Starting…"
msgstr "Indítás…"

#: ui/src/bridge.rs:317
msgid "Confirm the code {code} in your browser"
msgstr "Erősítse meg a(z) {code} kódot a böngészőjében"

#: ui/src/bridge.rs:331
msgid "Sign-in failed: {reason}"
msgstr "A bejelentkezés sikertelen: {reason}"

#: ui/src/bridge.rs:344
msgid "Signed out"

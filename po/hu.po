#: ui/qml/main.qml:81
msgid ""
"kpdrive signs this account out and forgets what it synced. The files in "
"{folder} stay where they are."
msgstr ""
"A kpdrive kijelentkezteti ezt a fiókot, és elfelejti, mit szinkronizált. A "
"fájlok a helyükön maradnak itt: {folder}."

#: ui/qml/main.qml:82
msgid "its folder"
msgstr "a fiók mappája"

#: ui/qml/main.qml:86

#: ui/qml/main.qml:621 ui/qml/main.qml:666
msgid "Pause while on:"
msgstr "Pausieren bei:"

#: ui/qml/main.qml:641
msgid "{network} (connected)"
msgstr "{network} (verbunden)"

#: ui/qml/main.qml:652
msgid ""
"Syncing pauses while any ticked network is connected, such as a phone's "
"hotspot. A sync already under way finishes first."
msgstr ""
"Die Synchronisierung pausiert, solange ein angehaktes Netzwerk verbunden "
"ist, etwa der Hotspot eines Telefons. Eine bereits laufende Synchronisierung "
"wird zuerst abgeschlossen."

#: ui/qml/main.qml:653
msgid "NetworkManager lists no networks to choose from."
msgstr "NetworkManager listet keine Netzwerke zur Auswahl auf."

#: ui/qml/main.qml:662
msgid "Power"
msgstr "Energie"

#: ui/qml/main.qml:672

#: src/daemon.rs:102
msgid "Signed out. Sign in from the account window."
msgstr "Abgemeldet. Melden Sie sich im Kontofenster an."

#: src/daemon.rs:104 src/daemon.rs:371
msgid "Syncing…"
msgstr "Wird synchronisiert…"

#: src/daemon.rs:106 src/daemon.rs:374
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} Element synchron"
msgstr[1] "{n} Elemente synchron"

#: src/daemon.rs:116 ui/qml/main.qml:382
msgid "Open folder"
msgstr "Ordner öffnen"

#: src/daemon.rs:126
msgid "Account and logs…"
msgstr "Konto und Protokoll…"

#: src/daemon.rs:133 ui/qml/main.qml:360
msgid "Sync now"
msgstr "Jetzt synchronisieren"

#: src/daemon.rs:143
msgid "Quit"
msgstr "Beenden"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:303
msgid "{reason}; retrying"
msgstr "{reason}; neuer Versuch"

#: src/daemon.rs:314
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive ist wieder erreichbar, nach {duration}"

#: src/daemon.rs:325
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} Sekunde"
msgstr[1] "{n} Sekunden"

#: src/daemon.rs:326
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} Minute"
msgstr[1] "{n} Minuten"

#: src/daemon.rs:327
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} Stunde"
msgstr[1] "{n} Stunden"

#: src/daemon.rs:355
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "Der Sync-Dienst läuft nicht. Starten Sie ihn mit: kpdrive sync --watch"

#: src/daemon.rs:358
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Ein Sync-Dienst läuft, ist aber zu alt, um seinen Status zu melden. Starten "
"Sie ihn neu."

#: src/daemon.rs:361
msgid "Signed out. Syncing resumes once you sign in."
msgstr ""
"Abgemeldet. Die Synchronisierung wird fortgesetzt, sobald Sie sich anmelden."

#: src/daemon.rs:365
msgid "{reason}. Still trying."
msgstr "{reason}. Der Versuch läuft weiter."

#: src/daemon.rs:366
msgid "Last sync failed: {reason}"
msgstr "Letzte Synchronisierung fehlgeschlagen: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:380
msgid "just now"
msgstr "gerade eben"

#: src/daemon.rs:382
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "vor {n} Minute"
msgstr[1] "vor {n} Minuten"

#: src/daemon.rs:385
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "vor {n} Stunde"
msgstr[1] "vor {n} Stunden"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:389
msgid "{items}, checked {ago}"
msgstr "{items}, geprüft {ago}"

#: src/daemon.rs:606
msgid "Signed in again. Syncing resumed."
msgstr "Wieder angemeldet. Die Synchronisierung wurde fortgesetzt."

#: src/daemon.rs:660
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Abgemeldet. Melden Sie sich im Kontofenster an, um die Synchronisierung "
"fortzusetzen."

#: src/daemon.rs:693
msgid "Sync resumed"
msgstr "Synchronisierung fortgesetzt"

#: src/daemon.rs:710
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} Foto heruntergeladen"
msgstr[1] "{n} Fotos heruntergeladen"

#: src/daemon.rs:731
#, fuzzy
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "Proton Photos ebenfalls herunterladen"
msgstr[1] "Proton Photos ebenfalls herunterladen"

#: src/i18n.rs:155 ui/qml/main.qml:405
msgid "Sign out"
msgstr "Abmelden"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} Foto"
msgstr[1] "{n} Fotos"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Hinein synchronisieren und Vorhandenes behalten"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Beiseite verschieben und mit leerem Ordner beginnen"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"{folder} enthält bereits {n} Element, das beim Synchronisieren mit Proton "
"Drive zusammengeführt wird."
msgstr[1] ""
"{folder} enthält bereits {n} Elemente, die beim Synchronisieren mit Proton "
"Drive zusammengeführt werden."

#: ui/src/bridge.rs:189
msgid "Starting…"
msgstr "Wird gestartet…"

#: ui/src/bridge.rs:233
msgid "Confirm the code {code} in your browser"
msgstr "Bestätigen Sie den Code {code} in Ihrem Browser"

#: ui/src/bridge.rs:247
msgid "Sign-in failed: {reason}"
msgstr "Anmeldung fehlgeschlagen: {reason}"

#: ui/src/bridge.rs:259
msgid "Signed out"
msgstr "Abgemeldet"

#: ui/src/bridge.rs:262
msgid "Sign-out failed: {reason}"
msgstr "Abmeldung fehlgeschlagen: {reason}"

#: ui/src/bridge.rs:324
msgid "{note}. Restart the sync daemon to use it."
msgstr ""
"{note}. Starten Sie den Sync-Dienst neu, damit die Änderung wirksam wird."

#: ui/src/bridge.rs:327
msgid "Cannot change the folder: {reason}"
msgstr "Der Ordner kann nicht geändert werden: {reason}"

#: ui/src/bridge.rs:334
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Noch kein Sync-Ordner. Führen Sie aus: kpdrive setup"

#: ui/src/bridge.rs:338
msgid "Cannot create the ignore file: {reason}"
msgstr "Die Ignorierdatei kann nicht erstellt werden: {reason}"

#: ui/src/bridge.rs:375
msgid "Checking the account…"
msgstr "Konto wird geprüft…"

#: ui/src/bridge.rs:381
msgid "Opening the browser…"
msgstr "Browser wird geöffnet…"

#: ui/src/bridge.rs:387
msgid "Signing out…"
msgstr "Abmeldung läuft…"

#: ui/src/bridge.rs:413
msgid "Cannot read the log: {reason}"
msgstr "Das Protokoll kann nicht gelesen werden: {reason}"

#: ui/src/bridge.rs:423 ui/src/bridge.rs:451 ui/src/bridge.rs:467
#: ui/src/bridge.rs:480 ui/src/bridge.rs:498
msgid "Cannot save the setting: {reason}"
msgstr "Die Einstellung kann nicht gespeichert werden: {reason}"

#: ui/src/bridge.rs:431
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos wird mit der nächsten Synchronisierung heruntergeladen"

#: ui/src/bridge.rs:432
msgid "Proton Photos will be left alone"
msgstr "Proton Photos wird nicht synchronisiert"

#: ui/src/bridge.rs:457
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr ""

#: ui/src/bridge.rs:458
msgid "No longer uploading photos"
msgstr ""

#: ui/src/bridge.rs:485
msgid "Storing everything from now on"
msgstr "Ab jetzt wird alles gespeichert"

#: ui/src/bridge.rs:486
msgid "Storing warnings and errors from now on"
msgstr "Ab jetzt werden Warnungen und Fehler gespeichert"

#: ui/src/bridge.rs:487
msgid "Storing errors from now on"
msgstr "Ab jetzt werden Fehler gespeichert"

#: ui/src/bridge.rs:503
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "{n} Protokolldatei entfernt, die älter als {days} Tage war"
msgstr[1] "{n} Protokolldateien entfernt, die älter als {days} Tage waren"

#: ui/src/bridge.rs:504
msgid "Cannot prune the log: {reason}"
msgstr "Das Protokoll kann nicht bereinigt werden: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "Proton Drive-Ordner auswählen"

#: ui/qml/main.qml:34
msgid "Choose the folder to upload photos from"
msgstr ""

#: ui/qml/main.qml:45
msgid "The folder is not empty"
msgstr "Der Ordner ist nicht leer"

#: ui/qml/main.qml:80
msgid "Opened {what}"
msgstr "{what} geöffnet"

#: ui/qml/main.qml:82
msgid "Could not open {what} ({url})"
msgstr "{what} konnte nicht geöffnet werden ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:138
msgid "Account"
msgstr "Konto"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:140
msgid "Logs"
msgstr "Protokoll"

#: ui/qml/main.qml:177
msgid "Not signed in"
msgstr "Nicht angemeldet"

#: ui/qml/main.qml:184
msgid "Signed in to Proton Drive"
msgstr "Bei Proton Drive angemeldet"

#: ui/qml/main.qml:185
msgid "Sign in to sync this computer with Proton Drive."
msgstr ""
"Melden Sie sich an, um diesen Rechner mit Proton Drive zu synchronisieren."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:206
msgid "Storage"
msgstr "Speicherplatz"

#: ui/qml/main.qml:234
msgid "{used} of {total} used"
msgstr "{used} von {total} belegt"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:246
msgid "Syncing to"
msgstr "Sync-Ordner"

#: ui/qml/main.qml:250
msgid "nowhere yet"
msgstr "noch keiner"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:257 ui/qml/main.qml:324
msgid "Change…"
msgstr "Ändern…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:264
msgid "Ignore file…"
msgstr "Ignorierdatei…"

#: ui/qml/main.qml:276

#: src/daemon.rs:112
msgid "Signed out. Sign in from the account window."
msgstr "Abgemeldet. Melden Sie sich im Kontofenster an."

#: src/daemon.rs:114 src/daemon.rs:401
msgid "Syncing…"
msgstr "Wird synchronisiert…"

#: src/daemon.rs:116 src/daemon.rs:404
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} Element synchron"
msgstr[1] "{n} Elemente synchron"

#: src/daemon.rs:126 ui/qml/main.qml:409
msgid "Open folder"
msgstr "Ordner öffnen"

#: src/daemon.rs:136
msgid "Account and logs…"
msgstr "Konto und Protokoll…"

#: src/daemon.rs:143 ui/qml/main.qml:396
msgid "Sync now"
msgstr "Jetzt synchronisieren"

#: src/daemon.rs:155
msgid "Pause sync"
msgstr "Synchronisierung pausieren"

#: src/daemon.rs:168
msgid "Quit"
msgstr "Beenden"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:328
msgid "{reason}; retrying"
msgstr "{reason}; neuer Versuch"

#: src/daemon.rs:339
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive ist wieder erreichbar, nach {duration}"

#: src/daemon.rs:350
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} Sekunde"
msgstr[1] "{n} Sekunden"

#: src/daemon.rs:351
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} Minute"
msgstr[1] "{n} Minuten"

#: src/daemon.rs:352
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} Stunde"
msgstr[1] "{n} Stunden"

#: src/daemon.rs:382
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "Der Sync-Dienst läuft nicht. Starten Sie ihn mit: kpdrive sync --watch"

#: src/daemon.rs:385
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Ein Sync-Dienst läuft, ist aber zu alt, um seinen Status zu melden. Starten "
"Sie ihn neu."

#: src/daemon.rs:391
msgid "Signed out. Syncing resumes once you sign in."
msgstr ""
"Abgemeldet. Die Synchronisierung wird fortgesetzt, sobald Sie sich anmelden."

#: src/daemon.rs:395
msgid "{reason}. Still trying."
msgstr "{reason}. Der Versuch läuft weiter."

#: src/daemon.rs:396
msgid "Last sync failed: {reason}"
msgstr "Letzte Synchronisierung fehlgeschlagen: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:410
msgid "just now"
msgstr "gerade eben"

#: src/daemon.rs:412
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "vor {n} Minute"
msgstr[1] "vor {n} Minuten"

#: src/daemon.rs:415
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "vor {n} Stunde"
msgstr[1] "vor {n} Stunden"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:419
msgid "{items}, checked {ago}"
msgstr "{items}, geprüft {ago}"

#: src/daemon.rs:637
msgid "Signed in again. Syncing resumed."
msgstr "Wieder angemeldet. Die Synchronisierung wurde fortgesetzt."

#: src/daemon.rs:712
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Abgemeldet. Melden Sie sich im Kontofenster an, um die Synchronisierung "
"fortzusetzen."

#: src/daemon.rs:745
msgid "Sync resumed"
msgstr "Synchronisierung fortgesetzt"

#: src/daemon.rs:762
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} Foto heruntergeladen"
msgstr[1] "{n} Fotos heruntergeladen"

#: src/daemon.rs:783
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} Foto zu Proton Photos hochgeladen"
msgstr[1] "{n} Fotos zu Proton Photos hochgeladen"

#: src/i18n.rs:155 ui/qml/main.qml:334
msgid "Sign out"
msgstr "Abmelden"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} Foto"
msgstr[1] "{n} Fotos"

#: src/pause.rs:20
msgid "Paused"
msgstr "Pausiert"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "Pausiert im Netzbetrieb"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "Pausiert im Akkubetrieb"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "Pausiert bei niedrigem Akkustand"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "Pausiert, solange mit {network} verbunden"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Hinein synchronisieren und Vorhandenes behalten"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Beiseite verschieben und mit leerem Ordner beginnen"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"{folder} enthält bereits {n} Element, das beim Synchronisieren mit Proton "
"Drive zusammengeführt wird."
msgstr[1] ""
"{folder} enthält bereits {n} Elemente, die beim Synchronisieren mit Proton "
"Drive zusammengeführt werden."

#: ui/src/bridge.rs:237
msgid "Starting…"
msgstr "Wird gestartet…"

#: ui/src/bridge.rs:288
msgid "Confirm the code {code} in your browser"
msgstr "Bestätigen Sie den Code {code} in Ihrem Browser"

#: ui/src/bridge.rs:302
msgid "Sign-in failed: {reason}"
msgstr "Anmeldung fehlgeschlagen: {reason}"

#: ui/src/bridge.rs:314
msgid "Signed out"
msgstr "Abgemeldet"

#: ui/src/bridge.rs:317
msgid "Sign-out failed: {reason}"
msgstr "Abmeldung fehlgeschlagen: {reason}"

#: ui/src/bridge.rs:382
msgid "{note}. Restart the sync daemon to use it."
msgstr ""
"{note}. Starten Sie den Sync-Dienst neu, damit die Änderung wirksam wird."

#: ui/src/bridge.rs:385
msgid "Cannot change the folder: {reason}"
msgstr "Der Ordner kann nicht geändert werden: {reason}"

#: ui/src/bridge.rs:392
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Noch kein Sync-Ordner. Führen Sie aus: kpdrive setup"

#: ui/src/bridge.rs:396
msgid "Cannot create the ignore file: {reason}"
msgstr "Die Ignorierdatei kann nicht erstellt werden: {reason}"

#: ui/src/bridge.rs:434
msgid "Checking the account…"
msgstr "Konto wird geprüft…"

#: ui/src/bridge.rs:440
msgid "Opening the browser…"
msgstr "Browser wird geöffnet…"

#: ui/src/bridge.rs:446
msgid "Signing out…"
msgstr "Abmeldung läuft…"

#: ui/src/bridge.rs:472
msgid "Cannot read the log: {reason}"
msgstr "Das Protokoll kann nicht gelesen werden: {reason}"

#: ui/src/bridge.rs:482 ui/src/bridge.rs:510 ui/src/bridge.rs:524
#: ui/src/bridge.rs:539 ui/src/bridge.rs:573 ui/src/bridge.rs:614
#: ui/src/bridge.rs:627 ui/src/bridge.rs:645
msgid "Cannot save the setting: {reason}"
msgstr "Die Einstellung kann nicht gespeichert werden: {reason}"

#: ui/src/bridge.rs:490
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos wird mit der nächsten Synchronisierung heruntergeladen"

#: ui/src/bridge.rs:491
msgid "Proton Photos will be left alone"
msgstr "Proton Photos wird nicht synchronisiert"

#: ui/src/bridge.rs:516
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr "In diesen Ordner gelegte Fotos werden zu Proton Photos hochgeladen"

#: ui/src/bridge.rs:517
msgid "No longer uploading photos"
msgstr "Fotos werden nicht mehr hochgeladen"

#: ui/src/bridge.rs:607
msgid "Photos will be downloaded into that folder from the next pass"
msgstr ""
"Fotos werden ab dem nächsten Durchlauf in diesen Ordner heruntergeladen"

#: ui/src/bridge.rs:632
msgid "Storing everything from now on"
msgstr "Ab jetzt wird alles gespeichert"

#: ui/src/bridge.rs:633
msgid "Storing warnings and errors from now on"
msgstr "Ab jetzt werden Warnungen und Fehler gespeichert"

#: ui/src/bridge.rs:634
msgid "Storing errors from now on"
msgstr "Ab jetzt werden Fehler gespeichert"

#: ui/src/bridge.rs:650
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "{n} Protokolldatei entfernt, die älter als {days} Tage war"
msgstr[1] "{n} Protokolldateien entfernt, die älter als {days} Tage waren"

#: ui/src/bridge.rs:651
msgid "Cannot prune the log: {reason}"
msgstr "Das Protokoll kann nicht bereinigt werden: {reason}"

#: ui/qml/main.qml:28
msgid "Choose the Proton Drive folder"
msgstr "Proton Drive-Ordner auswählen"

#: ui/qml/main.qml:35
msgid "Choose where Proton Photos are downloaded"
msgstr "Speicherort für Proton Photos auswählen"

#: ui/qml/main.qml:42
msgid "Choose the folder to upload photos from"
msgstr "Ordner auswählen, aus dem Fotos hochgeladen werden"

#: ui/qml/main.qml:53
msgid "The folder is not empty"
msgstr "Der Ordner ist nicht leer"

#: ui/qml/main.qml:104
msgid "Opened {what}"
msgstr "{what} geöffnet"

#: ui/qml/main.qml:106
msgid "Could not open {what} ({url})"
msgstr "{what} konnte nicht geöffnet werden ({url})"

#: ui/qml/main.qml:186
msgid "Account & activity"
msgstr "Konto & Aktivität"

#: ui/qml/main.qml:187
msgid "Settings"
msgstr "Einstellungen"

#: ui/qml/main.qml:188 ui/qml/main.qml:633
msgid "Logs"
msgstr "Protokoll"

#: ui/qml/main.qml:189
msgid "About"
msgstr "Über"

#: ui/qml/main.qml:269
msgid "Not signed in"
msgstr "Nicht angemeldet"

#: ui/qml/main.qml:276
msgid "Signed in to Proton Drive"
msgstr "Bei Proton Drive angemeldet"

#: ui/qml/main.qml:277
msgid "Sign in to sync this computer with Proton Drive."
msgstr ""
"Melden Sie sich an, um diesen Rechner mit Proton Drive zu synchronisieren."

#: ui/qml/main.qml:294
msgid "Storage:"
msgstr "Speicherplatz:"

#: ui/qml/main.qml:323
msgid "{used} of {total} used"
msgstr "{used} von {total} belegt"

#: ui/qml/main.qml:331
msgid "Account:"
msgstr "Konto:"

#: ui/qml/main.qml:334
msgid "Sign in"
msgstr "Anmelden"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:341
msgid "Refresh"
msgstr "Aktualisieren"

#: ui/qml/main.qml:350
msgid "On the web:"
msgstr "Im Web:"

#: ui/qml/main.qml:353
msgid "Drive on the web"
msgstr "Drive im Web"

#: ui/qml/main.qml:358
msgid "Proton account"
msgstr "Proton-Konto"

#: ui/qml/main.qml:366
msgid "Activity"
msgstr "Aktivität"

#: ui/qml/main.qml:373
msgid "Sync:"
msgstr "Synchronisierung:"

#: ui/qml/main.qml:404
msgid "Resume"
msgstr "Fortsetzen"

#: ui/qml/main.qml:404
msgid "Pause"
msgstr "Pausieren"

#: ui/qml/main.qml:429
msgid "Files"
msgstr "Dateien"

#: ui/qml/main.qml:433
msgid "Sync folder:"
msgstr "Sync-Ordner:"

#: ui/qml/main.qml:437
msgid "nowhere yet"
msgstr "noch keiner"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:443 ui/qml/main.qml:490 ui/qml/main.qml:533
msgid "Change…"
msgstr "Ändern…"

#: ui/qml/main.qml:450
msgid "Ignored paths:"
msgstr "Ignorierte Pfade:"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves
#. alone
#: ui/qml/main.qml:452
msgid "Ignore file…"
msgstr "Ignorierdatei…"

#: ui/qml/main.qml:459
msgid "Photos"
msgstr "Fotos"

#: ui/qml/main.qml:463
msgid "Download:"
msgstr "Herunterladen:"

#: ui/qml/main.qml:467
msgid "Also download Proton Photos"
msgstr "Proton Photos ebenfalls herunterladen"

#: ui/qml/main.qml:473
msgid ""
"Your timeline is copied here every half hour. Nothing in Proton Photos is "
"changed or deleted by it."
msgstr ""
"Ihre Zeitleiste wird jede halbe Stunde hierher kopiert. In Proton Photos "
"wird dabei nichts geändert oder gelöscht."

#: ui/qml/main.qml:481
msgid "Download folder:"
msgstr "Download-Ordner:"

#: ui/qml/main.qml:485
msgid "your Pictures folder"
msgstr "Ihr Ordner „Bilder“"

#: ui/qml/main.qml:497
msgid "Upload:"
msgstr "Hochladen:"

#: ui/qml/main.qml:501
msgid "Upload photos from a folder"
msgstr "Fotos aus einem Ordner hochladen"

#: ui/qml/main.qml:515
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""
"Fotos und Videos in diesem Ordner werden innerhalb einer Minute zu Proton "
"Photos hochgeladen und verlassen dann den Ordner. Was nicht hochgeladen "
"werden kann, bleibt liegen."

#: ui/qml/main.qml:523
msgid "Upload folder:"
msgstr "Upload-Ordner:"

#: ui/qml/main.qml:540
msgid "After upload:"
msgstr "Nach dem Hochladen:"

#: ui/qml/main.qml:542
msgid "Delete instead of moving to the trash"
msgstr "Löschen statt in den Papierkorb verschieben"

#: ui/qml/main.qml:549
msgid "Network"
msgstr "Netzwerk"

#: ui/qml/main.qml:553 ui/qml/main.qml:598
msgid "Pause while on:"
msgstr "Pausieren bei:"

#: ui/qml/main.qml:573
msgid "{network} (connected)"
msgstr "{network} (verbunden)"

#: ui/qml/main.qml:584
msgid ""
"Syncing pauses while any ticked network is connected, such as a phone's "
"hotspot. A sync already under way finishes first."
msgstr ""
"Die Synchronisierung pausiert, solange ein angehaktes Netzwerk verbunden "
"ist, etwa der Hotspot eines Telefons. Eine bereits laufende Synchronisierung "
"wird zuerst abgeschlossen."

#: ui/qml/main.qml:585
msgid "NetworkManager lists no networks to choose from."
msgstr "NetworkManager listet keine Netzwerke zur Auswahl auf."

#: ui/qml/main.qml:594
msgid "Power"
msgstr "Energie"

#: ui/qml/main.qml:604
msgid "AC power"
msgstr "Netzbetrieb"

#: ui/qml/main.qml:605
msgid "Battery"
msgstr "Akkubetrieb"

#: ui/qml/main.qml:606
msgid "Low battery"
msgstr "Niedriger Akkustand"

#: ui/qml/main.qml:614
msgid "{power} (now)"
msgstr "{power} (aktuell)"

#: ui/qml/main.qml:624
msgid ""
"Low battery is the level set in the system's power management settings. A "
"sync already under way finishes first."
msgstr ""
"Niedriger Akkustand ist der Wert aus den Energieverwaltungseinstellungen des "
"Systems. Eine bereits laufende Synchronisierung wird zuerst abgeschlossen."

#: ui/qml/main.qml:637
msgid "Keep logs for:"
msgstr "Protokoll aufbewahren für:"

#. TRANSLATORS: after the number in "Keep logs for: [30] days"
#: ui/qml/main.qml:646
msgid "days"
msgstr "Tage"

#. TRANSLATORS: label before a dropdown choosing which log levels are written
#. to disk
#: ui/qml/main.qml:651
msgid "Store:"
msgstr "Speichern:"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:656
msgid "Warnings and errors"
msgstr "Warnungen und Fehler"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:658
msgid "Everything"
msgstr "Alles"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:660
msgid "Errors only"
msgstr "Nur Fehler"

#: ui/qml/main.qml:681
msgid "Search the log"
msgstr "Protokoll durchsuchen"

#: ui/qml/main.qml:686
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} Zeile"
msgstr[1] "{n} Zeilen"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:736
msgid "Copy"
msgstr "Kopieren"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:742
msgid "Select all"
msgstr "Alles auswählen"

#: ui/qml/main.qml:759
msgid "No lines match"
msgstr "Keine Treffer"

#: ui/qml/main.qml:759
msgid "Nothing logged yet"
msgstr "Noch nichts protokolliert"

#: ui/qml/main.qml:761
msgid "No line since the sync daemon started contains “{term}”."
msgstr "Seit dem Start des Sync-Dienstes enthält keine Zeile „{term}“."

#: ui/qml/main.qml:762
msgid "This shows what has happened since the sync daemon started."
msgstr "Hier sehen Sie, was seit dem Start des Sync-Dienstes geschehen ist."

#: ui/qml/main.qml:794
msgid "Proton Drive sync client for KDE Plasma"
msgstr "Proton Drive-Sync-Client für KDE Plasma"


#: src/daemon.rs:67 src/daemon.rs:174
msgid "Signed out. Sign in from the account window."
msgstr "Abgemeldet. Melden Sie sich im Kontofenster an."

#: src/daemon.rs:69 src/daemon.rs:535
msgid "Syncing…"
msgstr "Wird synchronisiert…"

#: src/daemon.rs:71 src/daemon.rs:538
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} Element synchron"
msgstr[1] "{n} Elemente synchron"

#: src/daemon.rs:199 src/daemon.rs:201 ui/qml/main.qml:469
msgid "Open folder"
msgstr "Ordner öffnen"

#: src/daemon.rs:211
msgid "Account and logs…"
msgstr "Konto und Protokoll…"

#: src/daemon.rs:218 ui/qml/main.qml:456
msgid "Sync now"
msgstr "Jetzt synchronisieren"

#: src/daemon.rs:230
msgid "Pause sync"
msgstr "Synchronisierung pausieren"

#: src/daemon.rs:243
msgid "Quit"
msgstr "Beenden"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:430
msgid "{reason}; retrying"
msgstr "{reason}; neuer Versuch"

#: src/daemon.rs:441
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive ist wieder erreichbar, nach {duration}"

#: src/daemon.rs:452
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} Sekunde"
msgstr[1] "{n} Sekunden"

#: src/daemon.rs:453
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} Minute"
msgstr[1] "{n} Minuten"

#: src/daemon.rs:454
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} Stunde"
msgstr[1] "{n} Stunden"

#: src/daemon.rs:502
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "Der Sync-Dienst läuft nicht. Starten Sie ihn mit: kpdrive sync --watch"

#: src/daemon.rs:505
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Ein Sync-Dienst läuft, ist aber zu alt, um seinen Status zu melden. Starten "
"Sie ihn neu."

#: src/daemon.rs:516 src/daemon.rs:525
msgid "Signed out. Syncing resumes once you sign in."
msgstr ""
"Abgemeldet. Die Synchronisierung wird fortgesetzt, sobald Sie sich anmelden."

#: src/daemon.rs:529
msgid "{reason}. Still trying."
msgstr "{reason}. Der Versuch läuft weiter."

#: src/daemon.rs:530
msgid "Last sync failed: {reason}"
msgstr "Letzte Synchronisierung fehlgeschlagen: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:544
msgid "just now"
msgstr "gerade eben"

#: src/daemon.rs:546
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "vor {n} Minute"
msgstr[1] "vor {n} Minuten"

#: src/daemon.rs:549
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "vor {n} Stunde"
msgstr[1] "vor {n} Stunden"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:553
msgid "{items}, checked {ago}"
msgstr "{items}, geprüft {ago}"

#: src/daemon.rs:924
msgid "Signed in again. Syncing resumed."
msgstr "Wieder angemeldet. Die Synchronisierung wurde fortgesetzt."

#: src/daemon.rs:938
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Abgemeldet. Melden Sie sich im Kontofenster an, um die Synchronisierung "
"fortzusetzen."

#: src/daemon.rs:1050
msgid "Sync resumed"
msgstr "Synchronisierung fortgesetzt"

#: src/daemon.rs:1067
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} Foto heruntergeladen"
msgstr[1] "{n} Fotos heruntergeladen"

#: src/daemon.rs:1086
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} Foto zu Proton Photos hochgeladen"
msgstr[1] "{n} Fotos zu Proton Photos hochgeladen"

#: src/i18n.rs:155 ui/qml/main.qml:387
msgid "Sign out"
msgstr "Abmelden"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} Foto"
msgstr[1] "{n} Fotos"

#: src/pause.rs:20
msgid "Paused"
msgstr "Pausiert"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "Pausiert im Netzbetrieb"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "Pausiert im Akkubetrieb"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "Pausiert bei niedrigem Akkustand"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "Pausiert, solange mit {network} verbunden"

#: src/sync.rs:124
msgid "Sync into it and keep what is already there"
msgstr "Hinein synchronisieren und Vorhandenes behalten"

#: src/sync.rs:125
msgid "Move it aside and start from an empty folder"
msgstr "Beiseite verschieben und mit leerem Ordner beginnen"

#: src/sync.rs:163
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"{folder} enthält bereits {n} Element, das beim Synchronisieren mit Proton "
"Drive zusammengeführt wird."
msgstr[1] ""
"{folder} enthält bereits {n} Elemente, die beim Synchronisieren mit Proton "
"Drive zusammengeführt werden."

#: ui/src/bridge.rs:260
msgid "Starting…"
msgstr "Wird gestartet…"

#: ui/src/bridge.rs:317
msgid "Confirm the code {code} in your browser"
msgstr "Bestätigen Sie den Code {code} in Ihrem Browser"

#: ui/src/bridge.rs:331
msgid "Sign-in failed: {reason}"
msgstr "Anmeldung fehlgeschlagen: {reason}"

#: ui/src/bridge.rs:344
msgid "Signed out"
msgstr "Abgemeldet"

#: ui/src/bridge.rs:347
msgid "Sign-out failed: {reason}"
msgstr "Abmeldung fehlgeschlagen: {reason}"

#: ui/src/bridge.rs:355
msgid "Removed {account}. Its files were left where they are."
msgstr ""
"{account} wurde entfernt. Die zugehörigen Dateien bleiben, wo sie sind."

#: ui/src/bridge.rs:362
msgid "Cannot remove the account: {reason}"
msgstr "Das Konto kann nicht entfernt werden: {reason}"

#: ui/src/bridge.rs:481
msgid "Cannot change the folder: {reason}"
msgstr "Der Ordner kann nicht geändert werden: {reason}"


msgid "{reason}; retrying"
msgstr "{reason}; पुनः प्रयास जारी"

#: src/daemon.rs:441
msgid "Proton Drive is reachable again, after {duration}"
msgstr "{duration} के बाद Proton Drive फिर से उपलब्ध है"

#: src/daemon.rs:452
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} सेकंड"
msgstr[1] "{n} सेकंड"

#: src/daemon.rs:453
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} मिनट"
msgstr[1] "{n} मिनट"

#: src/daemon.rs:454
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} घंटा"
msgstr[1] "{n} घंटे"

#: src/daemon.rs:502
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "सिंक सेवा नहीं चल रही है। इसे इस तरह शुरू करें: kpdrive sync --watch"

#: src/daemon.rs:505
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"सिंक सेवा चल रही है, पर वह इतनी पुरानी है कि अपनी स्थिति नहीं बता सकती। इसे पुनः आरंभ "
"करें।"

#: src/daemon.rs:516 src/daemon.rs:525
msgid "Signed out. Syncing resumes once you sign in."
msgstr "साइन आउट हो गया। साइन इन करते ही सिंक फिर से शुरू हो जाएगा।"

#: src/daemon.rs:529
msgid "{reason}. Still trying."
msgstr "{reason}। प्रयास अब भी जारी है।"

#: src/daemon.rs:530
msgid "Last sync failed: {reason}"
msgstr "पिछला सिंक विफल रहा: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:544
msgid "just now"
msgstr "अभी-अभी"

#: src/daemon.rs:546
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} मिनट पहले"
msgstr[1] "{n} मिनट पहले"

#: src/daemon.rs:549
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} घंटा पहले"
msgstr[1] "{n} घंटे पहले"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:553
msgid "{items}, checked {ago}"
msgstr "{items}, {ago} जाँचा गया"

#: src/daemon.rs:924
msgid "Signed in again. Syncing resumed."
msgstr "फिर से साइन इन हो गया। सिंक फिर से शुरू हुआ।"

#: src/daemon.rs:938
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "साइन आउट हो गया। सिंक फिर से शुरू करने के लिए खाता विंडो से साइन इन करें।"

#: src/daemon.rs:1050
msgid "Sync resumed"
msgstr "सिंक फिर से शुरू हुआ"

#: src/daemon.rs:1067
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} फ़ोटो डाउनलोड हुई"
msgstr[1] "{n} फ़ोटो डाउनलोड हुईं"

#: src/daemon.rs:1086
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} फ़ोटो Proton Photos पर अपलोड हुई"
msgstr[1] "{n} फ़ोटो Proton Photos पर अपलोड हुईं"

#: src/i18n.rs:155 ui/qml/main.qml:387
msgid "Sign out"
msgstr "साइन आउट"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} फ़ोटो"
msgstr[1] "{n} फ़ोटो"

#: src/pause.rs:20
msgid "Paused"
msgstr "रुका हुआ"


msgid "Paused while connected to {network}"
msgstr "{network} से जुड़े रहने तक रुका हुआ"

#: src/sync.rs:124
msgid "Sync into it and keep what is already there"
msgstr "इसी में सिंक करें और जो पहले से है उसे रखें"

#: src/sync.rs:125
msgid "Move it aside and start from an empty folder"
msgstr "इसे किनारे हटाकर खाली फ़ोल्डर से शुरू करें"

#: src/sync.rs:163
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] "{folder} में पहले से {n} आइटम है, जिसे सिंक Proton Drive के साथ मिला देगा।"
msgstr[1] "{folder} में पहले से {n} आइटम हैं, जिन्हें सिंक Proton Drive के साथ मिला देगा।"


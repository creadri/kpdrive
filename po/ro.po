#: src/daemon.rs:112
msgid "Signed out. Sign in from the account window."
msgstr "V-ați deautentificat. Autentificați-vă din fereastra contului."

#: src/daemon.rs:114 src/daemon.rs:401
msgid "Syncing…"
msgstr "Se sincronizează…"

#: src/daemon.rs:116 src/daemon.rs:404
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} element sincronizat"
msgstr[1] "{n} elemente sincronizate"
msgstr[2] "{n} de elemente sincronizate"

#: src/daemon.rs:126 ui/qml/main.qml:409
msgid "Open folder"
msgstr "Deschide dosarul"

#: src/daemon.rs:136
msgid "Account and logs…"
msgstr "Cont și jurnale…"

#: src/daemon.rs:143 ui/qml/main.qml:396
msgid "Sync now"
msgstr "Sincronizează acum"

#: src/daemon.rs:155
msgid "Pause sync"
msgstr "Întrerupe sincronizarea"

#: src/daemon.rs:168
msgid "Quit"
msgstr "Ieșire"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:328
msgid "{reason}; retrying"
msgstr "{reason}; se reîncearcă"

#: src/daemon.rs:339
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive este din nou accesibil, după {duration}"

#: src/daemon.rs:350
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} secundă"
msgstr[1] "{n} secunde"
msgstr[2] "{n} de secunde"

#: src/daemon.rs:351
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minut"
msgstr[1] "{n} minute"
msgstr[2] "{n} de minute"

#: src/daemon.rs:352
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} oră"
msgstr[1] "{n} ore"
msgstr[2] "{n} de ore"

#: src/daemon.rs:382
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"Serviciul de sincronizare nu rulează. Porniți-l cu: kpdrive sync --watch"

#: src/daemon.rs:385
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Un serviciu de sincronizare rulează, dar este prea vechi pentru a spune ce "
"face. Reporniți-l."

#: src/daemon.rs:391
msgid "Signed out. Syncing resumes once you sign in."
msgstr "V-ați deautentificat. Sincronizarea se reia după autentificare."

#: src/daemon.rs:395
msgid "{reason}. Still trying."
msgstr "{reason}. Se încearcă în continuare."

#: src/daemon.rs:396
msgid "Last sync failed: {reason}"
msgstr "Ultima sincronizare a eșuat: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:410
msgid "just now"
msgstr "chiar acum"

#: src/daemon.rs:412
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "acum {n} minut"
msgstr[1] "acum {n} minute"
msgstr[2] "acum {n} de minute"

#: src/daemon.rs:415
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "acum {n} oră"
msgstr[1] "acum {n} ore"
msgstr[2] "acum {n} de ore"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:419
msgid "{items}, checked {ago}"
msgstr "{items}, ultima verificare {ago}"

#: src/daemon.rs:637
msgid "Signed in again. Syncing resumed."
msgstr "V-ați autentificat din nou. Sincronizarea a fost reluată."

#: src/daemon.rs:712
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"V-ați deautentificat. Autentificați-vă din fereastra contului pentru a relua "
"sincronizarea."

#: src/daemon.rs:745
msgid "Sync resumed"
msgstr "Sincronizare reluată"

#: src/daemon.rs:762
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} fotografie descărcată"
msgstr[1] "{n} fotografii descărcate"
msgstr[2] "{n} de fotografii descărcate"

#: src/daemon.rs:783
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} fotografie încărcată în Proton Photos"
msgstr[1] "{n} fotografii încărcate în Proton Photos"
msgstr[2] "{n} de fotografii încărcate în Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:334
msgid "Sign out"
msgstr "Deautentificare"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} fotografie"
msgstr[1] "{n} fotografii"
msgstr[2] "{n} de fotografii"

#: src/pause.rs:20
msgid "Paused"
msgstr "Întreruptă"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "Întreruptă cât timp este alimentat de la rețea"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "Întreruptă cât timp funcționează pe baterie"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "Întreruptă cât timp bateria este descărcată"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "Întreruptă cât timp este conectat la {network}"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Sincronizează în el și păstrează ce există deja"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Mută-l deoparte și începe cu un dosar gol"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"Dosarul {folder} conține deja {n} element, pe care sincronizarea îl va "
"îmbina cu Proton Drive."
msgstr[1] ""
"Dosarul {folder} conține deja {n} elemente, pe care sincronizarea le va "
"îmbina cu Proton Drive."
msgstr[2] ""
"Dosarul {folder} conține deja {n} de elemente, pe care sincronizarea le va "
"îmbina cu Proton Drive."

#: ui/src/bridge.rs:237
msgid "Starting…"
msgstr "Se pornește…"

#: ui/src/bridge.rs:288
msgid "Confirm the code {code} in your browser"
msgstr "Confirmați codul {code} în navigator"

#: ui/src/bridge.rs:302
msgid "Sign-in failed: {reason}"
msgstr "Autentificarea a eșuat: {reason}"

#: ui/src/bridge.rs:314

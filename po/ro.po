msgid "{reason}. Still trying."
msgstr "{reason}. Se încearcă în continuare."

#: src/daemon.rs:530
msgid "Last sync failed: {reason}"
msgstr "Ultima sincronizare a eșuat: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:544
msgid "just now"
msgstr "chiar acum"

#: src/daemon.rs:546
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"

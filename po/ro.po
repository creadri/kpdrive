msgid "{network} (connected)"
msgstr "{network} (conectată)"

#: ui/qml/main.qml:584
msgid ""
"Syncing pauses while any ticked network is connected, such as a phone's "
"hotspot. A sync already under way finishes first."
msgstr ""
"Sincronizarea se întrerupe cât timp este conectată oricare dintre rețelele "
"bifate, de exemplu hotspotul unui telefon. O sincronizare deja în curs se "
"termină mai întâi."

#: ui/qml/main.qml:585
msgid "NetworkManager lists no networks to choose from."
msgstr "NetworkManager nu listează nicio rețea din care să alegeți."

#: ui/qml/main.qml:594
msgid "Power"
msgstr "Alimentare"

#: ui/qml/main.qml:604

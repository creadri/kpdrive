#: src/daemon.rs:98
msgid "Signed out. Sign in from the account window."
msgstr "V-ați deautentificat. Autentificați-vă din fereastra contului."

#: src/daemon.rs:100 src/daemon.rs:341
msgid "Syncing…"
msgstr "Se sincronizează…"

#: src/daemon.rs:102 src/daemon.rs:344
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} element sincronizat"
msgstr[1] "{n} elemente sincronizate"
msgstr[2] "{n} de elemente sincronizate"

#: src/daemon.rs:112 ui/qml/main.qml:313
msgid "Open folder"
msgstr "Deschide dosarul"

#: src/daemon.rs:122
msgid "Account and logs…"
msgstr "Cont și jurnale…"

#: src/daemon.rs:129 ui/qml/main.qml:291
msgid "Sync now"
msgstr "Sincronizează acum"

#: src/daemon.rs:139
msgid "Quit"
msgstr "Ieșire"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:273
msgid "{reason}; retrying"
msgstr "{reason}; se reîncearcă"

#: src/daemon.rs:284
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive este din nou accesibil, după {duration}"

#: src/daemon.rs:295
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} secundă"
msgstr[1] "{n} secunde"
msgstr[2] "{n} de secunde"

#: src/daemon.rs:296
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minut"
msgstr[1] "{n} minute"
msgstr[2] "{n} de minute"

#: src/daemon.rs:297
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} oră"
msgstr[1] "{n} ore"
msgstr[2] "{n} de ore"

#: src/daemon.rs:325
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "Serviciul de sincronizare nu rulează. Porniți-l cu: kpdrive sync --watch"

#: src/daemon.rs:328
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr "Un serviciu de sincronizare rulează, dar este prea vechi pentru a spune ce face. Reporniți-l."

#: src/daemon.rs:331
msgid "Signed out. Syncing resumes once you sign in."
msgstr "V-ați deautentificat. Sincronizarea se reia după autentificare."

#: src/daemon.rs:335
msgid "{reason}. Still trying."
msgstr "{reason}. Se încearcă în continuare."

#: src/daemon.rs:336
msgid "Last sync failed: {reason}"
msgstr "Ultima sincronizare a eșuat: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:350
msgid "just now"
msgstr "chiar acum"

#: src/daemon.rs:352
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "acum {n} minut"
msgstr[1] "acum {n} minute"
msgstr[2] "acum {n} de minute"

#: src/daemon.rs:355
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "acum {n} oră"
msgstr[1] "acum {n} ore"
msgstr[2] "acum {n} de ore"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:359
msgid "{items}, checked {ago}"
msgstr "{items}, ultima verificare {ago}"

#: src/daemon.rs:576
msgid "Signed in again. Syncing resumed."
msgstr "V-ați autentificat din nou. Sincronizarea a fost reluată."

#: src/daemon.rs:630
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "V-ați deautentificat. Autentificați-vă din fereastra contului pentru a relua sincronizarea."

#: src/daemon.rs:663
msgid "Sync resumed"
msgstr "Sincronizare reluată"

#: src/daemon.rs:680
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} fotografie descărcată"
msgstr[1] "{n} fotografii descărcate"
msgstr[2] "{n} de fotografii descărcate"

#: src/i18n.rs:111 ui/qml/main.qml:336
msgid "Sign out"
msgstr "Deautentificare"

#: src/i18n.rs:112 src/i18n.rs:113
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} fotografie"
msgstr[1] "{n} fotografii"
msgstr[2] "{n} de fotografii"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Sincronizează în el și păstrează ce există deja"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Mută-l deoparte și începe cu un dosar gol"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] "Dosarul {folder} conține deja {n} element, pe care sincronizarea îl va îmbina cu Proton Drive."
msgstr[1] "Dosarul {folder} conține deja {n} elemente, pe care sincronizarea le va îmbina cu Proton Drive."
msgstr[2] "Dosarul {folder} conține deja {n} de elemente, pe care sincronizarea le va îmbina cu Proton Drive."

#: ui/src/bridge.rs:175
msgid "Starting…"
msgstr "Se pornește…"

#: ui/src/bridge.rs:217
msgid "Confirm the code {code} in your browser"
msgstr "Confirmați codul {code} în navigator"

#: ui/src/bridge.rs:231
msgid "Sign-in failed: {reason}"
msgstr "Autentificarea a eșuat: {reason}"

#: ui/src/bridge.rs:243
msgid "Signed out"
msgstr "Deautentificat"

#: ui/src/bridge.rs:246
msgid "Sign-out failed: {reason}"
msgstr "Deautentificarea a eșuat: {reason}"

#: ui/src/bridge.rs:305
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Reporniți serviciul de sincronizare pentru a-l folosi."

#: ui/src/bridge.rs:308
msgid "Cannot change the folder: {reason}"
msgstr "Nu se poate schimba dosarul: {reason}"

#: ui/src/bridge.rs:315
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Încă nu există un dosar de sincronizare. Rulați: kpdrive setup"

#: ui/src/bridge.rs:319
msgid "Cannot create the ignore file: {reason}"
msgstr "Nu se poate crea fișierul de ignorare: {reason}"

#: ui/src/bridge.rs:356
msgid "Checking the account…"
msgstr "Se verifică contul…"

#: ui/src/bridge.rs:362
msgid "Opening the browser…"
msgstr "Se deschide navigatorul…"

#: ui/src/bridge.rs:368
msgid "Signing out…"
msgstr "Se deautentifică…"

#: ui/src/bridge.rs:394
msgid "Cannot read the log: {reason}"
msgstr "Nu se poate citi jurnalul: {reason}"

#: ui/src/bridge.rs:404 ui/src/bridge.rs:425 ui/src/bridge.rs:443
msgid "Cannot save the setting: {reason}"
msgstr "Nu se poate salva configurarea: {reason}"

#: ui/src/bridge.rs:412
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos va fi descărcat la următoarea sincronizare"

#: ui/src/bridge.rs:413
msgid "Proton Photos will be left alone"
msgstr "Proton Photos va fi lăsat neatins"

#: ui/src/bridge.rs:430
msgid "Storing everything from now on"
msgstr "De acum se stochează totul"

#: ui/src/bridge.rs:431
msgid "Storing warnings and errors from now on"
msgstr "De acum se stochează avertismentele și erorile"

#: ui/src/bridge.rs:432
msgid "Storing errors from now on"
msgstr "De acum se stochează doar erorile"

#: ui/src/bridge.rs:448
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "s-a eliminat {n} fișier de jurnal mai vechi de {days} zile"
msgstr[1] "s-au eliminat {n} fișiere de jurnal mai vechi de {days} zile"
msgstr[2] "s-au eliminat {n} de fișiere de jurnal mai vechi de {days} zile"

#: ui/src/bridge.rs:449
msgid "Cannot prune the log: {reason}"
msgstr "Nu se poate curăța jurnalul: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "Alegeți dosarul Proton Drive"

#: ui/qml/main.qml:38
msgid "The folder is not empty"
msgstr "Dosarul nu este gol"

#: ui/qml/main.qml:73
msgid "Opened {what}"
msgstr "S-a deschis {what}"

#: ui/qml/main.qml:75
msgid "Could not open {what} ({url})"
msgstr "Nu s-a putut deschide {what} ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:131
msgid "Account"
msgstr "Cont"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:133
msgid "Logs"
msgstr "Jurnale"

#: ui/qml/main.qml:164
msgid "Not signed in"
msgstr "Neautentificat"

#: ui/qml/main.qml:171
msgid "Signed in to Proton Drive"
msgstr "Autentificat la Proton Drive"

#: ui/qml/main.qml:172
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Autentificați-vă pentru a sincroniza acest calculator cu Proton Drive."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:193
msgid "Storage"
msgstr "Spațiu de stocare"

#: ui/qml/main.qml:221
msgid "{used} of {total} used"
msgstr "Utilizat: {used} din {total}"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:233
msgid "Syncing to"
msgstr "Se sincronizează în"

#: ui/qml/main.qml:237
msgid "nowhere yet"
msgstr "nicăieri deocamdată"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:244
msgid "Change…"
msgstr "Schimbă…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:251
msgid "Ignore file…"
msgstr "Fișier de ignorare…"

#: ui/qml/main.qml:263
msgid "Also download Proton Photos"
msgstr "Descarcă și Proton Photos"

#: ui/qml/main.qml:271
msgid ""
"Read-only: your timeline is copied into {folder}. Photos are never uploaded, "
"changed or deleted in Proton Photos, and the copy is checked every half hour."
msgstr "Doar citire: cronologia dumneavoastră este copiată în {folder}. Fotografiile nu sunt niciodată încărcate, modificate sau șterse în Proton Photos, iar copia este verificată la fiecare jumătate de oră."

#: ui/qml/main.qml:272
msgid "your Pictures folder"
msgstr "dosarul dumneavoastră Imagini"

#: ui/qml/main.qml:319
msgid "Drive on the web"
msgstr "Drive pe web"

#: ui/qml/main.qml:324
msgid "Proton account"
msgstr "Cont Proton"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:330
msgid "Refresh"
msgstr "Reîmprospătează"

#: ui/qml/main.qml:336
msgid "Sign in"
msgstr "Autentificare"

#: ui/qml/main.qml:379
msgid "Read the licence"
msgstr "Citiți licența"

#: ui/qml/main.qml:397
msgid "Search the log"
msgstr "Caută în jurnal"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:443
msgid "Copy"
msgstr "Copiază"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:449
msgid "Select all"
msgstr "Selectează tot"

#: ui/qml/main.qml:466
msgid "No lines match"
msgstr "Nicio linie nu se potrivește"

#: ui/qml/main.qml:466
msgid "Nothing logged yet"
msgstr "Nu s-a înregistrat nimic încă"

#: ui/qml/main.qml:468
msgid "No line since the sync daemon started contains “{term}”."
msgstr "Nicio linie de la pornirea serviciului de sincronizare nu conține „{term}”."

#: ui/qml/main.qml:469
msgid "This shows what has happened since the sync daemon started."
msgstr "Aici se arată ce s-a întâmplat de la pornirea serviciului de sincronizare."

#. TRANSLATORS: start of "Keep logs for [30] days"; the number and "days" follow
#: ui/qml/main.qml:478
msgid "Keep logs for"
msgstr "Păstrează jurnalele"

#. TRANSLATORS: end of "Keep logs for [30] days"
#: ui/qml/main.qml:488
msgid "days"
msgstr "zile"

#. TRANSLATORS: verb, label before a dropdown choosing which log levels are written to disk
#: ui/qml/main.qml:493
msgid "Store"
msgstr "Stochează"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:501
msgid "Warnings and errors"
msgstr "Avertismente și erori"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:503
msgid "Everything"
msgstr "Tot"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:505
msgid "Errors only"
msgstr "Doar erorile"

#: ui/qml/main.qml:514
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} linie"
msgstr[1] "{n} linii"
msgstr[2] "{n} de linii"

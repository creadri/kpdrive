#: src/daemon.rs:112
msgid "Signed out. Sign in from the account window."
msgstr "Sesión cerrada. Inicia sesión desde la ventana de la cuenta."

#: src/daemon.rs:114 src/daemon.rs:401
msgid "Syncing…"
msgstr "Sincronizando…"

#: src/daemon.rs:116 src/daemon.rs:404
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} elemento sincronizado"
msgstr[1] "{n} elementos sincronizados"

#: src/daemon.rs:126 ui/qml/main.qml:409
msgid "Open folder"
msgstr "Abrir carpeta"

#: src/daemon.rs:136
msgid "Account and logs…"
msgstr "Cuenta y registros…"

#: src/daemon.rs:143 ui/qml/main.qml:396
msgid "Sync now"
msgstr "Sincronizar ahora"

#: src/daemon.rs:155
msgid "Pause sync"
msgstr "Pausar la sincronización"

#: src/daemon.rs:168
msgid "Quit"
msgstr "Salir"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:328
msgid "{reason}; retrying"
msgstr "{reason}; reintentando"

#: src/daemon.rs:339
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive vuelve a estar accesible, después de {duration}"

#: src/daemon.rs:350
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} segundo"
msgstr[1] "{n} segundos"

#: src/daemon.rs:351
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuto"
msgstr[1] "{n} minutos"

#: src/daemon.rs:352
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} hora"
msgstr[1] "{n} horas"

#: src/daemon.rs:382
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"El servicio de sincronización no está en ejecución. Inícialo con: kpdrive "
"sync --watch"

#: src/daemon.rs:385
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Hay un servicio de sincronización en ejecución, pero es demasiado antiguo "
"para indicar qué está haciendo. Reinícialo."

#: src/daemon.rs:391
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Sesión cerrada. La sincronización se reanudará cuando inicies sesión."

#: src/daemon.rs:395
msgid "{reason}. Still trying."
msgstr "{reason}. Se sigue intentando."

#: src/daemon.rs:396
msgid "Last sync failed: {reason}"
msgstr "La última sincronización falló: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:410
msgid "just now"
msgstr "ahora mismo"

#: src/daemon.rs:412
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "hace {n} minuto"
msgstr[1] "hace {n} minutos"

#: src/daemon.rs:415
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "hace {n} hora"
msgstr[1] "hace {n} horas"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:419
msgid "{items}, checked {ago}"
msgstr "{items}, última comprobación {ago}"

#: src/daemon.rs:637
msgid "Signed in again. Syncing resumed."
msgstr "Sesión iniciada de nuevo. Sincronización reanudada."

#: src/daemon.rs:712
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Sesión cerrada. Inicia sesión desde la ventana de la cuenta para reanudar la "
"sincronización."

#: src/daemon.rs:745
msgid "Sync resumed"
msgstr "Sincronización reanudada"

#: src/daemon.rs:762
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} foto descargada"
msgstr[1] "{n} fotos descargadas"

#: src/daemon.rs:783
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} foto subida a Proton Photos"
msgstr[1] "{n} fotos subidas a Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:334
msgid "Sign out"
msgstr "Cerrar sesión"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} foto"
msgstr[1] "{n} fotos"

#: src/pause.rs:20
msgid "Paused"
msgstr "En pausa"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "En pausa con alimentación de red"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "En pausa con batería"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "En pausa con la batería baja"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "En pausa mientras hay conexión a {network}"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Sincronizar en ella y conservar lo que ya contiene"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Apartarla y empezar con una carpeta vacía"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"{folder} ya contiene {n} elemento, que la sincronización combinará con "
"Proton Drive."
msgstr[1] ""
"{folder} ya contiene {n} elementos, que la sincronización combinará con "
"Proton Drive."

#: ui/src/bridge.rs:237
msgid "Starting…"
msgstr "Iniciando…"

#: ui/src/bridge.rs:288
msgid "Confirm the code {code} in your browser"
msgstr "Confirma el código {code} en tu navegador"

#: ui/src/bridge.rs:302
msgid "Sign-in failed: {reason}"
msgstr "No se pudo iniciar sesión: {reason}"

#: ui/src/bridge.rs:314
msgid "Signed out"
msgstr "Sesión cerrada"

#: ui/src/bridge.rs:317
msgid "Sign-out failed: {reason}"
msgstr "No se pudo cerrar sesión: {reason}"

#: ui/src/bridge.rs:382
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Reinicia el servicio de sincronización para aplicar el cambio."

#: ui/src/bridge.rs:385
msgid "Cannot change the folder: {reason}"
msgstr "No se puede cambiar la carpeta: {reason}"

#: ui/src/bridge.rs:392
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Aún no hay carpeta de sincronización. Ejecuta: kpdrive setup"

#: ui/src/bridge.rs:396
msgid "Cannot create the ignore file: {reason}"
msgstr "No se puede crear el archivo de exclusiones: {reason}"

#: ui/src/bridge.rs:434
msgid "Checking the account…"
msgstr "Comprobando la cuenta…"

#: ui/src/bridge.rs:440
msgid "Opening the browser…"
msgstr "Abriendo el navegador…"

#: ui/src/bridge.rs:446
msgid "Signing out…"
msgstr "Cerrando sesión…"

#: ui/src/bridge.rs:472
msgid "Cannot read the log: {reason}"
msgstr "No se puede leer el registro: {reason}"

#: ui/src/bridge.rs:482 ui/src/bridge.rs:510 ui/src/bridge.rs:524
#: ui/src/bridge.rs:539 ui/src/bridge.rs:573 ui/src/bridge.rs:614
#: ui/src/bridge.rs:627 ui/src/bridge.rs:645
msgid "Cannot save the setting: {reason}"
msgstr "No se puede guardar el ajuste: {reason}"

#: ui/src/bridge.rs:490
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos se descargará en la próxima sincronización"

#: ui/src/bridge.rs:491
msgid "Proton Photos will be left alone"
msgstr "Proton Photos no se descargará"

#: ui/src/bridge.rs:516
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr "Las fotos que pongas en esa carpeta se subirán a Proton Photos"

#: ui/src/bridge.rs:517
msgid "No longer uploading photos"
msgstr "Ya no se suben fotos"

#: ui/src/bridge.rs:607
msgid "Photos will be downloaded into that folder from the next pass"
msgstr "Las fotos se descargarán en esa carpeta a partir de la próxima pasada"

#: ui/src/bridge.rs:632
msgid "Storing everything from now on"
msgstr "A partir de ahora se guardará todo"

#: ui/src/bridge.rs:633
msgid "Storing warnings and errors from now on"
msgstr "A partir de ahora se guardarán las advertencias y los errores"

#: ui/src/bridge.rs:634
msgid "Storing errors from now on"
msgstr "A partir de ahora solo se guardarán los errores"

#: ui/src/bridge.rs:650
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "se eliminó {n} archivo de registro con más de {days} días"
msgstr[1] "se eliminaron {n} archivos de registro con más de {days} días"

#: ui/src/bridge.rs:651
msgid "Cannot prune the log: {reason}"
msgstr "No se puede limpiar el registro: {reason}"

#: ui/qml/main.qml:28
msgid "Choose the Proton Drive folder"
msgstr "Elige la carpeta de Proton Drive"

#: ui/qml/main.qml:35
msgid "Choose where Proton Photos are downloaded"
msgstr "Elige dónde se descargan las fotos de Proton Photos"

#: ui/qml/main.qml:42
msgid "Choose the folder to upload photos from"
msgstr "Elige la carpeta desde la que subir fotos"

#: ui/qml/main.qml:53
msgid "The folder is not empty"
msgstr "La carpeta no está vacía"

#: ui/qml/main.qml:104
msgid "Opened {what}"
msgstr "Se abrió {what}"

#: ui/qml/main.qml:106
msgid "Could not open {what} ({url})"
msgstr "No se pudo abrir {what} ({url})"

#: ui/qml/main.qml:186
msgid "Account & activity"
msgstr "Cuenta y actividad"

#: ui/qml/main.qml:187
msgid "Settings"
msgstr "Configuración"

#: ui/qml/main.qml:188 ui/qml/main.qml:633
msgid "Logs"
msgstr "Registros"

#: ui/qml/main.qml:189
msgid "About"
msgstr "Acerca de"

#: ui/qml/main.qml:269
msgid "Not signed in"
msgstr "Sesión no iniciada"

#: ui/qml/main.qml:276
msgid "Signed in to Proton Drive"
msgstr "Sesión iniciada en Proton Drive"

#: ui/qml/main.qml:277
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Inicia sesión para sincronizar este equipo con Proton Drive."

#: ui/qml/main.qml:294
msgid "Storage:"
msgstr "Almacenamiento:"

#: ui/qml/main.qml:323
msgid "{used} of {total} used"
msgstr "{used} de {total} en uso"

#: ui/qml/main.qml:331
msgid "Account:"
msgstr "Cuenta:"

#: ui/qml/main.qml:334
msgid "Sign in"
msgstr "Iniciar sesión"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:341
msgid "Refresh"
msgstr "Actualizar"

#: ui/qml/main.qml:350
msgid "On the web:"
msgstr "En la web:"

#: ui/qml/main.qml:353
msgid "Drive on the web"
msgstr "Drive en la web"

#: ui/qml/main.qml:358
msgid "Proton account"
msgstr "Cuenta de Proton"

#: ui/qml/main.qml:366
msgid "Activity"
msgstr "Actividad"

#: ui/qml/main.qml:373
msgid "Sync:"
msgstr "Sincronización:"

#: ui/qml/main.qml:404
msgid "Resume"
msgstr "Reanudar"

#: ui/qml/main.qml:404
msgid "Pause"
msgstr "Pausar"

#: ui/qml/main.qml:429
msgid "Files"
msgstr "Archivos"

#: ui/qml/main.qml:433
msgid "Sync folder:"
msgstr "Carpeta de sincronización:"

#: ui/qml/main.qml:437
msgid "nowhere yet"
msgstr "aún en ningún sitio"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:443 ui/qml/main.qml:490 ui/qml/main.qml:533
msgid "Change…"
msgstr "Cambiar…"

#: ui/qml/main.qml:450
msgid "Ignored paths:"
msgstr "Rutas ignoradas:"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves
#. alone
#: ui/qml/main.qml:452
msgid "Ignore file…"
msgstr "Archivo de exclusiones…"

#: ui/qml/main.qml:459
msgid "Photos"
msgstr "Fotos"

#: ui/qml/main.qml:463
msgid "Download:"
msgstr "Descarga:"

#: ui/qml/main.qml:467
msgid "Also download Proton Photos"
msgstr "Descargar también Proton Photos"

#: ui/qml/main.qml:473
msgid ""
"Your timeline is copied here every half hour. Nothing in Proton Photos is "
"changed or deleted by it."
msgstr ""
"Tu línea de tiempo se copia aquí cada media hora. Esto no cambia ni elimina "
"nada en Proton Photos."

#: ui/qml/main.qml:481
msgid "Download folder:"
msgstr "Carpeta de descarga:"

#: ui/qml/main.qml:485
msgid "your Pictures folder"
msgstr "tu carpeta Imágenes"

#: ui/qml/main.qml:497
msgid "Upload:"
msgstr "Subida:"

#: ui/qml/main.qml:501
msgid "Upload photos from a folder"
msgstr "Subir fotos desde una carpeta"

#: ui/qml/main.qml:515
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""
"Las fotos y los vídeos que pongas en esta carpeta se suben a Proton Photos "
"en menos de un minuto y después salen de la carpeta. Lo que no se pueda "
"subir se queda."

#: ui/qml/main.qml:523
msgid "Upload folder:"
msgstr "Carpeta de subida:"

#: ui/qml/main.qml:540
msgid "After upload:"
msgstr "Tras la subida:"

#: ui/qml/main.qml:542
msgid "Delete instead of moving to the trash"
msgstr "Eliminar en lugar de mover a la papelera"

#: ui/qml/main.qml:549
msgid "Network"
msgstr "Red"

#: ui/qml/main.qml:553 ui/qml/main.qml:598
msgid "Pause while on:"
msgstr "Pausar con:"

#: ui/qml/main.qml:573
msgid "{network} (connected)"
msgstr "{network} (conectada)"

#: ui/qml/main.qml:584
msgid ""
"Syncing pauses while any ticked network is connected, such as a phone's "
"hotspot. A sync already under way finishes first."
msgstr ""
"La sincronización se pausa mientras esté conectada cualquier red marcada, "
"como el punto de acceso de un teléfono. Una sincronización ya en curso "
"termina primero."

#: ui/qml/main.qml:585
msgid "NetworkManager lists no networks to choose from."
msgstr "NetworkManager no ofrece ninguna red para elegir."

#: ui/qml/main.qml:594
msgid "Power"
msgstr "Energía"

#: ui/qml/main.qml:604
msgid "AC power"
msgstr "Alimentación de red"

#: ui/qml/main.qml:605
msgid "Battery"
msgstr "Batería"

#: ui/qml/main.qml:606
msgid "Low battery"
msgstr "Batería baja"

#: ui/qml/main.qml:614
msgid "{power} (now)"
msgstr "{power} (ahora)"

#: ui/qml/main.qml:624
msgid ""
"Low battery is the level set in the system's power management settings. A "
"sync already under way finishes first."
msgstr ""
"La batería baja es el nivel definido en la configuración de gestión de "
"energía del sistema. Una sincronización ya en curso termina primero."

#: ui/qml/main.qml:637
msgid "Keep logs for:"
msgstr "Conservar registros durante:"

#. TRANSLATORS: after the number in "Keep logs for: [30] days"
#: ui/qml/main.qml:646
msgid "days"
msgstr "días"

#. TRANSLATORS: label before a dropdown choosing which log levels are written
#. to disk
#: ui/qml/main.qml:651
msgid "Store:"
msgstr "Guardar:"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:656
msgid "Warnings and errors"
msgstr "Advertencias y errores"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:658
msgid "Everything"
msgstr "Todo"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:660
msgid "Errors only"
msgstr "Solo errores"

#: ui/qml/main.qml:681
msgid "Search the log"
msgstr "Buscar en el registro"

#: ui/qml/main.qml:686
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} línea"
msgstr[1] "{n} líneas"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:736
msgid "Copy"
msgstr "Copiar"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:742
msgid "Select all"
msgstr "Seleccionar todo"

#: ui/qml/main.qml:759
msgid "No lines match"
msgstr "Ninguna línea coincide"

#: ui/qml/main.qml:759
msgid "Nothing logged yet"
msgstr "Aún no hay nada registrado"

#: ui/qml/main.qml:761
msgid "No line since the sync daemon started contains “{term}”."
msgstr ""
"Ninguna línea desde que se inició el servicio de sincronización contiene "
"«{term}»."

#: ui/qml/main.qml:762
msgid "This shows what has happened since the sync daemon started."
msgstr ""
"Aquí se muestra lo que ha ocurrido desde que se inició el servicio de "
"sincronización."

#: ui/qml/main.qml:794
msgid "Proton Drive sync client for KDE Plasma"
msgstr "Cliente de sincronización de Proton Drive para KDE Plasma"


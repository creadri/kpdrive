#: src/daemon.rs:98
msgid "Signed out. Sign in from the account window."
msgstr "Sesión cerrada. Inicia sesión desde la ventana de la cuenta."

#: src/daemon.rs:100 src/daemon.rs:341
msgid "Syncing…"
msgstr "Sincronizando…"

#: src/daemon.rs:102 src/daemon.rs:344
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} elemento sincronizado"
msgstr[1] "{n} elementos sincronizados"

#: src/daemon.rs:112 ui/qml/main.qml:313
msgid "Open folder"
msgstr "Abrir carpeta"

#: src/daemon.rs:122
msgid "Account and logs…"
msgstr "Cuenta y registros…"

#: src/daemon.rs:129 ui/qml/main.qml:291
msgid "Sync now"
msgstr "Sincronizar ahora"

#: src/daemon.rs:139
msgid "Quit"
msgstr "Salir"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:273
msgid "{reason}; retrying"
msgstr "{reason}; reintentando"

#: src/daemon.rs:284
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive vuelve a estar accesible, después de {duration}"

#: src/daemon.rs:295
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} segundo"
msgstr[1] "{n} segundos"

#: src/daemon.rs:296
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuto"
msgstr[1] "{n} minutos"

#: src/daemon.rs:297
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} hora"
msgstr[1] "{n} horas"

#: src/daemon.rs:325
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "El servicio de sincronización no está en ejecución. Inícialo con: kpdrive sync --watch"

#: src/daemon.rs:328
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr "Hay un servicio de sincronización en ejecución, pero es demasiado antiguo para indicar qué está haciendo. Reinícialo."

#: src/daemon.rs:331
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Sesión cerrada. La sincronización se reanudará cuando inicies sesión."

#: src/daemon.rs:335
msgid "{reason}. Still trying."
msgstr "{reason}. Se sigue intentando."

#: src/daemon.rs:336
msgid "Last sync failed: {reason}"
msgstr "La última sincronización falló: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:350
msgid "just now"
msgstr "ahora mismo"

#: src/daemon.rs:352
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "hace {n} minuto"
msgstr[1] "hace {n} minutos"

#: src/daemon.rs:355
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "hace {n} hora"
msgstr[1] "hace {n} horas"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:359
msgid "{items}, checked {ago}"
msgstr "{items}, última comprobación {ago}"

#: src/daemon.rs:576
msgid "Signed in again. Syncing resumed."
msgstr "Sesión iniciada de nuevo. Sincronización reanudada."

#: src/daemon.rs:630
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "Sesión cerrada. Inicia sesión desde la ventana de la cuenta para reanudar la sincronización."

#: src/daemon.rs:663
msgid "Sync resumed"
msgstr "Sincronización reanudada"

#: src/daemon.rs:680
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} foto descargada"
msgstr[1] "{n} fotos descargadas"

#: src/i18n.rs:111 ui/qml/main.qml:336
msgid "Sign out"
msgstr "Cerrar sesión"

#: src/i18n.rs:112 src/i18n.rs:113
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} foto"
msgstr[1] "{n} fotos"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Sincronizar en ella y conservar lo que ya contiene"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Apartarla y empezar con una carpeta vacía"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] "{folder} ya contiene {n} elemento, que la sincronización combinará con Proton Drive."
msgstr[1] "{folder} ya contiene {n} elementos, que la sincronización combinará con Proton Drive."

#: ui/src/bridge.rs:175
msgid "Starting…"
msgstr "Iniciando…"

#: ui/src/bridge.rs:217
msgid "Confirm the code {code} in your browser"
msgstr "Confirma el código {code} en tu navegador"

#: ui/src/bridge.rs:231
msgid "Sign-in failed: {reason}"
msgstr "No se pudo iniciar sesión: {reason}"

#: ui/src/bridge.rs:243
msgid "Signed out"
msgstr "Sesión cerrada"

#: ui/src/bridge.rs:246
msgid "Sign-out failed: {reason}"
msgstr "No se pudo cerrar sesión: {reason}"

#: ui/src/bridge.rs:305
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Reinicia el servicio de sincronización para aplicar el cambio."

#: ui/src/bridge.rs:308
msgid "Cannot change the folder: {reason}"
msgstr "No se puede cambiar la carpeta: {reason}"

#: ui/src/bridge.rs:315
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Aún no hay carpeta de sincronización. Ejecuta: kpdrive setup"

#: ui/src/bridge.rs:319
msgid "Cannot create the ignore file: {reason}"
msgstr "No se puede crear el archivo de exclusiones: {reason}"

#: ui/src/bridge.rs:356
msgid "Checking the account…"
msgstr "Comprobando la cuenta…"

#: ui/src/bridge.rs:362
msgid "Opening the browser…"
msgstr "Abriendo el navegador…"

#: ui/src/bridge.rs:368
msgid "Signing out…"
msgstr "Cerrando sesión…"

#: ui/src/bridge.rs:394
msgid "Cannot read the log: {reason}"
msgstr "No se puede leer el registro: {reason}"

#: ui/src/bridge.rs:404 ui/src/bridge.rs:425 ui/src/bridge.rs:443
msgid "Cannot save the setting: {reason}"
msgstr "No se puede guardar el ajuste: {reason}"

#: ui/src/bridge.rs:412
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos se descargará en la próxima sincronización"

#: ui/src/bridge.rs:413
msgid "Proton Photos will be left alone"
msgstr "Proton Photos no se descargará"

#: ui/src/bridge.rs:430
msgid "Storing everything from now on"
msgstr "A partir de ahora se guardará todo"

#: ui/src/bridge.rs:431
msgid "Storing warnings and errors from now on"
msgstr "A partir de ahora se guardarán las advertencias y los errores"

#: ui/src/bridge.rs:432
msgid "Storing errors from now on"
msgstr "A partir de ahora solo se guardarán los errores"

#: ui/src/bridge.rs:448
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "se eliminó {n} archivo de registro con más de {days} días"
msgstr[1] "se eliminaron {n} archivos de registro con más de {days} días"

#: ui/src/bridge.rs:449
msgid "Cannot prune the log: {reason}"
msgstr "No se puede limpiar el registro: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "Elige la carpeta de Proton Drive"

#: ui/qml/main.qml:38
msgid "The folder is not empty"
msgstr "La carpeta no está vacía"

#: ui/qml/main.qml:73
msgid "Opened {what}"
msgstr "Se abrió {what}"

#: ui/qml/main.qml:75
msgid "Could not open {what} ({url})"
msgstr "No se pudo abrir {what} ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:131
msgid "Account"
msgstr "Cuenta"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:133
msgid "Logs"
msgstr "Registros"

#: ui/qml/main.qml:164
msgid "Not signed in"
msgstr "Sesión no iniciada"

#: ui/qml/main.qml:171
msgid "Signed in to Proton Drive"
msgstr "Sesión iniciada en Proton Drive"

#: ui/qml/main.qml:172
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Inicia sesión para sincronizar este equipo con Proton Drive."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:193
msgid "Storage"
msgstr "Almacenamiento"

#: ui/qml/main.qml:221
msgid "{used} of {total} used"
msgstr "{used} de {total} en uso"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:233
msgid "Syncing to"
msgstr "Sincronizando en"

#: ui/qml/main.qml:237
msgid "nowhere yet"
msgstr "aún en ningún sitio"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:244
msgid "Change…"
msgstr "Cambiar…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:251
msgid "Ignore file…"
msgstr "Archivo de exclusiones…"

#: ui/qml/main.qml:263
msgid "Also download Proton Photos"
msgstr "Descargar también Proton Photos"

#: ui/qml/main.qml:271
msgid ""
"Read-only: your timeline is copied into {folder}. Photos are never uploaded, "
"changed or deleted in Proton Photos, and the copy is checked every half hour."
msgstr "Solo lectura: tu cronología se copia en {folder}. Las fotos nunca se suben, modifican ni eliminan en Proton Photos, y la copia se comprueba cada media hora."

#: ui/qml/main.qml:272
msgid "your Pictures folder"
msgstr "tu carpeta Imágenes"

#: ui/qml/main.qml:319
msgid "Drive on the web"
msgstr "Drive en la web"

#: ui/qml/main.qml:324
msgid "Proton account"
msgstr "Cuenta de Proton"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:330
msgid "Refresh"
msgstr "Actualizar"

#: ui/qml/main.qml:336
msgid "Sign in"
msgstr "Iniciar sesión"

#: ui/qml/main.qml:379
msgid "Read the licence"
msgstr "Leer la licencia"

#: ui/qml/main.qml:397
msgid "Search the log"
msgstr "Buscar en el registro"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:443
msgid "Copy"
msgstr "Copiar"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:449
msgid "Select all"
msgstr "Seleccionar todo"

#: ui/qml/main.qml:466
msgid "No lines match"
msgstr "Ninguna línea coincide"

#: ui/qml/main.qml:466
msgid "Nothing logged yet"
msgstr "Aún no hay nada registrado"

#: ui/qml/main.qml:468
msgid "No line since the sync daemon started contains “{term}”."
msgstr "Ninguna línea desde que se inició el servicio de sincronización contiene «{term}»."

#: ui/qml/main.qml:469
msgid "This shows what has happened since the sync daemon started."
msgstr "Aquí se muestra lo que ha ocurrido desde que se inició el servicio de sincronización."

#. TRANSLATORS: start of "Keep logs for [30] days"; the number and "days" follow
#: ui/qml/main.qml:478
msgid "Keep logs for"
msgstr "Conservar los registros durante"

#. TRANSLATORS: end of "Keep logs for [30] days"
#: ui/qml/main.qml:488
msgid "days"
msgstr "días"

#. TRANSLATORS: verb, label before a dropdown choosing which log levels are written to disk
#: ui/qml/main.qml:493
msgid "Store"
msgstr "Guardar"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:501
msgid "Warnings and errors"
msgstr "Advertencias y errores"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:503
msgid "Everything"
msgstr "Todo"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:505
msgid "Errors only"
msgstr "Solo errores"

#: ui/qml/main.qml:514
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} línea"
msgstr[1] "{n} líneas"

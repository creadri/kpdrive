#: src/daemon.rs:102
msgid "Signed out. Sign in from the account window."
msgstr "Déconnecté. Connectez-vous depuis la fenêtre du compte."

#: src/daemon.rs:104 src/daemon.rs:371
msgid "Syncing…"
msgstr "Synchronisation…"

#: src/daemon.rs:106 src/daemon.rs:374
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} élément synchronisé"
msgstr[1] "{n} éléments synchronisés"

#: src/daemon.rs:116 ui/qml/main.qml:382
msgid "Open folder"
msgstr "Ouvrir le dossier"

#: src/daemon.rs:126
msgid "Account and logs…"
msgstr "Compte et journaux…"

#: src/daemon.rs:133 ui/qml/main.qml:360
msgid "Sync now"
msgstr "Synchroniser maintenant"

#: src/daemon.rs:143
msgid "Quit"
msgstr "Quitter"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:303
msgid "{reason}; retrying"
msgstr "{reason} ; nouvelle tentative en cours"

#: src/daemon.rs:314
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive est de nouveau joignable, après {duration}"

#: src/daemon.rs:325
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} seconde"
msgstr[1] "{n} secondes"

#: src/daemon.rs:326
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minute"
msgstr[1] "{n} minutes"

#: src/daemon.rs:327
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} heure"
msgstr[1] "{n} heures"

#: src/daemon.rs:355
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"Le service de synchronisation n’est pas lancé. Démarrez-le avec : kpdrive "
"sync --watch"

#: src/daemon.rs:358
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Un service de synchronisation est lancé, mais il est trop ancien pour dire "
"ce qu’il fait. Redémarrez-le."

#: src/daemon.rs:361
msgid "Signed out. Syncing resumes once you sign in."
msgstr ""
"Déconnecté. La synchronisation reprendra dès que vous vous reconnecterez."

#: src/daemon.rs:365
msgid "{reason}. Still trying."
msgstr "{reason}. Nouvelle tentative en cours."

#: src/daemon.rs:366
msgid "Last sync failed: {reason}"
msgstr "Échec de la dernière synchronisation : {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:380
msgid "just now"
msgstr "à l’instant"

#: src/daemon.rs:382
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "il y a {n} minute"
msgstr[1] "il y a {n} minutes"

#: src/daemon.rs:385
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "il y a {n} heure"
msgstr[1] "il y a {n} heures"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:389
msgid "{items}, checked {ago}"
msgstr "{items}, vérifié {ago}"

#: src/daemon.rs:606
msgid "Signed in again. Syncing resumed."
msgstr "Reconnecté. La synchronisation a repris."

#: src/daemon.rs:660
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Déconnecté. Connectez-vous depuis la fenêtre du compte pour reprendre la "
"synchronisation."

#: src/daemon.rs:693
msgid "Sync resumed"
msgstr "Synchronisation reprise"

#: src/daemon.rs:710
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} photo téléchargée"
msgstr[1] "{n} photos téléchargées"

#: src/daemon.rs:731
#, fuzzy
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "Télécharger également Proton Photos"
msgstr[1] "Télécharger également Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:405
msgid "Sign out"
msgstr "Se déconnecter"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} photo"
msgstr[1] "{n} photos"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Synchroniser dedans et conserver ce qui s’y trouve déjà"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Le déplacer et repartir d’un dossier vide"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"{folder} contient déjà {n} élément, que la synchronisation fusionnera avec "
"Proton Drive."
msgstr[1] ""
"{folder} contient déjà {n} éléments, que la synchronisation fusionnera avec "
"Proton Drive."

#: ui/src/bridge.rs:189
msgid "Starting…"
msgstr "Démarrage…"

#: ui/src/bridge.rs:233
msgid "Confirm the code {code} in your browser"
msgstr "Confirmez le code {code} dans votre navigateur"

#: ui/src/bridge.rs:247
msgid "Sign-in failed: {reason}"
msgstr "Échec de la connexion : {reason}"

#: ui/src/bridge.rs:259
msgid "Signed out"
msgstr "Déconnecté"

#: ui/src/bridge.rs:262
msgid "Sign-out failed: {reason}"
msgstr "Échec de la déconnexion : {reason}"

#: ui/src/bridge.rs:324
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Redémarrez le service de synchronisation pour l’utiliser."

#: ui/src/bridge.rs:327
msgid "Cannot change the folder: {reason}"
msgstr "Impossible de changer de dossier : {reason}"

#: ui/src/bridge.rs:334
msgid "No sync folder yet. Run: kpdrive setup"
msgstr ""
"Aucun dossier de synchronisation pour l’instant. Lancez : kpdrive setup"

#: ui/src/bridge.rs:338
msgid "Cannot create the ignore file: {reason}"
msgstr "Impossible de créer le fichier d’exclusion : {reason}"

#: ui/src/bridge.rs:375
msgid "Checking the account…"
msgstr "Vérification du compte…"

#: ui/src/bridge.rs:381
msgid "Opening the browser…"
msgstr "Ouverture du navigateur…"

#: ui/src/bridge.rs:387
msgid "Signing out…"
msgstr "Déconnexion…"

#: ui/src/bridge.rs:413
msgid "Cannot read the log: {reason}"
msgstr "Impossible de lire le journal : {reason}"

#: ui/src/bridge.rs:423 ui/src/bridge.rs:451 ui/src/bridge.rs:467
#: ui/src/bridge.rs:480 ui/src/bridge.rs:498
msgid "Cannot save the setting: {reason}"
msgstr "Impossible d’enregistrer le réglage : {reason}"

#: ui/src/bridge.rs:431
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos sera téléchargé à la prochaine synchronisation"

#: ui/src/bridge.rs:432
msgid "Proton Photos will be left alone"
msgstr "Proton Photos ne sera pas téléchargé"

#: ui/src/bridge.rs:457
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr ""

#: ui/src/bridge.rs:458
msgid "No longer uploading photos"
msgstr ""

#: ui/src/bridge.rs:485
msgid "Storing everything from now on"
msgstr "Tout sera désormais conservé"

#: ui/src/bridge.rs:486
msgid "Storing warnings and errors from now on"
msgstr "Les avertissements et les erreurs seront désormais conservés"

#: ui/src/bridge.rs:487
msgid "Storing errors from now on"
msgstr "Seules les erreurs seront désormais conservées"

#: ui/src/bridge.rs:503
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "{n} fichier de journal de plus de {days} jours supprimé"
msgstr[1] "{n} fichiers de journal de plus de {days} jours supprimés"

#: ui/src/bridge.rs:504
msgid "Cannot prune the log: {reason}"
msgstr "Impossible de purger le journal : {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "Choisir le dossier Proton Drive"

#: ui/qml/main.qml:34
msgid "Choose the folder to upload photos from"
msgstr ""

#: ui/qml/main.qml:45
msgid "The folder is not empty"
msgstr "Le dossier n’est pas vide"

#: ui/qml/main.qml:80
msgid "Opened {what}"
msgstr "{what} ouvert"

#: ui/qml/main.qml:82
msgid "Could not open {what} ({url})"
msgstr "Impossible d’ouvrir {what} ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:138
msgid "Account"
msgstr "Compte"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:140
msgid "Logs"
msgstr "Journaux"

#: ui/qml/main.qml:177
msgid "Not signed in"
msgstr "Non connecté"

#: ui/qml/main.qml:184
msgid "Signed in to Proton Drive"
msgstr "Connecté à Proton Drive"

#: ui/qml/main.qml:185
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Connectez-vous pour synchroniser cet ordinateur avec Proton Drive."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:206
msgid "Storage"
msgstr "Stockage"

#: ui/qml/main.qml:234
msgid "{used} of {total} used"
msgstr "{used} utilisés sur {total}"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:246
msgid "Syncing to"
msgstr "Synchronisé vers"

#: ui/qml/main.qml:250
msgid "nowhere yet"
msgstr "nulle part pour l’instant"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:257 ui/qml/main.qml:324
msgid "Change…"
msgstr "Changer…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:264
msgid "Ignore file…"
msgstr "Fichier d’exclusion…"

#: ui/qml/main.qml:276
msgid "Also download Proton Photos"
msgstr "Télécharger également Proton Photos"

#: ui/qml/main.qml:284
#, fuzzy
msgid ""
"Your timeline is copied into {folder}, checked every half hour. Nothing in "
"Proton Photos is changed or deleted by it."
msgstr ""
"Lecture seule : votre chronologie est copiée dans {folder}. Aucune photo "
"n’est jamais envoyée, modifiée ou supprimée dans Proton Photos, et la copie "
"est vérifiée toutes les demi-heures."

#: ui/qml/main.qml:285
msgid "your Pictures folder"
msgstr "votre dossier Images"

#: ui/qml/main.qml:297
msgid "Upload photos from a folder"
msgstr ""

#: ui/qml/main.qml:333
msgid "Delete uploaded photos instead of moving them to the trash"
msgstr ""

#: ui/qml/main.qml:341
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""

#: ui/qml/main.qml:388
msgid "Drive on the web"
msgstr "Drive sur le web"

#: ui/qml/main.qml:393
msgid "Proton account"
msgstr "Compte Proton"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:399
msgid "Refresh"
msgstr "Actualiser"

#: ui/qml/main.qml:405
msgid "Sign in"
msgstr "Se connecter"

#: ui/qml/main.qml:448
msgid "Read the licence"
msgstr "Lire la licence"

#: ui/qml/main.qml:466
msgid "Search the log"
msgstr "Rechercher dans le journal"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:512
msgid "Copy"
msgstr "Copier"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:518
msgid "Select all"
msgstr "Tout sélectionner"

#: ui/qml/main.qml:535
msgid "No lines match"
msgstr "Aucune ligne ne correspond"

#: ui/qml/main.qml:535
msgid "Nothing logged yet"
msgstr "Rien dans le journal pour l’instant"

#: ui/qml/main.qml:537
msgid "No line since the sync daemon started contains “{term}”."
msgstr "Aucune ligne depuis le démarrage du service ne contient « {term} »."

#: ui/qml/main.qml:538
msgid "This shows what has happened since the sync daemon started."
msgstr ""
"Ceci montre ce qui s’est passé depuis le démarrage du service de "
"synchronisation."

#. TRANSLATORS: start of "Keep logs for [30] days"; the number and "days" follow
#: ui/qml/main.qml:547
msgid "Keep logs for"
msgstr "Conserver les journaux"

#. TRANSLATORS: end of "Keep logs for [30] days"
#: ui/qml/main.qml:557
msgid "days"
msgstr "jours"

#. TRANSLATORS: verb, label before a dropdown choosing which log levels are written to disk
#: ui/qml/main.qml:562
msgid "Store"
msgstr "Conserver"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:570
msgid "Warnings and errors"
msgstr "Avertissements et erreurs"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:572
msgid "Everything"
msgstr "Tout"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:574
msgid "Errors only"
msgstr "Erreurs uniquement"

#: ui/qml/main.qml:583
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} ligne"
msgstr[1] "{n} lignes"

#: ui/qml/main.qml:189
msgid "About"
msgstr "À propos"

#: ui/qml/main.qml:269
msgid "Not signed in"
msgstr "Non connecté"

#: ui/qml/main.qml:276
msgid "Signed in to Proton Drive"
msgstr "Connecté à Proton Drive"

#: ui/qml/main.qml:277

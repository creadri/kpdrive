#: ui/qml/main.qml:327
msgid "Signed in to Proton Drive"
msgstr "Connecté à Proton Drive"

#: ui/qml/main.qml:329
msgid "Signed out. Sign in again to resume syncing this account."
msgstr ""
"Déconnecté. Reconnectez-vous pour reprendre la synchronisation de ce compte."

#: ui/qml/main.qml:330
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Connectez-vous pour synchroniser cet ordinateur avec Proton Drive."


#: ui/qml/main.qml:341
msgid "Refresh"
msgstr "Actualiser"

#: ui/qml/main.qml:350
msgid "On the web:"
msgstr "Sur le web :"

#: ui/qml/main.qml:353
msgid "Drive on the web"
msgstr "Drive sur le web"

#: ui/qml/main.qml:358
msgid "Proton account"
msgstr "Compte Proton"

#: ui/qml/main.qml:366
msgid "Activity"
msgstr "Activité"

#: ui/qml/main.qml:373
msgid "Sync:"
msgstr "Synchronisation :"

#: ui/qml/main.qml:404
msgid "Resume"
msgstr "Reprendre"

#: ui/qml/main.qml:404
msgid "Pause"
msgstr "Suspendre"

#: ui/qml/main.qml:429
msgid "Files"
msgstr "Fichiers"

#: ui/qml/main.qml:433
msgid "Sync folder:"
msgstr "Dossier synchronisé :"

#: ui/qml/main.qml:437
msgid "nowhere yet"
msgstr "nulle part pour l’instant"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:443 ui/qml/main.qml:490 ui/qml/main.qml:533
msgid "Change…"
msgstr "Changer…"

#: ui/qml/main.qml:450
msgid "Ignored paths:"
msgstr "Chemins exclus :"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves
#. alone
#: ui/qml/main.qml:452
msgid "Ignore file…"
msgstr "Fichier d’exclusion…"

#: ui/qml/main.qml:459
msgid "Photos"
msgstr "Photos"

#: ui/qml/main.qml:463
msgid "Download:"
msgstr "Téléchargement :"

#: ui/qml/main.qml:467
msgid "Also download Proton Photos"
msgstr "Télécharger également Proton Photos"

#: ui/qml/main.qml:473
msgid ""
"Your timeline is copied here every half hour. Nothing in Proton Photos is "
"changed or deleted by it."
msgstr ""
"Votre chronologie est copiée ici toutes les demi-heures. Rien n’est modifié "
"ni supprimé dans Proton Photos."

#: ui/qml/main.qml:481
msgid "Download folder:"
msgstr "Dossier de téléchargement :"

#: ui/qml/main.qml:485
msgid "your Pictures folder"
msgstr "votre dossier Images"

#: ui/qml/main.qml:497
msgid "Upload:"
msgstr "Envoi :"

#: ui/qml/main.qml:501
msgid "Upload photos from a folder"
msgstr "Envoyer les photos d’un dossier"

#: ui/qml/main.qml:515
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""
"Les photos et vidéos placées dans ce dossier sont envoyées vers Proton "
"Photos en moins d’une minute, puis quittent le dossier. Ce qui ne peut pas "
"être envoyé y reste."

#: ui/qml/main.qml:523
msgid "Upload folder:"
msgstr "Dossier d’envoi :"

#: ui/qml/main.qml:540
msgid "After upload:"
msgstr "Après l’envoi :"

#: ui/qml/main.qml:542
msgid "Delete instead of moving to the trash"
msgstr "Supprimer au lieu de mettre à la corbeille"

#: ui/qml/main.qml:549
msgid "Network"
msgstr "Réseau"

#: ui/qml/main.qml:553 ui/qml/main.qml:598
msgid "Pause while on:"
msgstr "Suspendre sur :"

#: ui/qml/main.qml:573
msgid "{network} (connected)"
msgstr "{network} (connecté)"

#: ui/qml/main.qml:584
msgid ""
"Syncing pauses while any ticked network is connected, such as a phone's "
"hotspot. A sync already under way finishes first."
msgstr ""
"La synchronisation est suspendue tant qu’un réseau coché est connecté, comme "
"le partage de connexion d’un téléphone. Une synchronisation déjà en cours se "
"termine d’abord."

#: ui/qml/main.qml:585
msgid "NetworkManager lists no networks to choose from."
msgstr "NetworkManager ne liste aucun réseau à choisir."

#: ui/qml/main.qml:594
msgid "Power"
msgstr "Alimentation"

#: ui/qml/main.qml:604
msgid "AC power"
msgstr "Secteur"

#: ui/qml/main.qml:605
msgid "Battery"
msgstr "Batterie"

#: ui/qml/main.qml:606
msgid "Low battery"
msgstr "Batterie faible"

#: ui/qml/main.qml:614
msgid "{power} (now)"
msgstr "{power} (actuellement)"

#: ui/qml/main.qml:624
msgid ""
"Low battery is the level set in the system's power management settings. A "
"sync already under way finishes first."
msgstr ""
"Le niveau de batterie faible est celui défini dans les paramètres de gestion "
"de l’énergie du système. Une synchronisation déjà en cours se termine "
"d’abord."

#: ui/qml/main.qml:637
msgid "Keep logs for:"
msgstr "Garder les journaux :"

#. TRANSLATORS: after the number in "Keep logs for: [30] days"
#: ui/qml/main.qml:646
msgid "days"
msgstr "jours"

#. TRANSLATORS: label before a dropdown choosing which log levels are written
#. to disk
#: ui/qml/main.qml:651
msgid "Store:"
msgstr "Conserver :"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:656
msgid "Warnings and errors"
msgstr "Avertissements et erreurs"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:658
msgid "Everything"
msgstr "Tout"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:660
msgid "Errors only"
msgstr "Erreurs uniquement"

#: ui/qml/main.qml:681
msgid "Search the log"
msgstr "Rechercher dans le journal"

#: ui/qml/main.qml:686
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} ligne"
msgstr[1] "{n} lignes"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:736
msgid "Copy"
msgstr "Copier"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:742
msgid "Select all"
msgstr "Tout sélectionner"

#: ui/qml/main.qml:759
msgid "No lines match"
msgstr "Aucune ligne ne correspond"

#: ui/qml/main.qml:759
msgid "Nothing logged yet"
msgstr "Rien dans le journal pour l’instant"

#: ui/qml/main.qml:761
msgid "No line since the sync daemon started contains “{term}”."
msgstr "Aucune ligne depuis le démarrage du service ne contient « {term} »."

#: ui/qml/main.qml:762
msgid "This shows what has happened since the sync daemon started."
msgstr ""
"Ceci montre ce qui s’est passé depuis le démarrage du service de "
"synchronisation."


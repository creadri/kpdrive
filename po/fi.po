#: src/daemon.rs:98
msgid "Signed out. Sign in from the account window."
msgstr "Kirjauduttu ulos. Kirjaudu sisään tili-ikkunasta."

#: src/daemon.rs:100 src/daemon.rs:341
msgid "Syncing…"
msgstr "Synkronoidaan…"

#: src/daemon.rs:102 src/daemon.rs:344
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} kohde synkronoitu"
msgstr[1] "{n} kohdetta synkronoitu"

#: src/daemon.rs:112 ui/qml/main.qml:313
msgid "Open folder"
msgstr "Avaa kansio"

#: src/daemon.rs:122
msgid "Account and logs…"
msgstr "Tili ja loki…"

#: src/daemon.rs:129 ui/qml/main.qml:291
msgid "Sync now"
msgstr "Synkronoi nyt"

#: src/daemon.rs:139
msgid "Quit"
msgstr "Lopeta"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:273
msgid "{reason}; retrying"
msgstr "{reason}; yritetään uudelleen"

#: src/daemon.rs:284
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive on jälleen tavoitettavissa. Katkoksen kesto: {duration}"

#: src/daemon.rs:295
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} sekunti"
msgstr[1] "{n} sekuntia"

#: src/daemon.rs:296
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuutti"
msgstr[1] "{n} minuuttia"

#: src/daemon.rs:297
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} tunti"
msgstr[1] "{n} tuntia"

#: src/daemon.rs:325
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "Synkronointipalvelu ei ole käynnissä. Käynnistä se komennolla: kpdrive sync --watch"

#: src/daemon.rs:328
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr "Synkronointipalvelu on käynnissä, mutta se on liian vanha kertomaan, mitä se tekee. Käynnistä se uudelleen."

#: src/daemon.rs:331
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Kirjauduttu ulos. Synkronointi jatkuu, kun kirjaudut sisään."

#: src/daemon.rs:335
msgid "{reason}. Still trying."
msgstr "{reason}. Yritetään edelleen."

#: src/daemon.rs:336
msgid "Last sync failed: {reason}"
msgstr "Viimeisin synkronointi epäonnistui: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:350
msgid "just now"
msgstr "juuri nyt"

#: src/daemon.rs:352
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} minuutti sitten"
msgstr[1] "{n} minuuttia sitten"

#: src/daemon.rs:355
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} tunti sitten"
msgstr[1] "{n} tuntia sitten"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:359
msgid "{items}, checked {ago}"
msgstr "{items}, tarkistettu {ago}"

#: src/daemon.rs:576
msgid "Signed in again. Syncing resumed."
msgstr "Kirjauduttu uudelleen sisään. Synkronointi jatkuu."

#: src/daemon.rs:630
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "Kirjauduttu ulos. Kirjaudu sisään tili-ikkunasta, niin synkronointi jatkuu."

#: src/daemon.rs:663
msgid "Sync resumed"
msgstr "Synkronointi jatkuu"

#: src/daemon.rs:680
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} valokuva ladattu"
msgstr[1] "{n} valokuvaa ladattu"

#: src/i18n.rs:111 ui/qml/main.qml:336
msgid "Sign out"
msgstr "Kirjaudu ulos"

#: src/i18n.rs:112 src/i18n.rs:113
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} valokuva"
msgstr[1] "{n} valokuvaa"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Synkronoi siihen ja säilytä nykyinen sisältö"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Siirrä se sivuun ja aloita tyhjästä kansiosta"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] "{folder} sisältää jo {n} kohteen, joka yhdistetään synkronoinnissa Proton Drive -palveluun."
msgstr[1] "{folder} sisältää jo {n} kohdetta, jotka yhdistetään synkronoinnissa Proton Drive -palveluun."

#: ui/src/bridge.rs:175
msgid "Starting…"
msgstr "Käynnistetään…"

#: ui/src/bridge.rs:217
msgid "Confirm the code {code} in your browser"
msgstr "Vahvista koodi {code} selaimessa"

#: ui/src/bridge.rs:231
msgid "Sign-in failed: {reason}"
msgstr "Sisäänkirjautuminen epäonnistui: {reason}"

#: ui/src/bridge.rs:243
msgid "Signed out"
msgstr "Kirjauduttu ulos"

#: ui/src/bridge.rs:246
msgid "Sign-out failed: {reason}"
msgstr "Uloskirjautuminen epäonnistui: {reason}"

#: ui/src/bridge.rs:305
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Käynnistä synkronointipalvelu uudelleen, jotta muutos tulee voimaan."

#: ui/src/bridge.rs:308
msgid "Cannot change the folder: {reason}"
msgstr "Kansiota ei voi vaihtaa: {reason}"

#: ui/src/bridge.rs:315
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Synkronointikansiota ei ole vielä. Suorita komento: kpdrive setup"

#: ui/src/bridge.rs:319
msgid "Cannot create the ignore file: {reason}"
msgstr "Ohitustiedostoa ei voi luoda: {reason}"

#: ui/src/bridge.rs:356
msgid "Checking the account…"
msgstr "Tarkistetaan tiliä…"

#: ui/src/bridge.rs:362
msgid "Opening the browser…"
msgstr "Avataan selainta…"

#: ui/src/bridge.rs:368
msgid "Signing out…"
msgstr "Kirjaudutaan ulos…"

#: ui/src/bridge.rs:394
msgid "Cannot read the log: {reason}"
msgstr "Lokia ei voi lukea: {reason}"

#: ui/src/bridge.rs:404 ui/src/bridge.rs:425 ui/src/bridge.rs:443
msgid "Cannot save the setting: {reason}"
msgstr "Asetusta ei voi tallentaa: {reason}"

#: ui/src/bridge.rs:412
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos ladataan seuraavan synkronoinnin yhteydessä"

#: ui/src/bridge.rs:413
msgid "Proton Photos will be left alone"
msgstr "Proton Photos jätetään rauhaan"

#: ui/src/bridge.rs:430
msgid "Storing everything from now on"
msgstr "Tästä lähtien tallennetaan kaikki"

#: ui/src/bridge.rs:431
msgid "Storing warnings and errors from now on"
msgstr "Tästä lähtien tallennetaan varoitukset ja virheet"

#: ui/src/bridge.rs:432
msgid "Storing errors from now on"
msgstr "Tästä lähtien tallennetaan virheet"

#: ui/src/bridge.rs:448
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "poistettiin {n} lokitiedosto, joka oli yli {days} päivää vanha"
msgstr[1] "poistettiin {n} lokitiedostoa, jotka olivat yli {days} päivää vanhoja"

#: ui/src/bridge.rs:449
msgid "Cannot prune the log: {reason}"
msgstr "Lokia ei voi siivota: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "Valitse Proton Drive -kansio"

#: ui/qml/main.qml:38
msgid "The folder is not empty"
msgstr "Kansio ei ole tyhjä"

#: ui/qml/main.qml:73
msgid "Opened {what}"
msgstr "Avattiin {what}"

#: ui/qml/main.qml:75
msgid "Could not open {what} ({url})"
msgstr "Kohdetta {what} ei voitu avata ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:131
msgid "Account"
msgstr "Tili"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:133
msgid "Logs"
msgstr "Loki"

#: ui/qml/main.qml:164
msgid "Not signed in"
msgstr "Ei kirjautunut sisään"

#: ui/qml/main.qml:171
msgid "Signed in to Proton Drive"
msgstr "Kirjauduttu sisään Proton Drive -palveluun"

#: ui/qml/main.qml:172
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Kirjaudu sisään, niin tämä tietokone synkronoidaan Proton Drive -palvelun kanssa."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:193
msgid "Storage"
msgstr "Tallennustila"

#: ui/qml/main.qml:221
msgid "{used} of {total} used"
msgstr "Käytössä {used} / {total}"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:233
msgid "Syncing to"
msgstr "Synkronointikansio"

#: ui/qml/main.qml:237
msgid "nowhere yet"
msgstr "ei vielä valittu"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:244
msgid "Change…"
msgstr "Vaihda…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:251
msgid "Ignore file…"
msgstr "Ohitustiedosto…"

#: ui/qml/main.qml:263
msgid "Also download Proton Photos"
msgstr "Lataa myös Proton Photos"

#: ui/qml/main.qml:271
msgid ""
"Read-only: your timeline is copied into {folder}. Photos are never uploaded, "
"changed or deleted in Proton Photos, and the copy is checked every half hour."
msgstr "Vain luku: aikajanasi kopioidaan tähän kansioon: {folder}. Valokuvia ei koskaan lähetetä, muuteta tai poisteta Proton Photos -palvelussa, ja kopio tarkistetaan puolen tunnin välein."

#: ui/qml/main.qml:272
msgid "your Pictures folder"
msgstr "Kuvat-kansiosi"

#: ui/qml/main.qml:319
msgid "Drive on the web"
msgstr "Drive verkossa"

#: ui/qml/main.qml:324
msgid "Proton account"
msgstr "Proton-tili"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:330
msgid "Refresh"
msgstr "Päivitä"

#: ui/qml/main.qml:336
msgid "Sign in"
msgstr "Kirjaudu sisään"

#: ui/qml/main.qml:379
msgid "Read the licence"
msgstr "Lue lisenssi"

#: ui/qml/main.qml:397
msgid "Search the log"
msgstr "Etsi lokista"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:443
msgid "Copy"
msgstr "Kopioi"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:449
msgid "Select all"
msgstr "Valitse kaikki"

#: ui/qml/main.qml:466
msgid "No lines match"
msgstr "Ei osumia"

#: ui/qml/main.qml:466
msgid "Nothing logged yet"
msgstr "Ei vielä lokimerkintöjä"

#: ui/qml/main.qml:468
msgid "No line since the sync daemon started contains “{term}”."
msgstr "Yksikään rivi ei sisällä hakusanaa ”{term}” synkronointipalvelun käynnistyksen jälkeen."

#: ui/qml/main.qml:469
msgid "This shows what has happened since the sync daemon started."
msgstr "Tässä näkyy, mitä synkronointipalvelun käynnistyksen jälkeen on tapahtunut."

#. TRANSLATORS: start of "Keep logs for [30] days"; the number and "days" follow
#: ui/qml/main.qml:478
msgid "Keep logs for"
msgstr "Säilytä lokeja"

#. TRANSLATORS: end of "Keep logs for [30] days"
#: ui/qml/main.qml:488
msgid "days"
msgstr "päivää"

#. TRANSLATORS: verb, label before a dropdown choosing which log levels are written to disk
#: ui/qml/main.qml:493
msgid "Store"
msgstr "Tallenna"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:501
msgid "Warnings and errors"
msgstr "Varoitukset ja virheet"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:503
msgid "Everything"
msgstr "Kaikki"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:505
msgid "Errors only"
msgstr "Vain virheet"

#: ui/qml/main.qml:514
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} rivi"
msgstr[1] "{n} riviä"

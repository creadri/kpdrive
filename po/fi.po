#: src/daemon.rs:67 src/daemon.rs:174
msgid "Signed out. Sign in from the account window."
msgstr "Kirjauduttu ulos. Kirjaudu sisään tili-ikkunasta."

#: src/daemon.rs:69 src/daemon.rs:535
msgid "Syncing…"
msgstr "Synkronoidaan…"

#: src/daemon.rs:71 src/daemon.rs:538
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} kohde synkronoitu"
msgstr[1] "{n} kohdetta synkronoitu"

#: src/daemon.rs:199 src/daemon.rs:201 ui/qml/main.qml:469
msgid "Open folder"
msgstr "Avaa kansio"

#: src/daemon.rs:211
msgid "Account and logs…"
msgstr "Tili ja loki…"

#: src/daemon.rs:218 ui/qml/main.qml:456
msgid "Sync now"
msgstr "Synkronoi nyt"

#: src/daemon.rs:230
msgid "Pause sync"
msgstr "Keskeytä synkronointi"

#: src/daemon.rs:243
msgid "Quit"
msgstr "Lopeta"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:430
msgid "{reason}; retrying"
msgstr "{reason}; yritetään uudelleen"

#: src/daemon.rs:441
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive on jälleen tavoitettavissa. Katkoksen kesto: {duration}"

#: src/daemon.rs:452
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} sekunti"
msgstr[1] "{n} sekuntia"

#: src/daemon.rs:453
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuutti"
msgstr[1] "{n} minuuttia"

#: src/daemon.rs:454
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} tunti"
msgstr[1] "{n} tuntia"

#: src/daemon.rs:502
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"Synkronointipalvelu ei ole käynnissä. Käynnistä se komennolla: kpdrive sync "
"--watch"

#: src/daemon.rs:505
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Synkronointipalvelu on käynnissä, mutta se on liian vanha kertomaan, mitä se "
"tekee. Käynnistä se uudelleen."

#: src/daemon.rs:516 src/daemon.rs:525
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Kirjauduttu ulos. Synkronointi jatkuu, kun kirjaudut sisään."

#: src/daemon.rs:529
msgid "{reason}. Still trying."
msgstr "{reason}. Yritetään edelleen."

#: src/daemon.rs:530
msgid "Last sync failed: {reason}"
msgstr "Viimeisin synkronointi epäonnistui: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:544
msgid "just now"
msgstr "juuri nyt"

#: src/daemon.rs:546
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} minuutti sitten"
msgstr[1] "{n} minuuttia sitten"

#: src/daemon.rs:549
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} tunti sitten"
msgstr[1] "{n} tuntia sitten"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:553
msgid "{items}, checked {ago}"
msgstr "{items}, tarkistettu {ago}"

#: src/daemon.rs:924
msgid "Signed in again. Syncing resumed."
msgstr "Kirjauduttu uudelleen sisään. Synkronointi jatkuu."

#: src/daemon.rs:938
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Kirjauduttu ulos. Kirjaudu sisään tili-ikkunasta, niin synkronointi jatkuu."

#: src/daemon.rs:1050
msgid "Sync resumed"
msgstr "Synkronointi jatkuu"

#: src/daemon.rs:1067
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} valokuva ladattu"
msgstr[1] "{n} valokuvaa ladattu"

#: src/daemon.rs:1086
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} valokuva lähetetty Proton Photos -palveluun"
msgstr[1] "{n} valokuvaa lähetetty Proton Photos -palveluun"

#: src/i18n.rs:155 ui/qml/main.qml:387
msgid "Sign out"
msgstr "Kirjaudu ulos"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} valokuva"
msgstr[1] "{n} valokuvaa"

#: src/pause.rs:20
msgid "Paused"
msgstr "Keskeytetty"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "Keskeytetty verkkovirtakäytön ajaksi"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "Keskeytetty akkukäytön ajaksi"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "Keskeytetty, kun akun varaus on vähissä"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "Keskeytetty, kun yhdistetty verkkoon {network}"

#: src/sync.rs:124
msgid "Sync into it and keep what is already there"
msgstr "Synkronoi siihen ja säilytä nykyinen sisältö"

#: src/sync.rs:125
msgid "Move it aside and start from an empty folder"
msgstr "Siirrä se sivuun ja aloita tyhjästä kansiosta"

#: src/sync.rs:163
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"{folder} sisältää jo {n} kohteen, joka yhdistetään synkronoinnissa Proton "
"Drive -palveluun."
msgstr[1] ""
"{folder} sisältää jo {n} kohdetta, jotka yhdistetään synkronoinnissa Proton "
"Drive -palveluun."

#: ui/src/bridge.rs:260
msgid "Starting…"
msgstr "Käynnistetään…"

#: ui/src/bridge.rs:317
msgid "Confirm the code {code} in your browser"
msgstr "Vahvista koodi {code} selaimessa"

#: ui/src/bridge.rs:331
msgid "Sign-in failed: {reason}"
msgstr "Sisäänkirjautuminen epäonnistui: {reason}"

#: ui/src/bridge.rs:344
msgid "Signed out"
msgstr "Kirjauduttu ulos"

#: ui/src/bridge.rs:347
msgid "Sign-out failed: {reason}"
msgstr "Uloskirjautuminen epäonnistui: {reason}"

#: ui/src/bridge.rs:355
msgid "Removed {account}. Its files were left where they are."
msgstr "{account} poistettiin. Sen tiedostot jätettiin paikoilleen."

#: ui/src/bridge.rs:362
msgid "Cannot remove the account: {reason}"
msgstr "Tiliä ei voi poistaa: {reason}"

#: ui/src/bridge.rs:481
msgid "Cannot change the folder: {reason}"
msgstr "Kansiota ei voi vaihtaa: {reason}"

#: ui/src/bridge.rs:488
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Synkronointikansiota ei ole vielä. Suorita komento: kpdrive setup"

#: ui/src/bridge.rs:492
msgid "Cannot create the ignore file: {reason}"
msgstr "Ohitustiedostoa ei voi luoda: {reason}"

#: ui/src/bridge.rs:537
msgid "Checking the account…"
msgstr "Tarkistetaan tiliä…"

#: ui/src/bridge.rs:543
msgid "Opening the browser…"
msgstr "Avataan selainta…"

#: ui/src/bridge.rs:550
msgid "Signing out…"
msgstr "Kirjaudutaan ulos…"

#: ui/src/bridge.rs:557
msgid "Removing the account…"
msgstr "Poistetaan tiliä…"

#: ui/src/bridge.rs:583
msgid "Cannot read the log: {reason}"
msgstr "Lokia ei voi lukea: {reason}"

#: ui/src/bridge.rs:591 ui/src/bridge.rs:618 ui/src/bridge.rs:632
#: ui/src/bridge.rs:647 ui/src/bridge.rs:681 ui/src/bridge.rs:723
#: ui/src/bridge.rs:736 ui/src/bridge.rs:754
msgid "Cannot save the setting: {reason}"
msgstr "Asetusta ei voi tallentaa: {reason}"

#: ui/src/bridge.rs:599
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos ladataan seuraavan synkronoinnin yhteydessä"

#: ui/src/bridge.rs:600
msgid "Proton Photos will be left alone"
msgstr "Proton Photos jätetään rauhaan"

#: ui/src/bridge.rs:624
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr "Kansioon laitetut valokuvat lähetetään Proton Photos -palveluun"

#: ui/src/bridge.rs:625
msgid "No longer uploading photos"
msgstr "Valokuvia ei enää lähetetä"

#: ui/src/bridge.rs:717
msgid "Photos will be downloaded into that folder from the next pass"
msgstr "Valokuvat ladataan kansioon seuraavasta kierroksesta alkaen"

#: ui/src/bridge.rs:741
msgid "Storing everything from now on"
msgstr "Tästä lähtien tallennetaan kaikki"

#: ui/src/bridge.rs:742
msgid "Storing warnings and errors from now on"
msgstr "Tästä lähtien tallennetaan varoitukset ja virheet"

#: ui/src/bridge.rs:743
msgid "Storing errors from now on"
msgstr "Tästä lähtien tallennetaan virheet"

#: ui/src/bridge.rs:759
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "poistettiin {n} lokitiedosto, joka oli yli {days} päivää vanha"
msgstr[1] ""
"poistettiin {n} lokitiedostoa, jotka olivat yli {days} päivää vanhoja"

#: ui/src/bridge.rs:760
msgid "Cannot prune the log: {reason}"
msgstr "Lokia ei voi siivota: {reason}"

#: ui/qml/main.qml:28
msgid "Choose the Proton Drive folder"
msgstr "Valitse Proton Drive -kansio"

#: ui/qml/main.qml:35
msgid "Choose where Proton Photos are downloaded"
msgstr "Valitse, minne Proton Photos ladataan"

#: ui/qml/main.qml:42
msgid "Choose the folder to upload photos from"
msgstr "Valitse kansio, josta valokuvat lähetetään"

#: ui/qml/main.qml:53
msgid "The folder is not empty"
msgstr "Kansio ei ole tyhjä"

#: ui/qml/main.qml:80
msgid "Remove {account}?"
msgstr "Poistetaanko {account}?"

#: ui/qml/main.qml:81
msgid ""
"kpdrive signs this account out and forgets what it synced. The files in "
"{folder} stay where they are."
msgstr ""
"kpdrive kirjaa tämän tilin ulos ja unohtaa, mitä se on synkronoinut. "
"Tiedostot jäävät paikoilleen ({folder})."

#: ui/qml/main.qml:82
msgid "its folder"
msgstr "tilin kansio"

#: ui/qml/main.qml:86
msgid "Remove account"
msgstr "Poista tili"

#: ui/qml/main.qml:94
msgid "Cancel"
msgstr "Peruuta"

#: ui/qml/main.qml:130
msgid "Opened {what}"
msgstr "Avattiin {what}"

#: ui/qml/main.qml:132
msgid "Could not open {what} ({url})"
msgstr "Kohdetta {what} ei voitu avata ({url})"

#: ui/qml/main.qml:223 ui/qml/main.qml:225
msgid "Add account"
msgstr "Lisää tili"

#: ui/qml/main.qml:237
msgid "Account & activity"
msgstr "Tili ja toiminta"

#: ui/qml/main.qml:238
msgid "Settings"
msgstr "Asetukset"

#: ui/qml/main.qml:239 ui/qml/main.qml:701
msgid "Logs"
msgstr "Loki"

#: ui/qml/main.qml:240
msgid "About"
msgstr "Tietoja"

#: ui/qml/main.qml:320
msgid "Not signed in"
msgstr "Ei kirjautunut sisään"

#: ui/qml/main.qml:327
msgid "Signed in to Proton Drive"
msgstr "Kirjauduttu sisään Proton Drive -palveluun"

#: ui/qml/main.qml:329
msgid "Signed out. Sign in again to resume syncing this account."
msgstr ""
"Kirjauduttu ulos. Kirjaudu uudelleen sisään, niin tämän tilin synkronointi "
"jatkuu."

#: ui/qml/main.qml:330
msgid "Sign in to sync this computer with Proton Drive."
msgstr ""
"Kirjaudu sisään, niin tämä tietokone synkronoidaan Proton Drive -palvelun "
"kanssa."

#: ui/qml/main.qml:347
msgid "Storage:"
msgstr "Tallennustila:"

#: ui/qml/main.qml:376
msgid "{used} of {total} used"
msgstr "Käytössä {used} / {total}"

#: ui/qml/main.qml:384 ui/qml/main.qml:489
msgid "Account:"
msgstr "Tili:"

#: ui/qml/main.qml:387
msgid "Sign in"
msgstr "Kirjaudu sisään"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:394
msgid "Refresh"
msgstr "Päivitä"

#: ui/qml/main.qml:401
msgid "Remove account…"
msgstr "Poista tili…"

#: ui/qml/main.qml:410
msgid "On the web:"
msgstr "Verkossa:"


#: src/daemon.rs:67 src/daemon.rs:174
msgid "Signed out. Sign in from the account window."
msgstr "Виконано вихід. Увійдіть у вікні облікового запису."

#: src/daemon.rs:69 src/daemon.rs:535
msgid "Syncing…"
msgstr "Синхронізація…"

#: src/daemon.rs:71 src/daemon.rs:538
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} елемент синхронізовано"
msgstr[1] "{n} елементи синхронізовано"
msgstr[2] "{n} елементів синхронізовано"

#: src/daemon.rs:199 src/daemon.rs:201 ui/qml/main.qml:469
msgid "Open folder"
msgstr "Відкрити теку"

#: src/daemon.rs:211
msgid "Account and logs…"
msgstr "Обліковий запис і журнал…"

#: src/daemon.rs:218 ui/qml/main.qml:456
msgid "Sync now"
msgstr "Синхронізувати зараз"

#: src/daemon.rs:230
msgid "Pause sync"
msgstr "Призупинити синхронізацію"

#: src/daemon.rs:243
msgid "Quit"
msgstr "Завершити роботу"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:430
msgid "{reason}; retrying"
msgstr "{reason}; виконується повторна спроба"

#: src/daemon.rs:441
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive знову доступний ({duration})"

#: src/daemon.rs:452
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} секунда"
msgstr[1] "{n} секунди"
msgstr[2] "{n} секунд"

#: src/daemon.rs:453
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} хвилина"
msgstr[1] "{n} хвилини"
msgstr[2] "{n} хвилин"

#: src/daemon.rs:454
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} година"
msgstr[1] "{n} години"
msgstr[2] "{n} годин"

#: src/daemon.rs:502
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"Службу синхронізації не запущено. Запустіть її командою: kpdrive sync --watch"

#: src/daemon.rs:505
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Службу синхронізації запущено, але вона надто стара, щоб повідомити, що "
"робить. Перезапустіть її."

#: src/daemon.rs:516 src/daemon.rs:525
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Виконано вихід. Синхронізація відновиться після входу."

#: src/daemon.rs:529
msgid "{reason}. Still trying."
msgstr "{reason}. Спроби тривають."

#: src/daemon.rs:530
msgid "Last sync failed: {reason}"
msgstr "Не вдалося виконати останню синхронізацію: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:544
msgid "just now"
msgstr "щойно"

#: src/daemon.rs:546
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} хвилину тому"
msgstr[1] "{n} хвилини тому"
msgstr[2] "{n} хвилин тому"

#: src/daemon.rs:549
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} годину тому"
msgstr[1] "{n} години тому"
msgstr[2] "{n} годин тому"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:553
msgid "{items}, checked {ago}"
msgstr "{items}, перевірено {ago}"

#: src/daemon.rs:924
msgid "Signed in again. Syncing resumed."
msgstr "Вхід виконано знову. Синхронізацію відновлено."

#: src/daemon.rs:938
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Виконано вихід. Увійдіть у вікні облікового запису, щоб відновити "
"синхронізацію."

#: src/daemon.rs:1050
msgid "Sync resumed"
msgstr "Синхронізацію відновлено"

#: src/daemon.rs:1067
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "Завантажено {n} фотографію"
msgstr[1] "Завантажено {n} фотографії"
msgstr[2] "Завантажено {n} фотографій"

#: src/daemon.rs:1086
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} фотографію вивантажено до Proton Photos"
msgstr[1] "{n} фотографії вивантажено до Proton Photos"
msgstr[2] "{n} фотографій вивантажено до Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:387
msgid "Sign out"
msgstr "Вийти"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} фотографія"
msgstr[1] "{n} фотографії"
msgstr[2] "{n} фотографій"

#: src/pause.rs:20
msgid "Paused"
msgstr "Призупинено"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "Призупинено під час живлення від мережі"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "Призупинено під час живлення від акумулятора"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "Призупинено через низький рівень заряду акумулятора"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "Призупинено під час з'єднання з {network}"

#: src/sync.rs:124
msgid "Sync into it and keep what is already there"
msgstr "Синхронізувати в неї та зберегти те, що в ній уже є"

#: src/sync.rs:125
msgid "Move it aside and start from an empty folder"
msgstr "Відкласти її вбік і почати з порожньої теки"

#: src/sync.rs:163
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"У теці {folder} уже є {n} елемент. Синхронізація об’єднає її вміст із Proton "
"Drive."
msgstr[1] ""
"У теці {folder} уже є {n} елементи. Синхронізація об’єднає її вміст із "
"Proton Drive."
msgstr[2] ""
"У теці {folder} уже є {n} елементів. Синхронізація об’єднає її вміст із "
"Proton Drive."

#: ui/src/bridge.rs:260
msgid "Starting…"
msgstr "Запуск…"

#: ui/src/bridge.rs:317
msgid "Confirm the code {code} in your browser"
msgstr "Підтвердьте код {code} у браузері"

#: ui/src/bridge.rs:331
msgid "Sign-in failed: {reason}"
msgstr "Не вдалося увійти: {reason}"

#: ui/src/bridge.rs:344
msgid "Signed out"
msgstr "Виконано вихід"

#: ui/src/bridge.rs:347
msgid "Sign-out failed: {reason}"
msgstr "Не вдалося вийти: {reason}"

#: ui/src/bridge.rs:355
msgid "Removed {account}. Its files were left where they are."
msgstr "Обліковий запис {account} вилучено. Його файли залишилися на місці."

#: ui/src/bridge.rs:362
msgid "Cannot remove the account: {reason}"
msgstr "Не вдалося вилучити обліковий запис: {reason}"

#: ui/src/bridge.rs:481
msgid "Cannot change the folder: {reason}"
msgstr "Не вдалося змінити теку: {reason}"

#: ui/src/bridge.rs:488
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Теку для синхронізації ще не вибрано. Виконайте: kpdrive setup"

#: ui/src/bridge.rs:492
msgid "Cannot create the ignore file: {reason}"
msgstr "Не вдалося створити файл виключень: {reason}"

#: ui/src/bridge.rs:537
msgid "Checking the account…"
msgstr "Перевірка облікового запису…"

#: ui/src/bridge.rs:543
msgid "Opening the browser…"
msgstr "Відкриття браузера…"

#: ui/src/bridge.rs:550
msgid "Signing out…"
msgstr "Виконується вихід…"

#: ui/src/bridge.rs:557
msgid "Removing the account…"
msgstr "Вилучення облікового запису…"

#: ui/src/bridge.rs:583
msgid "Cannot read the log: {reason}"
msgstr "Не вдалося прочитати журнал: {reason}"

#: ui/src/bridge.rs:591 ui/src/bridge.rs:618 ui/src/bridge.rs:632
#: ui/src/bridge.rs:647 ui/src/bridge.rs:681 ui/src/bridge.rs:723
#: ui/src/bridge.rs:736 ui/src/bridge.rs:754
msgid "Cannot save the setting: {reason}"
msgstr "Не вдалося зберегти параметр: {reason}"

#: ui/src/bridge.rs:599
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos буде завантажено під час наступної синхронізації"

#: ui/src/bridge.rs:600
msgid "Proton Photos will be left alone"
msgstr "Proton Photos залишиться без змін"

#: ui/src/bridge.rs:624
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr "Фотографії, поміщені до цієї теки, буде вивантажено до Proton Photos"

#: ui/src/bridge.rs:625
msgid "No longer uploading photos"
msgstr "Фотографії більше не вивантажуються"

#: ui/src/bridge.rs:717
msgid "Photos will be downloaded into that folder from the next pass"
msgstr ""
"Фотографії буде завантажено до цієї теки, починаючи з наступної синхронізації"

#: ui/src/bridge.rs:741
msgid "Storing everything from now on"
msgstr "Відтепер зберігається все"

#: ui/src/bridge.rs:742
msgid "Storing warnings and errors from now on"
msgstr "Відтепер зберігаються попередження та помилки"

#: ui/src/bridge.rs:743
msgid "Storing errors from now on"
msgstr "Відтепер зберігаються лише помилки"

#: ui/src/bridge.rs:759
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "вилучено {n} файл журналу, старіший за {days} днів"
msgstr[1] "вилучено {n} файли журналу, старіші за {days} днів"
msgstr[2] "вилучено {n} файлів журналу, старіших за {days} днів"

#: ui/src/bridge.rs:760
msgid "Cannot prune the log: {reason}"
msgstr "Не вдалося очистити журнал: {reason}"

#: ui/qml/main.qml:28
msgid "Choose the Proton Drive folder"
msgstr "Виберіть теку для Proton Drive"

#: ui/qml/main.qml:35
msgid "Choose where Proton Photos are downloaded"
msgstr "Виберіть, куди завантажувати Proton Photos"

#: ui/qml/main.qml:42

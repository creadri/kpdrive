#: src/daemon.rs:98
msgid "Signed out. Sign in from the account window."
msgstr "Виконано вихід. Увійдіть у вікні облікового запису."

#: src/daemon.rs:100 src/daemon.rs:341
msgid "Syncing…"
msgstr "Синхронізація…"

#: src/daemon.rs:102 src/daemon.rs:344
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} елемент синхронізовано"
msgstr[1] "{n} елементи синхронізовано"
msgstr[2] "{n} елементів синхронізовано"

#: src/daemon.rs:112 ui/qml/main.qml:313
msgid "Open folder"
msgstr "Відкрити теку"

#: src/daemon.rs:122
msgid "Account and logs…"
msgstr "Обліковий запис і журнал…"

#: src/daemon.rs:129 ui/qml/main.qml:291
msgid "Sync now"
msgstr "Синхронізувати зараз"

#: src/daemon.rs:139
msgid "Quit"
msgstr "Завершити роботу"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:273
msgid "{reason}; retrying"
msgstr "{reason}; виконується повторна спроба"

#: src/daemon.rs:284
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive знову доступний ({duration})"

#: src/daemon.rs:295
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} секунда"
msgstr[1] "{n} секунди"
msgstr[2] "{n} секунд"

#: src/daemon.rs:296
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} хвилина"
msgstr[1] "{n} хвилини"
msgstr[2] "{n} хвилин"

#: src/daemon.rs:297
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} година"
msgstr[1] "{n} години"
msgstr[2] "{n} годин"

#: src/daemon.rs:325
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "Службу синхронізації не запущено. Запустіть її командою: kpdrive sync --watch"

#: src/daemon.rs:328
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr "Службу синхронізації запущено, але вона надто стара, щоб повідомити, що робить. Перезапустіть її."

#: src/daemon.rs:331
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Виконано вихід. Синхронізація відновиться після входу."

#: src/daemon.rs:335
msgid "{reason}. Still trying."
msgstr "{reason}. Спроби тривають."

#: src/daemon.rs:336
msgid "Last sync failed: {reason}"
msgstr "Не вдалося виконати останню синхронізацію: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:350
msgid "just now"
msgstr "щойно"

#: src/daemon.rs:352
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} хвилину тому"
msgstr[1] "{n} хвилини тому"
msgstr[2] "{n} хвилин тому"

#: src/daemon.rs:355
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} годину тому"
msgstr[1] "{n} години тому"
msgstr[2] "{n} годин тому"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:359
msgid "{items}, checked {ago}"
msgstr "{items}, перевірено {ago}"

#: src/daemon.rs:576
msgid "Signed in again. Syncing resumed."
msgstr "Вхід виконано знову. Синхронізацію відновлено."

#: src/daemon.rs:630
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "Виконано вихід. Увійдіть у вікні облікового запису, щоб відновити синхронізацію."

#: src/daemon.rs:663
msgid "Sync resumed"
msgstr "Синхронізацію відновлено"

#: src/daemon.rs:680
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "Завантажено {n} фотографію"
msgstr[1] "Завантажено {n} фотографії"
msgstr[2] "Завантажено {n} фотографій"

#: src/i18n.rs:111 ui/qml/main.qml:336
msgid "Sign out"
msgstr "Вийти"

#: src/i18n.rs:112 src/i18n.rs:113
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} фотографія"
msgstr[1] "{n} фотографії"
msgstr[2] "{n} фотографій"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Синхронізувати в неї та зберегти те, що в ній уже є"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Відкласти її вбік і почати з порожньої теки"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] "У теці {folder} уже є {n} елемент. Синхронізація об’єднає її вміст із Proton Drive."
msgstr[1] "У теці {folder} уже є {n} елементи. Синхронізація об’єднає її вміст із Proton Drive."
msgstr[2] "У теці {folder} уже є {n} елементів. Синхронізація об’єднає її вміст із Proton Drive."

#: ui/src/bridge.rs:175
msgid "Starting…"
msgstr "Запуск…"

#: ui/src/bridge.rs:217
msgid "Confirm the code {code} in your browser"
msgstr "Підтвердьте код {code} у браузері"

#: ui/src/bridge.rs:231
msgid "Sign-in failed: {reason}"
msgstr "Не вдалося увійти: {reason}"

#: ui/src/bridge.rs:243
msgid "Signed out"
msgstr "Виконано вихід"

#: ui/src/bridge.rs:246
msgid "Sign-out failed: {reason}"
msgstr "Не вдалося вийти: {reason}"

#: ui/src/bridge.rs:305
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Перезапустіть службу синхронізації, щоб зміна набула чинності."

#: ui/src/bridge.rs:308
msgid "Cannot change the folder: {reason}"
msgstr "Не вдалося змінити теку: {reason}"

#: ui/src/bridge.rs:315
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Теку для синхронізації ще не вибрано. Виконайте: kpdrive setup"

#: ui/src/bridge.rs:319
msgid "Cannot create the ignore file: {reason}"
msgstr "Не вдалося створити файл виключень: {reason}"

#: ui/src/bridge.rs:356
msgid "Checking the account…"
msgstr "Перевірка облікового запису…"

#: ui/src/bridge.rs:362
msgid "Opening the browser…"
msgstr "Відкриття браузера…"

#: ui/src/bridge.rs:368
msgid "Signing out…"
msgstr "Виконується вихід…"

#: ui/src/bridge.rs:394
msgid "Cannot read the log: {reason}"
msgstr "Не вдалося прочитати журнал: {reason}"

#: ui/src/bridge.rs:404 ui/src/bridge.rs:425 ui/src/bridge.rs:443
msgid "Cannot save the setting: {reason}"
msgstr "Не вдалося зберегти параметр: {reason}"

#: ui/src/bridge.rs:412
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos буде завантажено під час наступної синхронізації"

#: ui/src/bridge.rs:413
msgid "Proton Photos will be left alone"
msgstr "Proton Photos залишиться без змін"

#: ui/src/bridge.rs:430
msgid "Storing everything from now on"
msgstr "Відтепер зберігається все"

#: ui/src/bridge.rs:431
msgid "Storing warnings and errors from now on"
msgstr "Відтепер зберігаються попередження та помилки"

#: ui/src/bridge.rs:432
msgid "Storing errors from now on"
msgstr "Відтепер зберігаються лише помилки"

#: ui/src/bridge.rs:448
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "вилучено {n} файл журналу, старіший за {days} днів"
msgstr[1] "вилучено {n} файли журналу, старіші за {days} днів"
msgstr[2] "вилучено {n} файлів журналу, старіших за {days} днів"

#: ui/src/bridge.rs:449
msgid "Cannot prune the log: {reason}"
msgstr "Не вдалося очистити журнал: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "Виберіть теку для Proton Drive"

#: ui/qml/main.qml:38
msgid "The folder is not empty"
msgstr "Тека не порожня"

#: ui/qml/main.qml:73
msgid "Opened {what}"
msgstr "Відкрито: {what}"

#: ui/qml/main.qml:75
msgid "Could not open {what} ({url})"
msgstr "Не вдалося відкрити: {what} ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:131
msgid "Account"
msgstr "Обліковий запис"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:133
msgid "Logs"
msgstr "Журнал"

#: ui/qml/main.qml:164
msgid "Not signed in"
msgstr "Вхід не виконано"

#: ui/qml/main.qml:171
msgid "Signed in to Proton Drive"
msgstr "Виконано вхід до Proton Drive"

#: ui/qml/main.qml:172
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Увійдіть, щоб синхронізувати цей комп’ютер із Proton Drive."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:193
msgid "Storage"
msgstr "Сховище"

#: ui/qml/main.qml:221
msgid "{used} of {total} used"
msgstr "Використано {used} з {total}"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:233
msgid "Syncing to"
msgstr "Тека синхронізації"

#: ui/qml/main.qml:237
msgid "nowhere yet"
msgstr "ще не вибрано"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:244
msgid "Change…"
msgstr "Змінити…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:251
msgid "Ignore file…"
msgstr "Файл виключень…"

#: ui/qml/main.qml:263
msgid "Also download Proton Photos"
msgstr "Також завантажувати Proton Photos"

#: ui/qml/main.qml:271
msgid ""
"Read-only: your timeline is copied into {folder}. Photos are never uploaded, "
"changed or deleted in Proton Photos, and the copy is checked every half hour."
msgstr "Лише читання: вашу стрічку копіюють сюди: {folder}. Фотографії ніколи не вивантажуються, не змінюються і не вилучаються в Proton Photos, а копія перевіряється щопівгодини."

#: ui/qml/main.qml:272
msgid "your Pictures folder"
msgstr "тека «Зображення»"

#: ui/qml/main.qml:319
msgid "Drive on the web"
msgstr "Drive у браузері"

#: ui/qml/main.qml:324
msgid "Proton account"
msgstr "Обліковий запис Proton"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:330
msgid "Refresh"
msgstr "Оновити"

#: ui/qml/main.qml:336
msgid "Sign in"
msgstr "Увійти"

#: ui/qml/main.qml:379
msgid "Read the licence"
msgstr "Прочитати ліцензію"

#: ui/qml/main.qml:397
msgid "Search the log"
msgstr "Пошук у журналі"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:443
msgid "Copy"
msgstr "Копіювати"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:449
msgid "Select all"
msgstr "Вибрати все"

#: ui/qml/main.qml:466
msgid "No lines match"
msgstr "Немає відповідних рядків"

#: ui/qml/main.qml:466
msgid "Nothing logged yet"
msgstr "Записів ще немає"

#: ui/qml/main.qml:468
msgid "No line since the sync daemon started contains “{term}”."
msgstr "Жоден рядок від запуску служби синхронізації не містить «{term}»."

#: ui/qml/main.qml:469
msgid "This shows what has happened since the sync daemon started."
msgstr "Тут показано, що сталося від запуску служби синхронізації."

#. TRANSLATORS: start of "Keep logs for [30] days"; the number and "days" follow
#: ui/qml/main.qml:478
msgid "Keep logs for"
msgstr "Зберігати журнал"

#. TRANSLATORS: end of "Keep logs for [30] days"
#: ui/qml/main.qml:488
msgid "days"
msgstr "днів"

#. TRANSLATORS: verb, label before a dropdown choosing which log levels are written to disk
#: ui/qml/main.qml:493
msgid "Store"
msgstr "Записувати"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:501
msgid "Warnings and errors"
msgstr "Попередження та помилки"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:503
msgid "Everything"
msgstr "Усе"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:505
msgid "Errors only"
msgstr "Лише помилки"

#: ui/qml/main.qml:514
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} рядок"
msgstr[1] "{n} рядки"
msgstr[2] "{n} рядків"

#: ui/src/bridge.rs:385
msgid "Cannot change the folder: {reason}"
msgstr "Не вдалося змінити теку: {reason}"

#: ui/src/bridge.rs:392
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Теку для синхронізації ще не вибрано. Виконайте: kpdrive setup"

#: ui/src/bridge.rs:396
msgid "Cannot create the ignore file: {reason}"
msgstr "Не вдалося створити файл виключень: {reason}"

#: ui/src/bridge.rs:434
msgid "Checking the account…"
msgstr "Перевірка облікового запису…"

#: ui/src/bridge.rs:440
msgid "Opening the browser…"
msgstr "Відкриття браузера…"

#: ui/src/bridge.rs:446
msgid "Signing out…"
msgstr "Виконується вихід…"

#: ui/src/bridge.rs:472
msgid "Cannot read the log: {reason}"
msgstr "Не вдалося прочитати журнал: {reason}"

#: ui/src/bridge.rs:482 ui/src/bridge.rs:510 ui/src/bridge.rs:524
#: ui/src/bridge.rs:539 ui/src/bridge.rs:573 ui/src/bridge.rs:614
#: ui/src/bridge.rs:627 ui/src/bridge.rs:645
msgid "Cannot save the setting: {reason}"
msgstr "Не вдалося зберегти параметр: {reason}"

#: ui/src/bridge.rs:490
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos буде завантажено під час наступної синхронізації"

#: ui/src/bridge.rs:491
msgid "Proton Photos will be left alone"
msgstr "Proton Photos залишиться без змін"

#: ui/src/bridge.rs:516
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr "Фотографії, поміщені до цієї теки, буде вивантажено до Proton Photos"

#: ui/src/bridge.rs:517
msgid "No longer uploading photos"
msgstr "Фотографії більше не вивантажуються"

#: ui/src/bridge.rs:607
msgid "Photos will be downloaded into that folder from the next pass"
msgstr ""
"Фотографії буде завантажено до цієї теки, починаючи з наступної синхронізації"

#: ui/src/bridge.rs:632
msgid "Storing everything from now on"
msgstr "Відтепер зберігається все"

#: ui/src/bridge.rs:633
msgid "Storing warnings and errors from now on"
msgstr "Відтепер зберігаються попередження та помилки"

#: ui/src/bridge.rs:634
msgid "Storing errors from now on"
msgstr "Відтепер зберігаються лише помилки"

#: ui/src/bridge.rs:650
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "вилучено {n} файл журналу, старіший за {days} днів"
msgstr[1] "вилучено {n} файли журналу, старіші за {days} днів"
msgstr[2] "вилучено {n} файлів журналу, старіших за {days} днів"

#: ui/src/bridge.rs:651
msgid "Cannot prune the log: {reason}"
msgstr "Не вдалося очистити журнал: {reason}"


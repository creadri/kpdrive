#: src/daemon.rs:102
msgid "Signed out. Sign in from the account window."
msgstr "Αποσυνδεθήκατε. Συνδεθείτε από το παράθυρο λογαριασμού."

#: src/daemon.rs:104 src/daemon.rs:371
msgid "Syncing…"
msgstr "Συγχρονισμός…"

#: src/daemon.rs:106 src/daemon.rs:374
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} αντικείμενο σε συγχρονισμό"
msgstr[1] "{n} αντικείμενα σε συγχρονισμό"

#: src/daemon.rs:116 ui/qml/main.qml:382
msgid "Open folder"
msgstr "Άνοιγμα φακέλου"

#: src/daemon.rs:126
msgid "Account and logs…"
msgstr "Λογαριασμός και καταγραφές…"

#: src/daemon.rs:133 ui/qml/main.qml:360
msgid "Sync now"
msgstr "Συγχρονισμός τώρα"

#: src/daemon.rs:143
msgid "Quit"
msgstr "Έξοδος"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:303
msgid "{reason}; retrying"
msgstr "{reason}· νέα προσπάθεια"

#: src/daemon.rs:314
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Το Proton Drive είναι ξανά προσβάσιμο, μετά από {duration}"

#: src/daemon.rs:325
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} δευτερόλεπτο"
msgstr[1] "{n} δευτερόλεπτα"

#: src/daemon.rs:326
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} λεπτό"
msgstr[1] "{n} λεπτά"

#: src/daemon.rs:327
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} ώρα"
msgstr[1] "{n} ώρες"

#: src/daemon.rs:355
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"Η υπηρεσία συγχρονισμού δεν εκτελείται. Εκκινήστε την με: kpdrive sync --"
"watch"

#: src/daemon.rs:358
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Εκτελείται μια υπηρεσία συγχρονισμού, αλλά είναι πολύ παλιά για να αναφέρει "
"τι κάνει. Επανεκκινήστε την."

#: src/daemon.rs:361
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Αποσυνδεθήκατε. Ο συγχρονισμός θα συνεχιστεί μόλις συνδεθείτε."

#: src/daemon.rs:365
msgid "{reason}. Still trying."
msgstr "{reason}. Συνεχίζεται η προσπάθεια."

#: src/daemon.rs:366
msgid "Last sync failed: {reason}"
msgstr "Ο τελευταίος συγχρονισμός απέτυχε: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:380
msgid "just now"
msgstr "μόλις τώρα"

#: src/daemon.rs:382
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "πριν από {n} λεπτό"
msgstr[1] "πριν από {n} λεπτά"

#: src/daemon.rs:385
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "πριν από {n} ώρα"
msgstr[1] "πριν από {n} ώρες"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:389
msgid "{items}, checked {ago}"
msgstr "{items}, τελευταίος έλεγχος {ago}"

#: src/daemon.rs:606
msgid "Signed in again. Syncing resumed."
msgstr "Συνδεθήκατε ξανά. Ο συγχρονισμός συνεχίστηκε."

#: src/daemon.rs:660
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Αποσυνδεθήκατε. Συνδεθείτε από το παράθυρο λογαριασμού για να συνεχιστεί ο "
"συγχρονισμός."

#: src/daemon.rs:693
msgid "Sync resumed"
msgstr "Ο συγχρονισμός συνεχίστηκε"

#: src/daemon.rs:710
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "Λήψη {n} φωτογραφίας"
msgstr[1] "Λήψη {n} φωτογραφιών"

#: src/daemon.rs:731
#, fuzzy
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "Λήψη και του Proton Photos"
msgstr[1] "Λήψη και του Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:405
msgid "Sign out"
msgstr "Αποσύνδεση"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} φωτογραφία"
msgstr[1] "{n} φωτογραφίες"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Συγχρονισμός μέσα σε αυτόν, διατηρώντας τα υπάρχοντα"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Μετακίνησή του στην άκρη και έναρξη από κενό φάκελο"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"Ο φάκελος {folder} περιέχει ήδη {n} αντικείμενο, το οποίο ο συγχρονισμός θα "
"συγχωνεύσει με το Proton Drive."
msgstr[1] ""
"Ο φάκελος {folder} περιέχει ήδη {n} αντικείμενα, τα οποία ο συγχρονισμός θα "
"συγχωνεύσει με το Proton Drive."

#: ui/src/bridge.rs:189
msgid "Starting…"
msgstr "Έναρξη…"

#: ui/src/bridge.rs:233
msgid "Confirm the code {code} in your browser"
msgstr "Επιβεβαιώστε τον κωδικό {code} στο πρόγραμμα περιήγησης"

#: ui/src/bridge.rs:247
msgid "Sign-in failed: {reason}"
msgstr "Η σύνδεση απέτυχε: {reason}"

#: ui/src/bridge.rs:259
msgid "Signed out"
msgstr "Αποσυνδεθήκατε"

#: ui/src/bridge.rs:262
msgid "Sign-out failed: {reason}"
msgstr "Η αποσύνδεση απέτυχε: {reason}"

#: ui/src/bridge.rs:324
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Επανεκκινήστε την υπηρεσία συγχρονισμού για να χρησιμοποιηθεί."

#: ui/src/bridge.rs:327
msgid "Cannot change the folder: {reason}"
msgstr "Αδυναμία αλλαγής του φακέλου: {reason}"

#: ui/src/bridge.rs:334
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Δεν έχει οριστεί ακόμη φάκελος συγχρονισμού. Εκτελέστε: kpdrive setup"

#: ui/src/bridge.rs:338
msgid "Cannot create the ignore file: {reason}"
msgstr "Αδυναμία δημιουργίας του αρχείου παράβλεψης: {reason}"

#: ui/src/bridge.rs:375
msgid "Checking the account…"
msgstr "Έλεγχος του λογαριασμού…"

#: ui/src/bridge.rs:381
msgid "Opening the browser…"
msgstr "Άνοιγμα του προγράμματος περιήγησης…"

#: ui/src/bridge.rs:387
msgid "Signing out…"
msgstr "Αποσύνδεση…"

#: ui/src/bridge.rs:413
msgid "Cannot read the log: {reason}"
msgstr "Αδυναμία ανάγνωσης της καταγραφής: {reason}"

#: ui/src/bridge.rs:423 ui/src/bridge.rs:451 ui/src/bridge.rs:467
#: ui/src/bridge.rs:480 ui/src/bridge.rs:498
msgid "Cannot save the setting: {reason}"
msgstr "Αδυναμία αποθήκευσης της ρύθμισης: {reason}"

#: ui/src/bridge.rs:431
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Το Proton Photos θα ληφθεί με τον επόμενο συγχρονισμό"

#: ui/src/bridge.rs:432
msgid "Proton Photos will be left alone"
msgstr "Το Proton Photos δεν θα πειραχτεί"

#: ui/src/bridge.rs:457
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr ""

#: ui/src/bridge.rs:458
msgid "No longer uploading photos"
msgstr ""

#: ui/src/bridge.rs:485
msgid "Storing everything from now on"
msgstr "Από τώρα αποθηκεύονται τα πάντα"

#: ui/src/bridge.rs:486
msgid "Storing warnings and errors from now on"
msgstr "Από τώρα αποθηκεύονται προειδοποιήσεις και σφάλματα"

#: ui/src/bridge.rs:487
msgid "Storing errors from now on"
msgstr "Από τώρα αποθηκεύονται μόνο τα σφάλματα"

#: ui/src/bridge.rs:503
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "αφαιρέθηκε {n} αρχείο καταγραφής παλαιότερο από {days} ημέρες"
msgstr[1] "αφαιρέθηκαν {n} αρχεία καταγραφής παλαιότερα από {days} ημέρες"

#: ui/src/bridge.rs:504
msgid "Cannot prune the log: {reason}"
msgstr "Αδυναμία εκκαθάρισης της καταγραφής: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "Επιλέξτε τον φάκελο του Proton Drive"

#: ui/qml/main.qml:34
msgid "Choose the folder to upload photos from"
msgstr ""

#: ui/qml/main.qml:45
msgid "The folder is not empty"
msgstr "Ο φάκελος δεν είναι κενός"

#: ui/qml/main.qml:80
msgid "Opened {what}"
msgstr "Άνοιξε: {what}"

#: ui/qml/main.qml:82
msgid "Could not open {what} ({url})"
msgstr "Αδυναμία ανοίγματος: {what} ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:138
msgid "Account"
msgstr "Λογαριασμός"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:140
msgid "Logs"
msgstr "Καταγραφές"

#: ui/qml/main.qml:177
msgid "Not signed in"
msgstr "Δεν έχετε συνδεθεί"

#: ui/qml/main.qml:184
msgid "Signed in to Proton Drive"
msgstr "Συνδεδεμένοι στο Proton Drive"

#: ui/qml/main.qml:185
msgid "Sign in to sync this computer with Proton Drive."
msgstr ""
"Συνδεθείτε για να συγχρονίσετε αυτόν τον υπολογιστή με το Proton Drive."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:206
msgid "Storage"
msgstr "Αποθηκευτικός χώρος"

#: ui/qml/main.qml:234
msgid "{used} of {total} used"
msgstr "{used} από {total} σε χρήση"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:246
msgid "Syncing to"
msgstr "Συγχρονισμός στο"

#: ui/qml/main.qml:250
msgid "nowhere yet"
msgstr "πουθενά ακόμη"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:257 ui/qml/main.qml:324
msgid "Change…"
msgstr "Αλλαγή…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:264
msgid "Ignore file…"
msgstr "Αρχείο παράβλεψης…"

#: ui/qml/main.qml:276
msgid "Also download Proton Photos"
msgstr "Λήψη και του Proton Photos"

#: ui/qml/main.qml:284
#, fuzzy
msgid ""
"Your timeline is copied into {folder}, checked every half hour. Nothing in "
"Proton Photos is changed or deleted by it."
msgstr ""
"Μόνο για ανάγνωση: δημιουργείται αντίγραφο του χρονολογίου σας. Θέση "
"αντιγράφου: {folder}. Οι φωτογραφίες δεν αποστέλλονται, δεν τροποποιούνται "
"και δεν διαγράφονται ποτέ στο Proton Photos, και το αντίγραφο ελέγχεται κάθε "
"μισή ώρα."

#: ui/qml/main.qml:285
msgid "your Pictures folder"
msgstr "ο φάκελος Εικόνες σας"

#: ui/qml/main.qml:297
msgid "Upload photos from a folder"
msgstr ""

#: ui/qml/main.qml:333
msgid "Delete uploaded photos instead of moving them to the trash"
msgstr ""

#: ui/qml/main.qml:341
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""

#: ui/qml/main.qml:388
msgid "Drive on the web"
msgstr "Το Drive στο διαδίκτυο"

#: ui/qml/main.qml:393
msgid "Proton account"
msgstr "Λογαριασμός Proton"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:399
msgid "Refresh"
msgstr "Ανανέωση"

#: ui/qml/main.qml:405
msgid "Sign in"
msgstr "Σύνδεση"

#: ui/qml/main.qml:448
msgid "Read the licence"
msgstr "Ανάγνωση της άδειας χρήσης"

#: ui/qml/main.qml:466
msgid "Search the log"
msgstr "Αναζήτηση στην καταγραφή"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:512
msgid "Copy"
msgstr "Αντιγραφή"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:518
msgid "Select all"
msgstr "Επιλογή όλων"

#: ui/qml/main.qml:535
msgid "No lines match"
msgstr "Καμία γραμμή δεν ταιριάζει"

#: ui/qml/main.qml:535
msgid "Nothing logged yet"
msgstr "Δεν έχει καταγραφεί τίποτα ακόμη"

#: ui/qml/main.qml:537
msgid "No line since the sync daemon started contains “{term}”."
msgstr ""
"Καμία γραμμή από την εκκίνηση της υπηρεσίας συγχρονισμού δεν περιέχει "
"«{term}»."

#: ui/qml/main.qml:538
msgid "This shows what has happened since the sync daemon started."
msgstr ""
"Εδώ εμφανίζεται ό,τι έχει συμβεί από την εκκίνηση της υπηρεσίας συγχρονισμού."

#. TRANSLATORS: start of "Keep logs for [30] days"; the number and "days" follow
#: ui/qml/main.qml:547
msgid "Keep logs for"
msgstr "Διατήρηση καταγραφών για"

#. TRANSLATORS: end of "Keep logs for [30] days"
#: ui/qml/main.qml:557
msgid "days"
msgstr "ημέρες"

#. TRANSLATORS: verb, label before a dropdown choosing which log levels are written to disk
#: ui/qml/main.qml:562
msgid "Store"
msgstr "Αποθήκευση"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:570
msgid "Warnings and errors"
msgstr "Προειδοποιήσεις και σφάλματα"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:572
msgid "Everything"
msgstr "Τα πάντα"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:574
msgid "Errors only"
msgstr "Μόνο σφάλματα"

#: ui/qml/main.qml:583
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} γραμμή"
msgstr[1] "{n} γραμμές"

#: src/daemon.rs:112
msgid "Signed out. Sign in from the account window."
msgstr "Αποσυνδεθήκατε. Συνδεθείτε από το παράθυρο λογαριασμού."

#: src/daemon.rs:114 src/daemon.rs:401
msgid "Syncing…"
msgstr "Συγχρονισμός…"

#: src/daemon.rs:116 src/daemon.rs:404
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} αντικείμενο σε συγχρονισμό"
msgstr[1] "{n} αντικείμενα σε συγχρονισμό"

#: src/daemon.rs:126 ui/qml/main.qml:409
msgid "Open folder"
msgstr "Άνοιγμα φακέλου"

#: src/daemon.rs:136
msgid "Account and logs…"
msgstr "Λογαριασμός και καταγραφές…"

#: src/daemon.rs:143 ui/qml/main.qml:396
msgid "Sync now"
msgstr "Συγχρονισμός τώρα"

#: src/daemon.rs:155
msgid "Pause sync"
msgstr "Παύση συγχρονισμού"

#: src/daemon.rs:168
msgid "Quit"
msgstr "Έξοδος"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:328
msgid "{reason}; retrying"
msgstr "{reason}· νέα προσπάθεια"

#: src/daemon.rs:339
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Το Proton Drive είναι ξανά προσβάσιμο, μετά από {duration}"

#: src/daemon.rs:350
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} δευτερόλεπτο"
msgstr[1] "{n} δευτερόλεπτα"

#: src/daemon.rs:351
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} λεπτό"
msgstr[1] "{n} λεπτά"

#: src/daemon.rs:352
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} ώρα"
msgstr[1] "{n} ώρες"

#: src/daemon.rs:382
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"Η υπηρεσία συγχρονισμού δεν εκτελείται. Εκκινήστε την με: kpdrive sync --"
"watch"

#: src/daemon.rs:385
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Εκτελείται μια υπηρεσία συγχρονισμού, αλλά είναι πολύ παλιά για να αναφέρει "
"τι κάνει. Επανεκκινήστε την."

#: src/daemon.rs:391
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Αποσυνδεθήκατε. Ο συγχρονισμός θα συνεχιστεί μόλις συνδεθείτε."

#: src/daemon.rs:395
msgid "{reason}. Still trying."
msgstr "{reason}. Συνεχίζεται η προσπάθεια."

#: src/daemon.rs:396
msgid "Last sync failed: {reason}"
msgstr "Ο τελευταίος συγχρονισμός απέτυχε: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:410
msgid "just now"
msgstr "μόλις τώρα"

#: src/daemon.rs:412
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "πριν από {n} λεπτό"
msgstr[1] "πριν από {n} λεπτά"

#: src/daemon.rs:415
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "πριν από {n} ώρα"
msgstr[1] "πριν από {n} ώρες"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:419
msgid "{items}, checked {ago}"
msgstr "{items}, τελευταίος έλεγχος {ago}"

#: src/daemon.rs:637
msgid "Signed in again. Syncing resumed."
msgstr "Συνδεθήκατε ξανά. Ο συγχρονισμός συνεχίστηκε."

#: src/daemon.rs:712
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Αποσυνδεθήκατε. Συνδεθείτε από το παράθυρο λογαριασμού για να συνεχιστεί ο "
"συγχρονισμός."

#: src/daemon.rs:745
msgid "Sync resumed"
msgstr "Ο συγχρονισμός συνεχίστηκε"

#: src/daemon.rs:762
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "Λήψη {n} φωτογραφίας"
msgstr[1] "Λήψη {n} φωτογραφιών"

#: src/daemon.rs:783
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "Αποστολή {n} φωτογραφίας στο Proton Photos"
msgstr[1] "Αποστολή {n} φωτογραφιών στο Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:334
msgid "Sign out"
msgstr "Αποσύνδεση"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} φωτογραφία"
msgstr[1] "{n} φωτογραφίες"

#: src/pause.rs:20
msgid "Paused"
msgstr "Σε παύση"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "Σε παύση κατά την τροφοδοσία από ρεύμα"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "Σε παύση κατά τη λειτουργία με μπαταρία"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "Σε παύση όταν η μπαταρία είναι χαμηλή"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "Σε παύση όσο υπάρχει σύνδεση στο {network}"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Συγχρονισμός μέσα σε αυτόν, διατηρώντας τα υπάρχοντα"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Μετακίνησή του στην άκρη και έναρξη από κενό φάκελο"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"Ο φάκελος {folder} περιέχει ήδη {n} αντικείμενο, το οποίο ο συγχρονισμός θα "
"συγχωνεύσει με το Proton Drive."
msgstr[1] ""
"Ο φάκελος {folder} περιέχει ήδη {n} αντικείμενα, τα οποία ο συγχρονισμός θα "
"συγχωνεύσει με το Proton Drive."

#: ui/src/bridge.rs:237
msgid "Starting…"
msgstr "Έναρξη…"

#: ui/src/bridge.rs:288
msgid "Confirm the code {code} in your browser"
msgstr "Επιβεβαιώστε τον κωδικό {code} στο πρόγραμμα περιήγησης"

#: ui/src/bridge.rs:302
msgid "Sign-in failed: {reason}"
msgstr "Η σύνδεση απέτυχε: {reason}"

#: ui/src/bridge.rs:314
msgid "Signed out"
msgstr "Αποσυνδεθήκατε"

#: ui/src/bridge.rs:317
msgid "Sign-out failed: {reason}"
msgstr "Η αποσύνδεση απέτυχε: {reason}"

#: ui/src/bridge.rs:382
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Επανεκκινήστε την υπηρεσία συγχρονισμού για να χρησιμοποιηθεί."

#: ui/src/bridge.rs:385
msgid "Cannot change the folder: {reason}"
msgstr "Αδυναμία αλλαγής του φακέλου: {reason}"

#: ui/src/bridge.rs:392
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Δεν έχει οριστεί ακόμη φάκελος συγχρονισμού. Εκτελέστε: kpdrive setup"

#: ui/src/bridge.rs:396
msgid "Cannot create the ignore file: {reason}"
msgstr "Αδυναμία δημιουργίας του αρχείου παράβλεψης: {reason}"

#: ui/src/bridge.rs:434
msgid "Checking the account…"
msgstr "Έλεγχος του λογαριασμού…"

#: ui/src/bridge.rs:440
msgid "Opening the browser…"
msgstr "Άνοιγμα του προγράμματος περιήγησης…"

#: ui/src/bridge.rs:446
msgid "Signing out…"
msgstr "Αποσύνδεση…"

#: ui/src/bridge.rs:472
msgid "Cannot read the log: {reason}"
msgstr "Αδυναμία ανάγνωσης της καταγραφής: {reason}"

#: ui/src/bridge.rs:482 ui/src/bridge.rs:510 ui/src/bridge.rs:524
#: ui/src/bridge.rs:539 ui/src/bridge.rs:573 ui/src/bridge.rs:614
#: ui/src/bridge.rs:627 ui/src/bridge.rs:645
msgid "Cannot save the setting: {reason}"
msgstr "Αδυναμία αποθήκευσης της ρύθμισης: {reason}"

#: ui/src/bridge.rs:490
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Το Proton Photos θα ληφθεί με τον επόμενο συγχρονισμό"

#: ui/src/bridge.rs:491
msgid "Proton Photos will be left alone"
msgstr "Το Proton Photos δεν θα πειραχτεί"

#: ui/src/bridge.rs:516
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr ""
"Οι φωτογραφίες που τοποθετούνται σε αυτόν τον φάκελο θα αποστέλλονται στο "
"Proton Photos"

#: ui/src/bridge.rs:517
msgid "No longer uploading photos"
msgstr "Οι φωτογραφίες δεν αποστέλλονται πλέον"

#: ui/src/bridge.rs:607
msgid "Photos will be downloaded into that folder from the next pass"
msgstr ""
"Οι φωτογραφίες θα λαμβάνονται σε αυτόν τον φάκελο από τον επόμενο κύκλο"

#: ui/src/bridge.rs:632
msgid "Storing everything from now on"
msgstr "Από τώρα αποθηκεύονται τα πάντα"

#: ui/src/bridge.rs:633
msgid "Storing warnings and errors from now on"
msgstr "Από τώρα αποθηκεύονται προειδοποιήσεις και σφάλματα"

#: ui/src/bridge.rs:634
msgid "Storing errors from now on"
msgstr "Από τώρα αποθηκεύονται μόνο τα σφάλματα"

#: ui/src/bridge.rs:650
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "αφαιρέθηκε {n} αρχείο καταγραφής παλαιότερο από {days} ημέρες"
msgstr[1] "αφαιρέθηκαν {n} αρχεία καταγραφής παλαιότερα από {days} ημέρες"

#: ui/src/bridge.rs:651
msgid "Cannot prune the log: {reason}"
msgstr "Αδυναμία εκκαθάρισης της καταγραφής: {reason}"

#: ui/qml/main.qml:28
msgid "Choose the Proton Drive folder"
msgstr "Επιλέξτε τον φάκελο του Proton Drive"

#: ui/qml/main.qml:35
msgid "Choose where Proton Photos are downloaded"
msgstr "Επιλέξτε πού θα γίνεται η λήψη του Proton Photos"

#: ui/qml/main.qml:42
msgid "Choose the folder to upload photos from"
msgstr "Επιλέξτε τον φάκελο από τον οποίο θα αποστέλλονται φωτογραφίες"

#: ui/qml/main.qml:53
msgid "The folder is not empty"
msgstr "Ο φάκελος δεν είναι κενός"

#: ui/qml/main.qml:104
msgid "Opened {what}"
msgstr "Άνοιξε: {what}"

#: ui/qml/main.qml:106
msgid "Could not open {what} ({url})"
msgstr "Αδυναμία ανοίγματος: {what} ({url})"

#: ui/qml/main.qml:186
msgid "Account & activity"
msgstr "Λογαριασμός και δραστηριότητα"

#: ui/qml/main.qml:187
msgid "Settings"
msgstr "Ρυθμίσεις"

#: ui/qml/main.qml:188 ui/qml/main.qml:633
msgid "Logs"
msgstr "Καταγραφές"

#: ui/qml/main.qml:189
msgid "About"
msgstr "Σχετικά"

#: ui/qml/main.qml:269
msgid "Not signed in"
msgstr "Δεν έχετε συνδεθεί"

#: ui/qml/main.qml:276
msgid "Signed in to Proton Drive"
msgstr "Συνδεδεμένοι στο Proton Drive"

#: ui/qml/main.qml:277
msgid "Sign in to sync this computer with Proton Drive."
msgstr ""
"Συνδεθείτε για να συγχρονίσετε αυτόν τον υπολογιστή με το Proton Drive."

#: ui/qml/main.qml:294
msgid "Storage:"
msgstr "Χώρος αποθήκευσης:"

#: ui/qml/main.qml:323
msgid "{used} of {total} used"
msgstr "{used} από {total} σε χρήση"

#: ui/qml/main.qml:331
msgid "Account:"
msgstr "Λογαριασμός:"

#: ui/qml/main.qml:334
msgid "Sign in"
msgstr "Σύνδεση"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:341
msgid "Refresh"
msgstr "Ανανέωση"

#: ui/qml/main.qml:350
msgid "On the web:"
msgstr "Στο διαδίκτυο:"

#: ui/qml/main.qml:353
msgid "Drive on the web"
msgstr "Το Drive στο διαδίκτυο"

#: ui/qml/main.qml:358
msgid "Proton account"
msgstr "Λογαριασμός Proton"

#: ui/qml/main.qml:366
msgid "Activity"
msgstr "Δραστηριότητα"

#: ui/qml/main.qml:373
msgid "Sync:"
msgstr "Συγχρονισμός:"

#: ui/qml/main.qml:404
msgid "Resume"
msgstr "Συνέχιση"

#: ui/qml/main.qml:404
msgid "Pause"
msgstr "Παύση"

#: ui/qml/main.qml:429
msgid "Files"
msgstr "Αρχεία"

#: ui/qml/main.qml:433
msgid "Sync folder:"
msgstr "Φάκελος συγχρονισμού:"

#: ui/qml/main.qml:437
msgid "nowhere yet"
msgstr "πουθενά ακόμη"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:443 ui/qml/main.qml:490 ui/qml/main.qml:533
msgid "Change…"
msgstr "Αλλαγή…"

#: ui/qml/main.qml:450
msgid "Ignored paths:"
msgstr "Διαδρομές που παραβλέπονται:"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves
#. alone
#: ui/qml/main.qml:452
msgid "Ignore file…"
msgstr "Αρχείο παράβλεψης…"

#: ui/qml/main.qml:459
msgid "Photos"
msgstr "Φωτογραφίες"

#: ui/qml/main.qml:463
msgid "Download:"
msgstr "Λήψη:"

#: ui/qml/main.qml:467
msgid "Also download Proton Photos"
msgstr "Λήψη και του Proton Photos"

#: ui/qml/main.qml:473
msgid ""
"Your timeline is copied here every half hour. Nothing in Proton Photos is "
"changed or deleted by it."
msgstr ""
"Το χρονολόγιό σας αντιγράφεται εδώ κάθε μισή ώρα. Τίποτα στο Proton Photos "
"δεν αλλάζει ούτε διαγράφεται από αυτό."

#: ui/qml/main.qml:481
msgid "Download folder:"
msgstr "Φάκελος λήψης:"

#: ui/qml/main.qml:485
msgid "your Pictures folder"
msgstr "ο φάκελος Εικόνες σας"

#: ui/qml/main.qml:497
msgid "Upload:"
msgstr "Αποστολή:"

#: ui/qml/main.qml:501
msgid "Upload photos from a folder"
msgstr "Αποστολή φωτογραφιών από φάκελο"

#: ui/qml/main.qml:515
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""
"Οι φωτογραφίες και τα βίντεο που τοποθετούνται σε αυτόν τον φάκελο "
"αποστέλλονται στο Proton Photos μέσα σε ένα λεπτό και μετά αφαιρούνται από "
"τον φάκελο. Ό,τι δεν μπορεί να αποσταλεί παραμένει."

#: ui/qml/main.qml:523
msgid "Upload folder:"
msgstr "Φάκελος αποστολής:"

#: ui/qml/main.qml:540
msgid "After upload:"
msgstr "Μετά την αποστολή:"

#: ui/qml/main.qml:542
msgid "Delete instead of moving to the trash"
msgstr "Διαγραφή αντί για μετακίνηση στον κάδο απορριμμάτων"

#: ui/qml/main.qml:549
msgid "Network"
msgstr "Δίκτυο"

#: ui/qml/main.qml:553 ui/qml/main.qml:598
msgid "Pause while on:"
msgstr "Παύση σε:"

#: ui/qml/main.qml:573
msgid "{network} (connected)"
msgstr "{network} (συνδεδεμένο)"

#: ui/qml/main.qml:584
msgid ""
"Syncing pauses while any ticked network is connected, such as a phone's "
"hotspot. A sync already under way finishes first."
msgstr ""
"Ο συγχρονισμός τίθεται σε παύση όσο είναι συνδεδεμένο οποιοδήποτε επιλεγμένο "
"δίκτυο, όπως το σημείο πρόσβασης ενός τηλεφώνου. Ένας συγχρονισμός που "
"βρίσκεται ήδη σε εξέλιξη ολοκληρώνεται πρώτα."

#: ui/qml/main.qml:585
msgid "NetworkManager lists no networks to choose from."
msgstr "Το NetworkManager δεν παραθέτει κανένα δίκτυο για επιλογή."

#: ui/qml/main.qml:594
msgid "Power"
msgstr "Τροφοδοσία"

#: ui/qml/main.qml:604
msgid "AC power"
msgstr "Τροφοδοσία από ρεύμα"

#: ui/qml/main.qml:605
msgid "Battery"
msgstr "Μπαταρία"

#: ui/qml/main.qml:606
msgid "Low battery"
msgstr "Χαμηλή μπαταρία"

#: ui/qml/main.qml:614
msgid "{power} (now)"
msgstr "{power} (τώρα)"

#: ui/qml/main.qml:624
msgid ""
"Low battery is the level set in the system's power management settings. A "
"sync already under way finishes first."
msgstr ""
"Χαμηλή μπαταρία είναι το επίπεδο που ορίζεται στις ρυθμίσεις διαχείρισης "
"ενέργειας του συστήματος. Ένας συγχρονισμός που βρίσκεται ήδη σε εξέλιξη "
"ολοκληρώνεται πρώτα."

#: ui/qml/main.qml:637
msgid "Keep logs for:"
msgstr "Διατήρηση καταγραφών για:"

#. TRANSLATORS: after the number in "Keep logs for: [30] days"
#: ui/qml/main.qml:646
msgid "days"
msgstr "ημέρες"

#. TRANSLATORS: label before a dropdown choosing which log levels are written
#. to disk
#: ui/qml/main.qml:651
msgid "Store:"
msgstr "Αποθήκευση:"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:656
msgid "Warnings and errors"
msgstr "Προειδοποιήσεις και σφάλματα"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:658
msgid "Everything"
msgstr "Τα πάντα"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:660
msgid "Errors only"
msgstr "Μόνο σφάλματα"

#: ui/qml/main.qml:681
msgid "Search the log"
msgstr "Αναζήτηση στην καταγραφή"

#: ui/qml/main.qml:686
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} γραμμή"
msgstr[1] "{n} γραμμές"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:736
msgid "Copy"
msgstr "Αντιγραφή"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:742
msgid "Select all"
msgstr "Επιλογή όλων"

#: ui/qml/main.qml:759
msgid "No lines match"
msgstr "Καμία γραμμή δεν ταιριάζει"

#: ui/qml/main.qml:759
msgid "Nothing logged yet"
msgstr "Δεν έχει καταγραφεί τίποτα ακόμη"

#: ui/qml/main.qml:761
msgid "No line since the sync daemon started contains “{term}”."
msgstr ""
"Καμία γραμμή από την εκκίνηση της υπηρεσίας συγχρονισμού δεν περιέχει "
"«{term}»."

#: ui/qml/main.qml:762
msgid "This shows what has happened since the sync daemon started."
msgstr ""
"Εδώ εμφανίζεται ό,τι έχει συμβεί από την εκκίνηση της υπηρεσίας συγχρονισμού."

#: ui/qml/main.qml:794
msgid "Proton Drive sync client for KDE Plasma"
msgstr "Πρόγραμμα συγχρονισμού του Proton Drive για το KDE Plasma"

#: ui/qml/main.qml:802
msgid "Version:"
msgstr "Έκδοση:"

#: ui/qml/main.qml:807
msgid "Licence:"
msgstr "Άδεια χρήσης:"

#: ui/qml/main.qml:811
msgid "Read the licence"
msgstr "Ανάγνωση της άδειας χρήσης"

#: ui/qml/main.qml:818
msgid "Project:"
msgstr "Έργο:"

#: ui/qml/main.qml:821
msgid "Source code"
msgstr "Πηγαίος κώδικας"

#: ui/qml/main.qml:826
msgid "Report a bug"
msgstr "Αναφορά σφάλματος"

#~ msgid "Syncing to"
#~ msgstr "Συγχρονισμός στο"

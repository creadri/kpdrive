#: src/daemon.rs:98
msgid "Signed out. Sign in from the account window."
msgstr "Logget ud. Log ind fra kontovinduet."

#: src/daemon.rs:100 src/daemon.rs:341
msgid "Syncing…"
msgstr "Synkroniserer…"

#: src/daemon.rs:102 src/daemon.rs:344
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} element synkroniseret"
msgstr[1] "{n} elementer synkroniseret"

#: src/daemon.rs:112 ui/qml/main.qml:313
msgid "Open folder"
msgstr "Åbn mappe"

#: src/daemon.rs:122
msgid "Account and logs…"
msgstr "Konto og log…"

#: src/daemon.rs:129 ui/qml/main.qml:291
msgid "Sync now"
msgstr "Synkronisér nu"

#: src/daemon.rs:139
msgid "Quit"
msgstr "Afslut"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:273
msgid "{reason}; retrying"
msgstr "{reason}; prøver igen"

#: src/daemon.rs:284
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive kan nås igen, efter {duration}"

#: src/daemon.rs:295
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} sekund"
msgstr[1] "{n} sekunder"

#: src/daemon.rs:296
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minut"
msgstr[1] "{n} minutter"

#: src/daemon.rs:297
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} time"
msgstr[1] "{n} timer"

#: src/daemon.rs:325
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "Synkroniseringstjenesten kører ikke. Start den med: kpdrive sync --watch"

#: src/daemon.rs:328
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr "En synkroniseringstjeneste kører, men den er for gammel til at fortælle, hvad den laver. Genstart den."

#: src/daemon.rs:331
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Logget ud. Synkroniseringen genoptages, når du logger ind."

#: src/daemon.rs:335
msgid "{reason}. Still trying."
msgstr "{reason}. Prøver stadig."

#: src/daemon.rs:336
msgid "Last sync failed: {reason}"
msgstr "Seneste synkronisering mislykkedes: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:350
msgid "just now"
msgstr "lige nu"

#: src/daemon.rs:352
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "for {n} minut siden"
msgstr[1] "for {n} minutter siden"

#: src/daemon.rs:355
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "for {n} time siden"
msgstr[1] "for {n} timer siden"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:359
msgid "{items}, checked {ago}"
msgstr "{items}, kontrolleret {ago}"

#: src/daemon.rs:576
msgid "Signed in again. Syncing resumed."
msgstr "Logget ind igen. Synkroniseringen er genoptaget."

#: src/daemon.rs:630
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "Logget ud. Log ind fra kontovinduet for at genoptage synkroniseringen."

#: src/daemon.rs:663
msgid "Sync resumed"
msgstr "Synkronisering genoptaget"

#: src/daemon.rs:680
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} foto hentet"
msgstr[1] "{n} fotos hentet"

#: src/i18n.rs:111 ui/qml/main.qml:336
msgid "Sign out"
msgstr "Log ud"

#: src/i18n.rs:112 src/i18n.rs:113
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} foto"
msgstr[1] "{n} fotos"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Synkronisér ind i den, og behold det, der allerede er der"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Flyt den til side, og start med en tom mappe"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] "{folder} indeholder allerede {n} element, som synkroniseringen fletter sammen med Proton Drive."
msgstr[1] "{folder} indeholder allerede {n} elementer, som synkroniseringen fletter sammen med Proton Drive."

#: ui/src/bridge.rs:175
msgid "Starting…"
msgstr "Starter…"

#: ui/src/bridge.rs:217
msgid "Confirm the code {code} in your browser"
msgstr "Bekræft koden {code} i browseren"

#: ui/src/bridge.rs:231
msgid "Sign-in failed: {reason}"
msgstr "Login mislykkedes: {reason}"

#: ui/src/bridge.rs:243
msgid "Signed out"
msgstr "Logget ud"

#: ui/src/bridge.rs:246
msgid "Sign-out failed: {reason}"
msgstr "Log ud mislykkedes: {reason}"

#: ui/src/bridge.rs:305
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Genstart synkroniseringstjenesten, så ændringen træder i kraft."

#: ui/src/bridge.rs:308
msgid "Cannot change the folder: {reason}"
msgstr "Mappen kan ikke ændres: {reason}"

#: ui/src/bridge.rs:315
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Ingen synkroniseringsmappe endnu. Kør: kpdrive setup"

#: ui/src/bridge.rs:319
msgid "Cannot create the ignore file: {reason}"
msgstr "Ignorér-filen kan ikke oprettes: {reason}"

#: ui/src/bridge.rs:356
msgid "Checking the account…"
msgstr "Kontrollerer kontoen…"

#: ui/src/bridge.rs:362
msgid "Opening the browser…"
msgstr "Åbner browseren…"

#: ui/src/bridge.rs:368
msgid "Signing out…"
msgstr "Logger ud…"

#: ui/src/bridge.rs:394
msgid "Cannot read the log: {reason}"
msgstr "Loggen kan ikke læses: {reason}"

#: ui/src/bridge.rs:404 ui/src/bridge.rs:425 ui/src/bridge.rs:443
msgid "Cannot save the setting: {reason}"
msgstr "Indstillingen kan ikke gemmes: {reason}"

#: ui/src/bridge.rs:412
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos hentes ved næste synkronisering"

#: ui/src/bridge.rs:413
msgid "Proton Photos will be left alone"
msgstr "Proton Photos røres ikke"

#: ui/src/bridge.rs:430
msgid "Storing everything from now on"
msgstr "Gemmer alt fra nu af"

#: ui/src/bridge.rs:431
msgid "Storing warnings and errors from now on"
msgstr "Gemmer advarsler og fejl fra nu af"

#: ui/src/bridge.rs:432
msgid "Storing errors from now on"
msgstr "Gemmer fejl fra nu af"

#: ui/src/bridge.rs:448
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "fjernede {n} logfil, der er ældre end {days} dage"
msgstr[1] "fjernede {n} logfiler, der er ældre end {days} dage"

#: ui/src/bridge.rs:449
msgid "Cannot prune the log: {reason}"
msgstr "Loggen kan ikke ryddes op: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "Vælg Proton Drive-mappen"

#: ui/qml/main.qml:38
msgid "The folder is not empty"
msgstr "Mappen er ikke tom"

#: ui/qml/main.qml:73
msgid "Opened {what}"
msgstr "Åbnede {what}"

#: ui/qml/main.qml:75
msgid "Could not open {what} ({url})"
msgstr "Kunne ikke åbne {what} ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:131
msgid "Account"
msgstr "Konto"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:133
msgid "Logs"
msgstr "Log"

#: ui/qml/main.qml:164
msgid "Not signed in"
msgstr "Ikke logget ind"

#: ui/qml/main.qml:171
msgid "Signed in to Proton Drive"
msgstr "Logget ind på Proton Drive"

#: ui/qml/main.qml:172
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Log ind for at synkronisere denne computer med Proton Drive."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:193
msgid "Storage"
msgstr "Lagerplads"

#: ui/qml/main.qml:221
msgid "{used} of {total} used"
msgstr "{used} af {total} brugt"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:233
msgid "Syncing to"
msgstr "Synkroniseringsmappe"

#: ui/qml/main.qml:237
msgid "nowhere yet"
msgstr "ingen endnu"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:244
msgid "Change…"
msgstr "Ændr…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:251
msgid "Ignore file…"
msgstr "Ignorér-fil…"

#: ui/qml/main.qml:263
msgid "Also download Proton Photos"
msgstr "Hent også Proton Photos"

#: ui/qml/main.qml:271
msgid ""
"Read-only: your timeline is copied into {folder}. Photos are never uploaded, "
"changed or deleted in Proton Photos, and the copy is checked every half hour."
msgstr "Skrivebeskyttet: din tidslinje kopieres til denne mappe: {folder}. Fotos bliver aldrig uploadet, ændret eller slettet i Proton Photos, og kopien kontrolleres hver halve time."

#: ui/qml/main.qml:272
msgid "your Pictures folder"
msgstr "din mappe Billeder"

#: ui/qml/main.qml:319
msgid "Drive on the web"
msgstr "Drive på nettet"

#: ui/qml/main.qml:324
msgid "Proton account"
msgstr "Proton-konto"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:330
msgid "Refresh"
msgstr "Opdatér"

#: ui/qml/main.qml:336
msgid "Sign in"
msgstr "Log ind"

#: ui/qml/main.qml:379
msgid "Read the licence"
msgstr "Læs licensen"

#: ui/qml/main.qml:397
msgid "Search the log"
msgstr "Søg i loggen"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:443
msgid "Copy"
msgstr "Kopiér"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:449
msgid "Select all"
msgstr "Markér alt"

#: ui/qml/main.qml:466
msgid "No lines match"
msgstr "Ingen linjer matcher"

#: ui/qml/main.qml:466
msgid "Nothing logged yet"
msgstr "Intet logget endnu"

#: ui/qml/main.qml:468
msgid "No line since the sync daemon started contains “{term}”."
msgstr "Ingen linje, siden synkroniseringstjenesten startede, indeholder “{term}”."

#: ui/qml/main.qml:469
msgid "This shows what has happened since the sync daemon started."
msgstr "Her vises, hvad der er sket, siden synkroniseringstjenesten startede."

#. TRANSLATORS: start of "Keep logs for [30] days"; the number and "days" follow
#: ui/qml/main.qml:478
msgid "Keep logs for"
msgstr "Behold logfiler i"

#. TRANSLATORS: end of "Keep logs for [30] days"
#: ui/qml/main.qml:488
msgid "days"
msgstr "dage"

#. TRANSLATORS: verb, label before a dropdown choosing which log levels are written to disk
#: ui/qml/main.qml:493
msgid "Store"
msgstr "Gem"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:501
msgid "Warnings and errors"
msgstr "Advarsler og fejl"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:503
msgid "Everything"
msgstr "Alt"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:505
msgid "Errors only"
msgstr "Kun fejl"

#: ui/qml/main.qml:514
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} linje"
msgstr[1] "{n} linjer"

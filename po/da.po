#: src/daemon.rs:67 src/daemon.rs:174
msgid "Signed out. Sign in from the account window."
msgstr "Logget ud. Log ind fra kontovinduet."

#: src/daemon.rs:69 src/daemon.rs:535
msgid "Syncing…"
msgstr "Synkroniserer…"

#: src/daemon.rs:71 src/daemon.rs:538
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} element synkroniseret"
msgstr[1] "{n} elementer synkroniseret"

#: src/daemon.rs:199 src/daemon.rs:201 ui/qml/main.qml:469
msgid "Open folder"
msgstr "Åbn mappe"

#: src/daemon.rs:211
msgid "Account and logs…"
msgstr "Konto og log…"

#: src/daemon.rs:218 ui/qml/main.qml:456
msgid "Sync now"
msgstr "Synkronisér nu"

#: src/daemon.rs:230
msgid "Pause sync"
msgstr "Sæt synkronisering på pause"

#: src/daemon.rs:243
msgid "Quit"
msgstr "Afslut"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:430
msgid "{reason}; retrying"
msgstr "{reason}; prøver igen"

#: src/daemon.rs:441
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive kan nås igen, efter {duration}"

#: src/daemon.rs:452
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} sekund"
msgstr[1] "{n} sekunder"

#: src/daemon.rs:453
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minut"
msgstr[1] "{n} minutter"

#: src/daemon.rs:454
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} time"
msgstr[1] "{n} timer"

#: src/daemon.rs:502
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"Synkroniseringstjenesten kører ikke. Start den med: kpdrive sync --watch"

#: src/daemon.rs:505
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"En synkroniseringstjeneste kører, men den er for gammel til at fortælle, "
"hvad den laver. Genstart den."

#: src/daemon.rs:516 src/daemon.rs:525
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Logget ud. Synkroniseringen genoptages, når du logger ind."

#: src/daemon.rs:529
msgid "{reason}. Still trying."
msgstr "{reason}. Prøver stadig."

#: src/daemon.rs:530
msgid "Last sync failed: {reason}"
msgstr "Seneste synkronisering mislykkedes: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:544
msgid "just now"
msgstr "lige nu"

#: src/daemon.rs:546
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "for {n} minut siden"
msgstr[1] "for {n} minutter siden"

#: src/daemon.rs:549
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "for {n} time siden"
msgstr[1] "for {n} timer siden"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:553
msgid "{items}, checked {ago}"
msgstr "{items}, kontrolleret {ago}"

#: src/daemon.rs:924
msgid "Signed in again. Syncing resumed."
msgstr "Logget ind igen. Synkroniseringen er genoptaget."

#: src/daemon.rs:938
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "Logget ud. Log ind fra kontovinduet for at genoptage synkroniseringen."

#: src/daemon.rs:1050
msgid "Sync resumed"
msgstr "Synkronisering genoptaget"

#: src/daemon.rs:1067
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} foto hentet"
msgstr[1] "{n} fotos hentet"

#: src/daemon.rs:1086
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} foto uploadet til Proton Photos"
msgstr[1] "{n} fotos uploadet til Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:387
msgid "Sign out"
msgstr "Log ud"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} foto"
msgstr[1] "{n} fotos"

#: src/pause.rs:20
msgid "Paused"
msgstr "Sat på pause"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "Sat på pause ved netstrøm"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "Sat på pause ved batteridrift"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "Sat på pause ved lavt batteri"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "Sat på pause, mens der er forbindelse til {network}"

#: src/sync.rs:124
msgid "Sync into it and keep what is already there"
msgstr "Synkronisér ind i den, og behold det, der allerede er der"

#: src/sync.rs:125
msgid "Move it aside and start from an empty folder"
msgstr "Flyt den til side, og start med en tom mappe"

#: src/sync.rs:163
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"{folder} indeholder allerede {n} element, som synkroniseringen fletter "
"sammen med Proton Drive."
msgstr[1] ""
"{folder} indeholder allerede {n} elementer, som synkroniseringen fletter "
"sammen med Proton Drive."

#: ui/src/bridge.rs:260
msgid "Starting…"
msgstr "Starter…"

#: ui/src/bridge.rs:317
msgid "Confirm the code {code} in your browser"
msgstr "Bekræft koden {code} i browseren"

#: ui/src/bridge.rs:331
msgid "Sign-in failed: {reason}"
msgstr "Login mislykkedes: {reason}"

#: ui/src/bridge.rs:344
msgid "Signed out"
msgstr "Logget ud"

#: ui/src/bridge.rs:347
msgid "Sign-out failed: {reason}"
msgstr "Log ud mislykkedes: {reason}"

#: ui/src/bridge.rs:355
msgid "Removed {account}. Its files were left where they are."
msgstr "{account} er fjernet. Filerne blev liggende, hvor de er."

#: ui/src/bridge.rs:362
msgid "Cannot remove the account: {reason}"
msgstr "Kontoen kan ikke fjernes: {reason}"

#: ui/src/bridge.rs:481
msgid "Cannot change the folder: {reason}"
msgstr "Mappen kan ikke ændres: {reason}"

#: ui/src/bridge.rs:488
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Ingen synkroniseringsmappe endnu. Kør: kpdrive setup"

#: ui/src/bridge.rs:492
msgid "Cannot create the ignore file: {reason}"
msgstr "Ignorér-filen kan ikke oprettes: {reason}"

#: ui/src/bridge.rs:537
msgid "Checking the account…"
msgstr "Kontrollerer kontoen…"

#: ui/src/bridge.rs:543
msgid "Opening the browser…"
msgstr "Åbner browseren…"

#: ui/src/bridge.rs:550
msgid "Signing out…"
msgstr "Logger ud…"

#: ui/src/bridge.rs:557
msgid "Removing the account…"
msgstr "Fjerner kontoen…"

#: ui/src/bridge.rs:583
msgid "Cannot read the log: {reason}"
msgstr "Loggen kan ikke læses: {reason}"

#: ui/src/bridge.rs:591 ui/src/bridge.rs:618 ui/src/bridge.rs:632
#: ui/src/bridge.rs:647 ui/src/bridge.rs:681 ui/src/bridge.rs:723
#: ui/src/bridge.rs:736 ui/src/bridge.rs:754
msgid "Cannot save the setting: {reason}"
msgstr "Indstillingen kan ikke gemmes: {reason}"

#: ui/src/bridge.rs:599
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos hentes ved næste synkronisering"

#: ui/src/bridge.rs:600
msgid "Proton Photos will be left alone"
msgstr "Proton Photos røres ikke"

#: ui/src/bridge.rs:624
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr "Fotos, der lægges i den mappe, uploades til Proton Photos"

#: ui/src/bridge.rs:625
msgid "No longer uploading photos"
msgstr "Uploader ikke længere fotos"

#: ui/src/bridge.rs:717
msgid "Photos will be downloaded into that folder from the next pass"
msgstr "Fotos hentes til den mappe fra næste gennemløb"

#: ui/src/bridge.rs:741
msgid "Storing everything from now on"
msgstr "Gemmer alt fra nu af"

#: ui/src/bridge.rs:742
msgid "Storing warnings and errors from now on"
msgstr "Gemmer advarsler og fejl fra nu af"

#: ui/src/bridge.rs:743
msgid "Storing errors from now on"
msgstr "Gemmer fejl fra nu af"

#: ui/src/bridge.rs:759
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "fjernede {n} logfil, der er ældre end {days} dage"
msgstr[1] "fjernede {n} logfiler, der er ældre end {days} dage"

#: ui/src/bridge.rs:760
msgid "Cannot prune the log: {reason}"
msgstr "Loggen kan ikke ryddes op: {reason}"

#: ui/qml/main.qml:28
msgid "Choose the Proton Drive folder"
msgstr "Vælg Proton Drive-mappen"

#: ui/qml/main.qml:35
msgid "Choose where Proton Photos are downloaded"
msgstr "Vælg, hvor Proton Photos hentes til"

#: ui/qml/main.qml:42
msgid "Choose the folder to upload photos from"
msgstr "Vælg mappen, som fotos skal uploades fra"

#: ui/qml/main.qml:53
msgid "The folder is not empty"
msgstr "Mappen er ikke tom"

#: ui/qml/main.qml:80
msgid "Remove {account}?"
msgstr "Fjern {account}?"

#: ui/qml/main.qml:81
msgid ""
"kpdrive signs this account out and forgets what it synced. The files in "
"{folder} stay where they are."
msgstr ""
"kpdrive logger denne konto ud og glemmer, hvad den har synkroniseret. "
"Filerne i {folder} bliver liggende, hvor de er."

#: ui/qml/main.qml:82
msgid "its folder"
msgstr "dens mappe"

#: ui/qml/main.qml:86
msgid "Remove account"
msgstr "Fjern konto"

#: ui/qml/main.qml:94
msgid "Cancel"
msgstr "Annuller"

#: ui/qml/main.qml:130
msgid "Opened {what}"
msgstr "Åbnede {what}"

#: ui/qml/main.qml:132
msgid "Could not open {what} ({url})"
msgstr "Kunne ikke åbne {what} ({url})"

#: ui/qml/main.qml:223 ui/qml/main.qml:225
msgid "Add account"
msgstr "Tilføj konto"

#: ui/qml/main.qml:237
msgid "Account & activity"
msgstr "Konto og aktivitet"

#: ui/qml/main.qml:238
msgid "Settings"
msgstr "Indstillinger"

#: ui/qml/main.qml:239 ui/qml/main.qml:701
msgid "Logs"
msgstr "Log"

#: ui/qml/main.qml:240
msgid "About"
msgstr "Om"

#: ui/qml/main.qml:320
msgid "Not signed in"
msgstr "Ikke logget ind"

#: ui/qml/main.qml:327
msgid "Signed in to Proton Drive"
msgstr "Logget ind på Proton Drive"

#: ui/qml/main.qml:329
msgid "Signed out. Sign in again to resume syncing this account."
msgstr ""
"Logget ud. Log ind igen for at genoptage synkroniseringen af denne konto."

#: ui/qml/main.qml:330
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Log ind for at synkronisere denne computer med Proton Drive."

#: ui/qml/main.qml:347
msgid "Storage:"
msgstr "Lagerplads:"

#: ui/qml/main.qml:376
msgid "{used} of {total} used"
msgstr "{used} af {total} brugt"

#: ui/qml/main.qml:384 ui/qml/main.qml:489
msgid "Account:"
msgstr "Konto:"

#: ui/qml/main.qml:387
msgid "Sign in"
msgstr "Log ind"


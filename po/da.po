msgstr "Opdatér"

#: ui/qml/main.qml:401
msgid "Remove account…"
msgstr "Fjern konto…"

#: ui/qml/main.qml:410
msgid "On the web:"
msgstr "På nettet:"

#: ui/qml/main.qml:413
msgid "Drive on the web"
msgstr "Drive på nettet"

#: ui/qml/main.qml:418
msgid "Proton account"
msgstr "Proton-konto"

#: ui/qml/main.qml:426
msgid "Activity"
msgstr "Aktivitet"

#: ui/qml/main.qml:433
msgid "Sync:"
msgstr "Synkronisering:"

#: ui/qml/main.qml:464
msgid "Resume"
msgstr "Genoptag"

#: ui/qml/main.qml:464
msgid "Pause"
msgstr "Pause"

#: ui/qml/main.qml:497
msgid "Files"
msgstr "Filer"

#: ui/qml/main.qml:501
msgid "Sync folder:"
msgstr "Synkroniseringsmappe:"

#: ui/qml/main.qml:505
msgid "nowhere yet"
msgstr "ingen endnu"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:511 ui/qml/main.qml:558 ui/qml/main.qml:601
msgid "Change…"
msgstr "Ændr…"

#: ui/qml/main.qml:518
msgid "Ignored paths:"
msgstr "Ignorerede stier:"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves
#. alone
#: ui/qml/main.qml:520
msgid "Ignore file…"
msgstr "Ignorér-fil…"

#: ui/qml/main.qml:527
msgid "Photos"
msgstr "Fotos"

#: ui/qml/main.qml:531
msgid "Download:"
msgstr "Hent:"

#: ui/qml/main.qml:535
msgid "Also download Proton Photos"
msgstr "Hent også Proton Photos"

#: ui/qml/main.qml:541
msgid ""
"Your timeline is copied here every half hour. Nothing in Proton Photos is "
"changed or deleted by it."
msgstr ""
"Din tidslinje kopieres hertil hver halve time. Intet i Proton Photos ændres "
"eller slettes af det."

#: ui/qml/main.qml:549
msgid "Download folder:"
msgstr "Hentemappe:"

#: ui/qml/main.qml:553
msgid "your Pictures folder"
msgstr "din mappe Billeder"

#: ui/qml/main.qml:565
msgid "Upload:"
msgstr "Upload:"

#: ui/qml/main.qml:569
msgid "Upload photos from a folder"
msgstr "Upload fotos fra en mappe"

#: ui/qml/main.qml:583
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""
"Fotos og videoer, der lægges i denne mappe, uploades til Proton Photos inden "
"for et minut og forlader derefter mappen. Det, der ikke kan uploades, bliver "
"liggende."

#: ui/qml/main.qml:591
msgid "Upload folder:"
msgstr "Uploadmappe:"

#: ui/qml/main.qml:608
msgid "After upload:"
msgstr "Efter upload:"

#: ui/qml/main.qml:610
msgid "Delete instead of moving to the trash"
msgstr "Slet i stedet for at flytte til papirkurven"

#: ui/qml/main.qml:617
msgid "Network"
msgstr "Netværk"

#: ui/qml/main.qml:621 ui/qml/main.qml:666
msgid "Pause while on:"
msgstr "Sæt på pause ved:"

#: ui/qml/main.qml:641
msgid "{network} (connected)"
msgstr "{network} (forbundet)"

#: ui/qml/main.qml:652
msgid ""
"Syncing pauses while any ticked network is connected, such as a phone's "
"hotspot. A sync already under way finishes first."
msgstr ""
"Synkroniseringen sættes på pause, mens et afkrydset netværk er forbundet, fx "
"en telefons hotspot. En synkronisering, der allerede er i gang, gøres færdig "
"først."

#: ui/qml/main.qml:653
msgid "NetworkManager lists no networks to choose from."
msgstr "NetworkManager viser ingen netværk at vælge imellem."

#: ui/qml/main.qml:662
msgid "Power"
msgstr "Strøm"

#: ui/qml/main.qml:672
msgid "AC power"
msgstr "Netstrøm"

#: ui/qml/main.qml:673
msgid "Battery"
msgstr "Batteri"

#: ui/qml/main.qml:674
msgid "Low battery"
msgstr "Lavt batteri"

#: ui/qml/main.qml:682
msgid "{power} (now)"
msgstr "{power} (nu)"

#: ui/qml/main.qml:692
msgid ""
"Low battery is the level set in the system's power management settings. A "
"sync already under way finishes first."
msgstr ""
"Lavt batteri er det niveau, der er angivet i systemets indstillinger for "
"strømstyring. En synkronisering, der allerede er i gang, gøres færdig først."

#: ui/qml/main.qml:705
msgid "Keep logs for:"
msgstr "Behold log i:"

#. TRANSLATORS: after the number in "Keep logs for: [30] days"
#: ui/qml/main.qml:714
msgid "days"
msgstr "dage"

#. TRANSLATORS: label before a dropdown choosing which log levels are written
#. to disk
#: ui/qml/main.qml:719
msgid "Store:"
msgstr "Gem:"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:724
msgid "Warnings and errors"
msgstr "Advarsler og fejl"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:726
msgid "Everything"
msgstr "Alt"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:728
msgid "Errors only"
msgstr "Kun fejl"

#: ui/qml/main.qml:749
msgid "Search the log"
msgstr "Søg i loggen"

#: ui/qml/main.qml:754
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} linje"
msgstr[1] "{n} linjer"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:804
msgid "Copy"
msgstr "Kopiér"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:810
msgid "Select all"
msgstr "Markér alt"

#: ui/qml/main.qml:827
msgid "No lines match"
msgstr "Ingen linjer matcher"

#: ui/qml/main.qml:827
msgid "Nothing logged yet"
msgstr "Intet logget endnu"

#: ui/qml/main.qml:829
msgid "No line since the sync daemon started contains “{term}”."
msgstr ""
"Ingen linje, siden synkroniseringstjenesten startede, indeholder “{term}”."

#: ui/qml/main.qml:830
msgid "This shows what has happened since the sync daemon started."
msgstr "Her vises, hvad der er sket, siden synkroniseringstjenesten startede."

#: ui/qml/main.qml:862
msgid "Proton Drive sync client for KDE Plasma"
msgstr "Proton Drive-synkroniseringsklient til KDE Plasma"


#: src/daemon.rs:102
msgid "Signed out. Sign in from the account window."
msgstr "התנתקת. יש להתחבר מחלון החשבון."

#: src/daemon.rs:104 src/daemon.rs:371
msgid "Syncing…"
msgstr "בסנכרון…"

#: src/daemon.rs:106 src/daemon.rs:374
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "פריט אחד מסונכרן"
msgstr[1] "{n} פריטים מסונכרנים"

#: src/daemon.rs:116 ui/qml/main.qml:382
msgid "Open folder"
msgstr "פתיחת תיקייה"

#: src/daemon.rs:126
msgid "Account and logs…"
msgstr "חשבון ויומנים…"

#: src/daemon.rs:133 ui/qml/main.qml:360
msgid "Sync now"
msgstr "סנכרון כעת"

#: src/daemon.rs:143
msgid "Quit"
msgstr "יציאה"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:303
msgid "{reason}; retrying"
msgstr "{reason}; מתבצע ניסיון חוזר"

#: src/daemon.rs:314
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive זמין שוב, לאחר {duration}"

#: src/daemon.rs:325
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "שנייה אחת"
msgstr[1] "{n} שניות"

#: src/daemon.rs:326
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "דקה אחת"
msgstr[1] "{n} דקות"

#: src/daemon.rs:327
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "שעה אחת"
msgstr[1] "{n} שעות"

#: src/daemon.rs:355
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"שירות הסנכרון אינו פעיל. ניתן להפעיל אותו באמצעות: kpdrive sync --watch"

#: src/daemon.rs:358
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr "שירות סנכרון פעיל, אך ישן מכדי לדווח על פעולתו. יש להפעיל אותו מחדש."

#: src/daemon.rs:361
msgid "Signed out. Syncing resumes once you sign in."
msgstr "התנתקת. הסנכרון יתחדש עם ההתחברות."

#: src/daemon.rs:365
msgid "{reason}. Still trying."
msgstr "{reason}. הניסיונות נמשכים."

#: src/daemon.rs:366
msgid "Last sync failed: {reason}"
msgstr "הסנכרון האחרון נכשל: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:380
msgid "just now"
msgstr "ממש עכשיו"

#: src/daemon.rs:382
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "לפני דקה אחת"
msgstr[1] "לפני {n} דקות"

#: src/daemon.rs:385
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "לפני שעה אחת"
msgstr[1] "לפני {n} שעות"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:389
msgid "{items}, checked {ago}"
msgstr "{items}, נבדק {ago}"

#: src/daemon.rs:606
msgid "Signed in again. Syncing resumed."
msgstr "התחברת מחדש. הסנכרון התחדש."

#: src/daemon.rs:660
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "התנתקת. יש להתחבר מחלון החשבון כדי לחדש את הסנכרון."

#: src/daemon.rs:693
msgid "Sync resumed"
msgstr "הסנכרון התחדש"

#: src/daemon.rs:710
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "תמונה אחת הורדה"
msgstr[1] "{n} תמונות הורדו"

#: src/daemon.rs:731
#, fuzzy
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "להוריד גם את Proton Photos"
msgstr[1] "להוריד גם את Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:405
msgid "Sign out"
msgstr "התנתקות"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "תמונה אחת"
msgstr[1] "{n} תמונות"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "לסנכרן אליה ולשמור על מה שכבר קיים בה"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "להזיז אותה הצידה ולהתחיל מתיקייה ריקה"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] "{folder} כבר מכילה פריט אחד, שהסנכרון ימזג עם Proton Drive."
msgstr[1] "{folder} כבר מכילה {n} פריטים, שהסנכרון ימזג עם Proton Drive."

#: ui/src/bridge.rs:189
msgid "Starting…"
msgstr "בהפעלה…"

#: ui/src/bridge.rs:233
msgid "Confirm the code {code} in your browser"
msgstr "יש לאשר את הקוד {code} בדפדפן"

#: ui/src/bridge.rs:247
msgid "Sign-in failed: {reason}"
msgstr "ההתחברות נכשלה: {reason}"

#: ui/src/bridge.rs:259
msgid "Signed out"
msgstr "מנותק"

#: ui/src/bridge.rs:262
msgid "Sign-out failed: {reason}"
msgstr "ההתנתקות נכשלה: {reason}"

#: ui/src/bridge.rs:324
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. יש להפעיל מחדש את שירות הסנכרון כדי להשתמש בו."

#: ui/src/bridge.rs:327
msgid "Cannot change the folder: {reason}"
msgstr "לא ניתן לשנות את התיקייה: {reason}"

#: ui/src/bridge.rs:334
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "אין עדיין תיקיית סנכרון. יש להריץ: kpdrive setup"

#: ui/src/bridge.rs:338
msgid "Cannot create the ignore file: {reason}"
msgstr "לא ניתן ליצור את קובץ ההתעלמות: {reason}"

#: ui/src/bridge.rs:375
msgid "Checking the account…"
msgstr "בבדיקת החשבון…"

#: ui/src/bridge.rs:381
msgid "Opening the browser…"
msgstr "בפתיחת הדפדפן…"

#: ui/src/bridge.rs:387
msgid "Signing out…"
msgstr "בהתנתקות…"

#: ui/src/bridge.rs:413
msgid "Cannot read the log: {reason}"
msgstr "לא ניתן לקרוא את היומן: {reason}"

#: ui/src/bridge.rs:423 ui/src/bridge.rs:451 ui/src/bridge.rs:467
#: ui/src/bridge.rs:480 ui/src/bridge.rs:498
msgid "Cannot save the setting: {reason}"
msgstr "לא ניתן לשמור את ההגדרה: {reason}"

#: ui/src/bridge.rs:431
msgid "Proton Photos will be downloaded with the next sync"
msgstr "תמונות Proton Photos יורדו בסנכרון הבא"

#: ui/src/bridge.rs:432
msgid "Proton Photos will be left alone"
msgstr "Proton Photos יישאר ללא שינוי"

#: ui/src/bridge.rs:457
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr ""

#: ui/src/bridge.rs:458
msgid "No longer uploading photos"
msgstr ""

#: ui/src/bridge.rs:485
msgid "Storing everything from now on"
msgstr "מעתה יאוחסן הכול"

#: ui/src/bridge.rs:486
msgid "Storing warnings and errors from now on"
msgstr "מעתה יאוחסנו אזהרות ושגיאות"

#: ui/src/bridge.rs:487
msgid "Storing errors from now on"
msgstr "מעתה יאוחסנו שגיאות"

#: ui/src/bridge.rs:503
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "הוסר קובץ יומן אחד ישן מ־{days} ימים"
msgstr[1] "הוסרו {n} קובצי יומן ישנים מ־{days} ימים"

#: ui/src/bridge.rs:504
msgid "Cannot prune the log: {reason}"
msgstr "לא ניתן לנקות את היומן: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "בחירת תיקיית Proton Drive"

#: ui/qml/main.qml:34
msgid "Choose the folder to upload photos from"
msgstr ""

#: ui/qml/main.qml:45
msgid "The folder is not empty"
msgstr "התיקייה אינה ריקה"

#: ui/qml/main.qml:80
msgid "Opened {what}"
msgstr "{what} נפתח"

#: ui/qml/main.qml:82
msgid "Could not open {what} ({url})"
msgstr "לא ניתן לפתוח את {what} ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:138
msgid "Account"
msgstr "חשבון"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:140
msgid "Logs"
msgstr "יומנים"

#: ui/qml/main.qml:177
msgid "Not signed in"
msgstr "לא מחובר"

#: ui/qml/main.qml:184
msgid "Signed in to Proton Drive"
msgstr "מחובר אל Proton Drive"

#: ui/qml/main.qml:185
msgid "Sign in to sync this computer with Proton Drive."
msgstr "יש להתחבר כדי לסנכרן מחשב זה עם Proton Drive."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:206
msgid "Storage"
msgstr "אחסון"

#: ui/qml/main.qml:234
msgid "{used} of {total} used"
msgstr "{used} מתוך {total} בשימוש"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:246
msgid "Syncing to"
msgstr "מסתנכרן אל"

#: ui/qml/main.qml:250
msgid "nowhere yet"
msgstr "עדיין לשום מקום"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:257 ui/qml/main.qml:324
msgid "Change…"
msgstr "שינוי…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:264
msgid "Ignore file…"
msgstr "קובץ התעלמות…"

#: ui/qml/main.qml:276
msgid "Also download Proton Photos"
msgstr "להוריד גם את Proton Photos"

#: ui/qml/main.qml:284
#, fuzzy
msgid ""
"Your timeline is copied into {folder}, checked every half hour. Nothing in "
"Proton Photos is changed or deleted by it."
msgstr ""
"לקריאה בלבד: ציר הזמן שלך מועתק אל {folder}. תמונות לעולם אינן מועלות, "
"משתנות או נמחקות ב־Proton Photos, והעותק נבדק בכל חצי שעה."

#: ui/qml/main.qml:285
msgid "your Pictures folder"
msgstr "תיקיית התמונות שלך"

#: ui/qml/main.qml:297
msgid "Upload photos from a folder"
msgstr ""

#: ui/qml/main.qml:333
msgid "Delete uploaded photos instead of moving them to the trash"
msgstr ""

#: ui/qml/main.qml:341
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""

#: ui/qml/main.qml:388
msgid "Drive on the web"
msgstr "Drive באינטרנט"

#: ui/qml/main.qml:393
msgid "Proton account"
msgstr "חשבון Proton"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:399
msgid "Refresh"
msgstr "רענון"

#: ui/qml/main.qml:405
msgid "Sign in"
msgstr "התחברות"

#: ui/qml/main.qml:448
msgid "Read the licence"
msgstr "קריאת הרישיון"

#: ui/qml/main.qml:466
msgid "Search the log"
msgstr "חיפוש ביומן"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:512
msgid "Copy"
msgstr "העתקה"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:518
msgid "Select all"
msgstr "בחירת הכול"

#: ui/qml/main.qml:535
msgid "No lines match"
msgstr "אין שורות תואמות"

#: ui/qml/main.qml:535
msgid "Nothing logged yet"
msgstr "עדיין לא נרשם דבר"

#: ui/qml/main.qml:537
msgid "No line since the sync daemon started contains “{term}”."
msgstr "אף שורה מאז הפעלת שירות הסנכרון אינה מכילה „{term}”."

#: ui/qml/main.qml:538
msgid "This shows what has happened since the sync daemon started."
msgstr "כאן מוצג מה שקרה מאז הפעלת שירות הסנכרון."

#. TRANSLATORS: start of "Keep logs for [30] days"; the number and "days" follow
#: ui/qml/main.qml:547
msgid "Keep logs for"
msgstr "שמירת יומנים למשך"

#. TRANSLATORS: end of "Keep logs for [30] days"
#: ui/qml/main.qml:557
msgid "days"
msgstr "ימים"

#. TRANSLATORS: verb, label before a dropdown choosing which log levels are written to disk
#: ui/qml/main.qml:562
msgid "Store"
msgstr "אחסון"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:570
msgid "Warnings and errors"
msgstr "אזהרות ושגיאות"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:572
msgid "Everything"
msgstr "הכול"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:574
msgid "Errors only"
msgstr "שגיאות בלבד"

#: ui/qml/main.qml:583
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "שורה אחת"
msgstr[1] "{n} שורות"

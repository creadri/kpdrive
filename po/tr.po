msgid "Sign out"
msgstr "Oturumu kapat"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} fotoğraf"
msgstr[1] "{n} fotoğraf"

#: src/pause.rs:20
msgid "Paused"
msgstr "Duraklatıldı"

#: src/pause.rs:27
msgid "Paused while on AC power"

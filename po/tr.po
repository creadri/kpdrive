#: src/daemon.rs:98
msgid "Signed out. Sign in from the account window."
msgstr "Oturum kapatıldı. Hesap penceresinden oturum açın."

#: src/daemon.rs:100 src/daemon.rs:341
msgid "Syncing…"
msgstr "Eşitleniyor…"

#: src/daemon.rs:102 src/daemon.rs:344
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} öge eşitlemede"
msgstr[1] "{n} öge eşitlemede"

#: src/daemon.rs:112 ui/qml/main.qml:313
msgid "Open folder"
msgstr "Klasörü aç"

#: src/daemon.rs:122
msgid "Account and logs…"
msgstr "Hesap ve günlükler…"

#: src/daemon.rs:129 ui/qml/main.qml:291
msgid "Sync now"
msgstr "Şimdi eşitle"

#: src/daemon.rs:139
msgid "Quit"
msgstr "Çık"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:273
msgid "{reason}; retrying"
msgstr "{reason}; yeniden deneniyor"

#: src/daemon.rs:284
msgid "Proton Drive is reachable again, after {duration}"
msgstr "{duration} sonra Proton Drive yeniden erişilebilir"

#: src/daemon.rs:295
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} saniye"
msgstr[1] "{n} saniye"

#: src/daemon.rs:296
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} dakika"
msgstr[1] "{n} dakika"

#: src/daemon.rs:297
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} saat"
msgstr[1] "{n} saat"

#: src/daemon.rs:325
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "Eşitleme hizmeti çalışmıyor. Şununla başlatın: kpdrive sync --watch"

#: src/daemon.rs:328
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr "Bir eşitleme hizmeti çalışıyor; ancak ne yaptığını bildiremeyecek kadar eski. Yeniden başlatın."

#: src/daemon.rs:331
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Oturum kapatıldı. Oturum açtığınızda eşitleme sürdürülür."

#: src/daemon.rs:335
msgid "{reason}. Still trying."
msgstr "{reason}. Denemeye devam ediliyor."

#: src/daemon.rs:336
msgid "Last sync failed: {reason}"
msgstr "Son eşitleme başarısız oldu: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:350
msgid "just now"
msgstr "az önce"

#: src/daemon.rs:352
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} dakika önce"
msgstr[1] "{n} dakika önce"

#: src/daemon.rs:355
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} saat önce"
msgstr[1] "{n} saat önce"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:359
msgid "{items}, checked {ago}"
msgstr "{items}, {ago} denetlendi"

#: src/daemon.rs:576
msgid "Signed in again. Syncing resumed."
msgstr "Yeniden oturum açıldı. Eşitleme sürdürüldü."

#: src/daemon.rs:630
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "Oturum kapatıldı. Eşitlemeyi sürdürmek için hesap penceresinden oturum açın."

#: src/daemon.rs:663
msgid "Sync resumed"
msgstr "Eşitleme sürdürüldü"

#: src/daemon.rs:680
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} fotoğraf indirildi"
msgstr[1] "{n} fotoğraf indirildi"

#: src/i18n.rs:111 ui/qml/main.qml:336
msgid "Sign out"
msgstr "Oturumu kapat"

#: src/i18n.rs:112 src/i18n.rs:113
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} fotoğraf"
msgstr[1] "{n} fotoğraf"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "İçine eşitle ve orada olanları koru"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Kenara taşı ve boş bir klasörle başla"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] "{folder} klasöründe halihazırda {n} öge var; eşitleme bunu Proton Drive ile birleştirecek."
msgstr[1] "{folder} klasöründe halihazırda {n} öge var; eşitleme bunları Proton Drive ile birleştirecek."

#: ui/src/bridge.rs:175
msgid "Starting…"
msgstr "Başlatılıyor…"

#: ui/src/bridge.rs:217
msgid "Confirm the code {code} in your browser"
msgstr "Tarayıcınızda {code} kodunu onaylayın"

#: ui/src/bridge.rs:231
msgid "Sign-in failed: {reason}"
msgstr "Oturum açma başarısız oldu: {reason}"

#: ui/src/bridge.rs:243
msgid "Signed out"
msgstr "Oturum kapatıldı"

#: ui/src/bridge.rs:246
msgid "Sign-out failed: {reason}"
msgstr "Oturum kapatma başarısız oldu: {reason}"

#: ui/src/bridge.rs:305
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}. Kullanmak için eşitleme hizmetini yeniden başlatın."

#: ui/src/bridge.rs:308
msgid "Cannot change the folder: {reason}"
msgstr "Klasör değiştirilemiyor: {reason}"

#: ui/src/bridge.rs:315
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Henüz eşitleme klasörü yok. Şunu çalıştırın: kpdrive setup"

#: ui/src/bridge.rs:319
msgid "Cannot create the ignore file: {reason}"
msgstr "Yok sayma dosyası oluşturulamıyor: {reason}"

#: ui/src/bridge.rs:356
msgid "Checking the account…"
msgstr "Hesap denetleniyor…"

#: ui/src/bridge.rs:362
msgid "Opening the browser…"
msgstr "Tarayıcı açılıyor…"

#: ui/src/bridge.rs:368
msgid "Signing out…"
msgstr "Oturum kapatılıyor…"

#: ui/src/bridge.rs:394
msgid "Cannot read the log: {reason}"
msgstr "Günlük okunamıyor: {reason}"

#: ui/src/bridge.rs:404 ui/src/bridge.rs:425 ui/src/bridge.rs:443
msgid "Cannot save the setting: {reason}"
msgstr "Ayar kaydedilemiyor: {reason}"

#: ui/src/bridge.rs:412
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos, sonraki eşitlemeyle indirilecek"

#: ui/src/bridge.rs:413
msgid "Proton Photos will be left alone"
msgstr "Proton Photos'a dokunulmayacak"

#: ui/src/bridge.rs:430
msgid "Storing everything from now on"
msgstr "Bundan sonra her şey saklanacak"

#: ui/src/bridge.rs:431
msgid "Storing warnings and errors from now on"
msgstr "Bundan sonra uyarılar ve hatalar saklanacak"

#: ui/src/bridge.rs:432
msgid "Storing errors from now on"
msgstr "Bundan sonra yalnızca hatalar saklanacak"

#: ui/src/bridge.rs:448
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "{days} günden eski {n} günlük dosyası kaldırıldı"
msgstr[1] "{days} günden eski {n} günlük dosyası kaldırıldı"

#: ui/src/bridge.rs:449
msgid "Cannot prune the log: {reason}"
msgstr "Günlük temizlenemiyor: {reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "Proton Drive klasörünü seçin"

#: ui/qml/main.qml:38
msgid "The folder is not empty"
msgstr "Klasör boş değil"

#: ui/qml/main.qml:73
msgid "Opened {what}"
msgstr "{what} açıldı"

#: ui/qml/main.qml:75
msgid "Could not open {what} ({url})"
msgstr "{what} açılamadı ({url})"

#. TRANSLATORS: tab label, the page showing the signed-in account
#: ui/qml/main.qml:131
msgid "Account"
msgstr "Hesap"

#. TRANSLATORS: tab label, the page showing the activity log
#: ui/qml/main.qml:133
msgid "Logs"
msgstr "Günlükler"

#: ui/qml/main.qml:164
msgid "Not signed in"
msgstr "Oturum açılmadı"

#: ui/qml/main.qml:171
msgid "Signed in to Proton Drive"
msgstr "Proton Drive'da oturum açıldı"

#: ui/qml/main.qml:172
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Bu bilgisayarı Proton Drive ile eşitlemek için oturum açın."

#. TRANSLATORS: heading above the bar showing how much of the account is used
#: ui/qml/main.qml:193
msgid "Storage"
msgstr "Depolama"

#: ui/qml/main.qml:221
msgid "{used} of {total} used"
msgstr "{used} / {total} kullanıldı"

#. TRANSLATORS: label before the path of the sync folder, as in "Syncing to /home/you/ProtonDrive"
#: ui/qml/main.qml:233
msgid "Syncing to"
msgstr "Şuraya eşitleniyor:"

#: ui/qml/main.qml:237
msgid "nowhere yet"
msgstr "henüz hiçbir yere"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:244
msgid "Change…"
msgstr "Değiştir…"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves alone
#: ui/qml/main.qml:251
msgid "Ignore file…"
msgstr "Yok sayma dosyası…"

#: ui/qml/main.qml:263
msgid "Also download Proton Photos"
msgstr "Proton Photos'u da indir"

#: ui/qml/main.qml:271
msgid ""
"Read-only: your timeline is copied into {folder}. Photos are never uploaded, "
"changed or deleted in Proton Photos, and the copy is checked every half hour."
msgstr "Salt okunur: zaman tüneliniz şuraya kopyalanır: {folder}. Fotoğraflar Proton Photos'a hiçbir zaman yüklenmez, orada değiştirilmez veya silinmez ve kopya her yarım saatte bir denetlenir."

#: ui/qml/main.qml:272
msgid "your Pictures folder"
msgstr "Resimler klasörünüz"

#: ui/qml/main.qml:319
msgid "Drive on the web"
msgstr "Web'de Drive"

#: ui/qml/main.qml:324
msgid "Proton account"
msgstr "Proton hesabı"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:330
msgid "Refresh"
msgstr "Yenile"

#: ui/qml/main.qml:336
msgid "Sign in"
msgstr "Oturum aç"

#: ui/qml/main.qml:379
msgid "Read the licence"
msgstr "Lisansı oku"

#: ui/qml/main.qml:397
msgid "Search the log"
msgstr "Günlükte ara"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:443
msgid "Copy"
msgstr "Kopyala"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:449
msgid "Select all"
msgstr "Tümünü seç"

#: ui/qml/main.qml:466
msgid "No lines match"
msgstr "Eşleşen satır yok"

#: ui/qml/main.qml:466
msgid "Nothing logged yet"
msgstr "Henüz günlüğe bir şey yazılmadı"

#: ui/qml/main.qml:468
msgid "No line since the sync daemon started contains “{term}”."
msgstr "Eşitleme hizmeti başladığından beri hiçbir satır şunu içermiyor: “{term}”."

#: ui/qml/main.qml:469
msgid "This shows what has happened since the sync daemon started."
msgstr "Burada, eşitleme hizmeti başladığından beri neler olduğu gösterilir."

#. TRANSLATORS: start of "Keep logs for [30] days"; the number and "days" follow
#: ui/qml/main.qml:478
msgid "Keep logs for"
msgstr "Günlükleri saklama süresi"

#. TRANSLATORS: end of "Keep logs for [30] days"
#: ui/qml/main.qml:488
msgid "days"
msgstr "gün"

#. TRANSLATORS: verb, label before a dropdown choosing which log levels are written to disk
#: ui/qml/main.qml:493
msgid "Store"
msgstr "Sakla"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:501
msgid "Warnings and errors"
msgstr "Uyarılar ve hatalar"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:503
msgid "Everything"
msgstr "Her şey"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:505
msgid "Errors only"
msgstr "Yalnızca hatalar"

#: ui/qml/main.qml:514
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} satır"
msgstr[1] "{n} satır"

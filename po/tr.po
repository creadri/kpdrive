msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} saat"
msgstr[1] "{n} saat"

#: src/daemon.rs:382
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "Eşitleme hizmeti çalışmıyor. Şununla başlatın: kpdrive sync --watch"

#: src/daemon.rs:385
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Bir eşitleme hizmeti çalışıyor; ancak ne yaptığını bildiremeyecek kadar "
"eski. Yeniden başlatın."

#: src/daemon.rs:391
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Oturum kapatıldı. Oturum açtığınızda eşitleme sürdürülür."

#: src/daemon.rs:395
msgid "{reason}. Still trying."
msgstr "{reason}. Denemeye devam ediliyor."

#: src/daemon.rs:396
msgid "Last sync failed: {reason}"
msgstr "Son eşitleme başarısız oldu: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:410
msgid "just now"
msgstr "az önce"

#: src/daemon.rs:412
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} dakika önce"
msgstr[1] "{n} dakika önce"

#: src/daemon.rs:415
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} saat önce"
msgstr[1] "{n} saat önce"


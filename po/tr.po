#: src/daemon.rs:155
msgid "Pause sync"
msgstr "Eşitlemeyi duraklat"

#: src/daemon.rs:168
msgid "Quit"
msgstr "Çık"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"

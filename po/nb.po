#: src/daemon.rs:67 src/daemon.rs:174
msgid "Signed out. Sign in from the account window."
msgstr "Logget ut. Logg inn fra kontovinduet."

#: src/daemon.rs:69 src/daemon.rs:535
msgid "Syncing…"
msgstr "Synkroniserer…"

#: src/daemon.rs:71 src/daemon.rs:538
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} element synkronisert"
msgstr[1] "{n} elementer synkronisert"

#: src/daemon.rs:199 src/daemon.rs:201 ui/qml/main.qml:469
msgid "Open folder"
msgstr "Åpne mappe"

#: src/daemon.rs:211
msgid "Account and logs…"
msgstr "Konto og logg…"

#: src/daemon.rs:218 ui/qml/main.qml:456
msgid "Sync now"
msgstr "Synkroniser nå"

#: src/daemon.rs:230
msgid "Pause sync"
msgstr "Sett synkronisering på pause"

#: src/daemon.rs:243
msgid "Quit"
msgstr "Avslutt"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:430
msgid "{reason}; retrying"
msgstr "{reason}; prøver igjen"

#: src/daemon.rs:441
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive er tilgjengelig igjen, etter {duration}"

#: src/daemon.rs:452
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} sekund"
msgstr[1] "{n} sekunder"

#: src/daemon.rs:453
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minutt"
msgstr[1] "{n} minutter"

#: src/daemon.rs:454
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} time"
msgstr[1] "{n} timer"

#: src/daemon.rs:502
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"Synkroniseringstjenesten kjører ikke. Start den med: kpdrive sync --watch"

#: src/daemon.rs:505
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"En synkroniseringstjeneste kjører, men den er for gammel til å si hva den "
"gjør. Start den på nytt."

#: src/daemon.rs:516 src/daemon.rs:525
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Logget ut. Synkroniseringen fortsetter når du logger inn."

#: src/daemon.rs:529
msgid "{reason}. Still trying."
msgstr "{reason}. Prøver fortsatt."

#: src/daemon.rs:530
msgid "Last sync failed: {reason}"
msgstr "Siste synkronisering mislyktes: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:544
msgid "just now"
msgstr "akkurat nå"

#: src/daemon.rs:546
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "for {n} minutt siden"
msgstr[1] "for {n} minutter siden"

#: src/daemon.rs:549
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "for {n} time siden"
msgstr[1] "for {n} timer siden"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:553
msgid "{items}, checked {ago}"
msgstr "{items}, kontrollert {ago}"

#: src/daemon.rs:924
msgid "Signed in again. Syncing resumed."
msgstr "Logget inn igjen. Synkroniseringen er gjenopptatt."

#: src/daemon.rs:938
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "Logget ut. Logg inn fra kontovinduet for å gjenoppta synkroniseringen."

#: src/daemon.rs:1050
msgid "Sync resumed"
msgstr "Synkronisering gjenopptatt"

#: src/daemon.rs:1067
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} bilde lastet ned"
msgstr[1] "{n} bilder lastet ned"

#: src/daemon.rs:1086
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} bilde lastet opp til Proton Photos"
msgstr[1] "{n} bilder lastet opp til Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:387
msgid "Sign out"
msgstr "Logg ut"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} bilde"
msgstr[1] "{n} bilder"

#: src/pause.rs:20
msgid "Paused"
msgstr "På pause"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "På pause mens maskinen går på nettstrøm"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "På pause mens maskinen går på batteri"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "På pause mens batteriet er lavt"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "På pause mens {network} er tilkoblet"

#: src/sync.rs:124
msgid "Sync into it and keep what is already there"
msgstr "Synkroniser inn i den og behold det som allerede finnes"

#: src/sync.rs:125
msgid "Move it aside and start from an empty folder"
msgstr "Flytt den til side og start med en tom mappe"

#: src/sync.rs:163
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"{folder} inneholder allerede {n} element, som synkroniseringen slår sammen "
"med Proton Drive."
msgstr[1] ""
"{folder} inneholder allerede {n} elementer, som synkroniseringen slår sammen "
"med Proton Drive."

#: ui/src/bridge.rs:260
msgid "Starting…"
msgstr "Starter…"

#: ui/src/bridge.rs:317
msgid "Confirm the code {code} in your browser"
msgstr "Bekreft koden {code} i nettleseren"

#: ui/src/bridge.rs:331
msgid "Sign-in failed: {reason}"
msgstr "Innloggingen mislyktes: {reason}"

#: ui/src/bridge.rs:344
msgid "Signed out"
msgstr "Logget ut"

#: ui/src/bridge.rs:347
msgid "Sign-out failed: {reason}"
msgstr "Utloggingen mislyktes: {reason}"

#: ui/src/bridge.rs:355
msgid "Removed {account}. Its files were left where they are."
msgstr "{account} er fjernet. Filene ble liggende der de er."

#: ui/src/bridge.rs:362
msgid "Cannot remove the account: {reason}"
msgstr "Kan ikke fjerne kontoen: {reason}"

#: ui/src/bridge.rs:481
msgid "Cannot change the folder: {reason}"
msgstr "Kan ikke endre mappen: {reason}"

#: ui/src/bridge.rs:488
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Ingen synkroniseringsmappe ennå. Kjør: kpdrive setup"

#: ui/src/bridge.rs:492
msgid "Cannot create the ignore file: {reason}"
msgstr "Kan ikke opprette ignorer-filen: {reason}"

#: ui/src/bridge.rs:537
msgid "Checking the account…"
msgstr "Kontrollerer kontoen…"

#: ui/src/bridge.rs:543
msgid "Opening the browser…"
msgstr "Åpner nettleseren…"

#: ui/src/bridge.rs:550
msgid "Signing out…"
msgstr "Logger ut…"

#: ui/src/bridge.rs:557
msgid "Removing the account…"
msgstr "Fjerner kontoen…"

#: ui/src/bridge.rs:583
msgid "Cannot read the log: {reason}"
msgstr "Kan ikke lese loggen: {reason}"

#: ui/src/bridge.rs:591 ui/src/bridge.rs:618 ui/src/bridge.rs:632
#: ui/src/bridge.rs:647 ui/src/bridge.rs:681 ui/src/bridge.rs:723
#: ui/src/bridge.rs:736 ui/src/bridge.rs:754
msgid "Cannot save the setting: {reason}"
msgstr "Kan ikke lagre innstillingen: {reason}"

#: ui/src/bridge.rs:599
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos lastes ned ved neste synkronisering"

#: ui/src/bridge.rs:600
msgid "Proton Photos will be left alone"
msgstr "Proton Photos røres ikke"

#: ui/src/bridge.rs:624
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr "Bilder som legges i den mappen, lastes opp til Proton Photos"

#: ui/src/bridge.rs:625
msgid "No longer uploading photos"
msgstr "Laster ikke lenger opp bilder"

#: ui/src/bridge.rs:717
msgid "Photos will be downloaded into that folder from the next pass"
msgstr "Bilder lastes ned til den mappen fra og med neste runde"

#: ui/src/bridge.rs:741
msgid "Storing everything from now on"
msgstr "Lagrer alt fra nå av"

#: ui/src/bridge.rs:742
msgid "Storing warnings and errors from now on"
msgstr "Lagrer advarsler og feil fra nå av"

#: ui/src/bridge.rs:743
msgid "Storing errors from now on"
msgstr "Lagrer feil fra nå av"

#: ui/src/bridge.rs:759
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "fjernet {n} loggfil som er eldre enn {days} dager"
msgstr[1] "fjernet {n} loggfiler som er eldre enn {days} dager"

#: ui/src/bridge.rs:760
msgid "Cannot prune the log: {reason}"
msgstr "Kan ikke rydde opp i loggen: {reason}"

#: ui/qml/main.qml:28
msgid "Choose the Proton Drive folder"
msgstr "Velg Proton Drive-mappen"

#: ui/qml/main.qml:35
msgid "Choose where Proton Photos are downloaded"
msgstr "Velg hvor Proton Photos skal lastes ned"

#: ui/qml/main.qml:42
msgid "Choose the folder to upload photos from"
msgstr "Velg mappen bilder skal lastes opp fra"

#: ui/qml/main.qml:53
msgid "The folder is not empty"
msgstr "Mappen er ikke tom"

#: ui/qml/main.qml:80
msgid "Remove {account}?"
msgstr "Fjerne {account}?"

#: ui/qml/main.qml:81
msgid ""
"kpdrive signs this account out and forgets what it synced. The files in "
"{folder} stay where they are."
msgstr ""
"kpdrive logger ut denne kontoen og glemmer hva den har synkronisert. Filene "
"i {folder} blir liggende der de er."

#: ui/qml/main.qml:82
msgid "its folder"
msgstr "mappen dens"

#: ui/qml/main.qml:86
msgid "Remove account"
msgstr "Fjern konto"

#: ui/qml/main.qml:94
msgid "Cancel"
msgstr "Avbryt"

#: ui/qml/main.qml:130
msgid "Opened {what}"
msgstr "Åpnet {what}"

#: ui/qml/main.qml:132
msgid "Could not open {what} ({url})"
msgstr "Kunne ikke åpne {what} ({url})"

#: ui/qml/main.qml:223 ui/qml/main.qml:225
msgid "Add account"
msgstr "Legg til konto"

#: ui/qml/main.qml:237
msgid "Account & activity"
msgstr "Konto og aktivitet"

#: ui/qml/main.qml:238
msgid "Settings"
msgstr "Innstillinger"

#: ui/qml/main.qml:239 ui/qml/main.qml:701
msgid "Logs"
msgstr "Logg"

#: ui/qml/main.qml:240
msgid "About"
msgstr "Om"

#: ui/qml/main.qml:320
msgid "Not signed in"
msgstr "Ikke logget inn"

#: ui/qml/main.qml:327
msgid "Signed in to Proton Drive"
msgstr "Logget inn på Proton Drive"

#: ui/qml/main.qml:329
msgid "Signed out. Sign in again to resume syncing this account."
msgstr ""
"Logget ut. Logg inn igjen for å gjenoppta synkroniseringen av denne kontoen."

#: ui/qml/main.qml:330
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Logg inn for å synkronisere denne datamaskinen med Proton Drive."

#: ui/qml/main.qml:347
msgid "Storage:"
msgstr "Lagring:"

#: ui/qml/main.qml:376
msgid "{used} of {total} used"
msgstr "{used} av {total} brukt"

#: ui/qml/main.qml:384 ui/qml/main.qml:489
msgid "Account:"
msgstr "Konto:"

#: ui/qml/main.qml:387
msgid "Sign in"
msgstr "Logg inn"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:394
msgid "Refresh"
msgstr "Oppdater"

#: ui/qml/main.qml:401
msgid "Remove account…"
msgstr "Fjern konto…"

#: ui/qml/main.qml:410
msgid "On the web:"
msgstr "På nettet:"

#: ui/qml/main.qml:413
msgid "Drive on the web"
msgstr "Drive på nettet"

#: ui/qml/main.qml:418
msgid "Proton account"
msgstr "Proton-konto"

#: ui/qml/main.qml:426
msgid "Activity"
msgstr "Aktivitet"

#: ui/qml/main.qml:433
msgid "Sync:"
msgstr "Synkronisering:"

#: ui/qml/main.qml:464
msgid "Resume"
msgstr "Gjenoppta"

#: ui/qml/main.qml:464
msgid "Pause"
msgstr "Pause"

#: ui/qml/main.qml:497
msgid "Files"
msgstr "Filer"

#: ui/qml/main.qml:501
msgid "Sync folder:"
msgstr "Synkroniseringsmappe:"

#: ui/qml/main.qml:505
msgid "nowhere yet"
msgstr "ingen ennå"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:511 ui/qml/main.qml:558 ui/qml/main.qml:601
msgid "Change…"
msgstr "Endre…"

#: ui/qml/main.qml:518
msgid "Ignored paths:"
msgstr "Ignorerte stier:"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves
#. alone
#: ui/qml/main.qml:520
msgid "Ignore file…"
msgstr "Ignorer-fil…"

#: ui/qml/main.qml:527
msgid "Photos"
msgstr "Bilder"

#: ui/qml/main.qml:531
msgid "Download:"
msgstr "Nedlasting:"

#: ui/qml/main.qml:535
msgid "Also download Proton Photos"
msgstr "Last ned Proton Photos også"

#: ui/qml/main.qml:541
msgid ""
"Your timeline is copied here every half hour. Nothing in Proton Photos is "
"changed or deleted by it."
msgstr ""
"Tidslinjen din kopieres hit hver halvtime. Ingenting i Proton Photos endres "
"eller slettes av dette."

#: ui/qml/main.qml:549
msgid "Download folder:"
msgstr "Nedlastingsmappe:"

#: ui/qml/main.qml:553
msgid "your Pictures folder"
msgstr "Bilder-mappen din"

#: ui/qml/main.qml:565
msgid "Upload:"
msgstr "Opplasting:"

#: ui/qml/main.qml:569
msgid "Upload photos from a folder"
msgstr "Last opp bilder fra en mappe"

#: ui/qml/main.qml:583
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""
"Bilder og videoer som legges i denne mappen, lastes opp til Proton Photos "
"innen ett minutt og fjernes deretter fra mappen. Det som ikke kan lastes "
"opp, blir liggende."

#: ui/qml/main.qml:591
msgid "Upload folder:"
msgstr "Opplastingsmappe:"

#: ui/qml/main.qml:608
msgid "After upload:"
msgstr "Etter opplasting:"

#: ui/qml/main.qml:610
msgid "Delete instead of moving to the trash"
msgstr "Slett i stedet for å flytte til papirkurven"

#: ui/qml/main.qml:617
msgid "Network"
msgstr "Nettverk"

#: ui/qml/main.qml:621 ui/qml/main.qml:666
msgid "Pause while on:"
msgstr "Sett på pause ved:"

#: ui/qml/main.qml:641
msgid "{network} (connected)"
msgstr "{network} (tilkoblet)"

#: ui/qml/main.qml:652
msgid ""
"Syncing pauses while any ticked network is connected, such as a phone's "
"hotspot. A sync already under way finishes first."
msgstr ""
"Synkroniseringen settes på pause så lenge et avkrysset nettverk er "
"tilkoblet, for eksempel en Wi-Fi-sone fra en telefon. En synkronisering som "
"allerede er i gang, fullføres først."

#: ui/qml/main.qml:653
msgid "NetworkManager lists no networks to choose from."
msgstr "NetworkManager viser ingen nettverk å velge mellom."

#: ui/qml/main.qml:662
msgid "Power"
msgstr "Strøm"

#: ui/qml/main.qml:672
msgid "AC power"
msgstr "Nettstrøm"

#: ui/qml/main.qml:673
msgid "Battery"
msgstr "Batteri"

#: ui/qml/main.qml:674
msgid "Low battery"
msgstr "Lavt batteri"

#: ui/qml/main.qml:682
msgid "{power} (now)"
msgstr "{power} (nå)"

#: ui/qml/main.qml:692
msgid ""
"Low battery is the level set in the system's power management settings. A "
"sync already under way finishes first."
msgstr ""
"Lavt batteri er nivået som er angitt i systemets innstillinger for "
"strømstyring. En synkronisering som allerede er i gang, fullføres først."

#: ui/qml/main.qml:705
msgid "Keep logs for:"
msgstr "Behold logg i:"

#. TRANSLATORS: after the number in "Keep logs for: [30] days"
#: ui/qml/main.qml:714
msgid "days"
msgstr "dager"

#. TRANSLATORS: label before a dropdown choosing which log levels are written
#. to disk
#: ui/qml/main.qml:719
msgid "Store:"
msgstr "Lagre:"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:724
msgid "Warnings and errors"
msgstr "Advarsler og feil"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:726
msgid "Everything"
msgstr "Alt"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:728
msgid "Errors only"
msgstr "Bare feil"

#: ui/qml/main.qml:749
msgid "Search the log"
msgstr "Søk i loggen"

#: ui/qml/main.qml:754
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} linje"
msgstr[1] "{n} linjer"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:804
msgid "Copy"
msgstr "Kopier"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:810
msgid "Select all"
msgstr "Merk alt"

#: ui/qml/main.qml:827
msgid "No lines match"
msgstr "Ingen linjer samsvarer"

#: ui/qml/main.qml:827
msgid "Nothing logged yet"
msgstr "Ingenting logget ennå"

#: ui/qml/main.qml:829
msgid "No line since the sync daemon started contains “{term}”."
msgstr ""
"Ingen linje siden synkroniseringstjenesten startet inneholder «{term}»."

#: ui/qml/main.qml:830
msgid "This shows what has happened since the sync daemon started."
msgstr "Her vises hva som har skjedd siden synkroniseringstjenesten startet."

#: ui/qml/main.qml:862
msgid "Proton Drive sync client for KDE Plasma"
msgstr "Proton Drive-synkroniseringsklient for KDE Plasma"


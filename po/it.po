#: src/daemon.rs:112
msgid "Signed out. Sign in from the account window."
msgstr "Disconnesso. Accedi dalla finestra dell'account."

#: src/daemon.rs:114 src/daemon.rs:401
msgid "Syncing…"
msgstr "Sincronizzazione…"

#: src/daemon.rs:116 src/daemon.rs:404
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n} elemento sincronizzato"
msgstr[1] "{n} elementi sincronizzati"

#: src/daemon.rs:126 ui/qml/main.qml:409
msgid "Open folder"
msgstr "Apri cartella"

#: src/daemon.rs:136
msgid "Account and logs…"
msgstr "Account e registri…"

#: src/daemon.rs:143 ui/qml/main.qml:396
msgid "Sync now"
msgstr "Sincronizza ora"

#: src/daemon.rs:155
msgid "Pause sync"
msgstr "Sospendi la sincronizzazione"

#: src/daemon.rs:168
msgid "Quit"
msgstr "Esci"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no
#. route"
#: src/daemon.rs:328
msgid "{reason}; retrying"
msgstr "{reason}; nuovo tentativo in corso"

#: src/daemon.rs:339
msgid "Proton Drive is reachable again, after {duration}"
msgstr "Proton Drive è di nuovo raggiungibile, dopo {duration}"

#: src/daemon.rs:350
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n} secondo"
msgstr[1] "{n} secondi"

#: src/daemon.rs:351
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} minuto"
msgstr[1] "{n} minuti"

#: src/daemon.rs:352
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} ora"
msgstr[1] "{n} ore"

#: src/daemon.rs:382
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr ""
"Il servizio di sincronizzazione non è in esecuzione. Avvialo con: kpdrive "
"sync --watch"

#: src/daemon.rs:385
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr ""
"Un servizio di sincronizzazione è in esecuzione, ma è troppo vecchio per "
"indicare cosa sta facendo. Riavvialo."

#: src/daemon.rs:391
msgid "Signed out. Syncing resumes once you sign in."
msgstr "Disconnesso. La sincronizzazione riprende dopo l'accesso."

#: src/daemon.rs:395
msgid "{reason}. Still trying."
msgstr "{reason}. Nuovi tentativi in corso."

#: src/daemon.rs:396
msgid "Last sync failed: {reason}"
msgstr "Ultima sincronizzazione non riuscita: {reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:410
msgid "just now"
msgstr "proprio ora"

#: src/daemon.rs:412
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} minuto fa"
msgstr[1] "{n} minuti fa"

#: src/daemon.rs:415
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} ora fa"
msgstr[1] "{n} ore fa"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes
#. ago"
#: src/daemon.rs:419
msgid "{items}, checked {ago}"
msgstr "{items}, ultimo controllo {ago}"

#: src/daemon.rs:637
msgid "Signed in again. Syncing resumed."
msgstr "Accesso effettuato di nuovo. Sincronizzazione ripresa."

#: src/daemon.rs:712
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr ""
"Disconnesso. Accedi dalla finestra dell'account per riprendere la "
"sincronizzazione."

#: src/daemon.rs:745
msgid "Sync resumed"
msgstr "Sincronizzazione ripresa"

#: src/daemon.rs:762
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "{n} foto scaricata"
msgstr[1] "{n} foto scaricate"

#: src/daemon.rs:783
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "{n} foto caricata su Proton Photos"
msgstr[1] "{n} foto caricate su Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:334
msgid "Sign out"
msgstr "Disconnetti"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n} foto"
msgstr[1] "{n} foto"

#: src/pause.rs:20
msgid "Paused"
msgstr "In pausa"

#: src/pause.rs:27
msgid "Paused while on AC power"
msgstr "In pausa con alimentazione da rete"

#: src/pause.rs:28
msgid "Paused while on battery"
msgstr "In pausa con alimentazione a batteria"

#: src/pause.rs:29
msgid "Paused while the battery is low"
msgstr "In pausa finché la batteria è scarica"

#: src/pause.rs:40
msgid "Paused while connected to {network}"
msgstr "In pausa durante la connessione a {network}"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "Sincronizza al suo interno e mantieni ciò che contiene già"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "Spostala altrove e parti da una cartella vuota"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] ""
"{folder} contiene già {n} elemento, che la sincronizzazione unirà a Proton "
"Drive."
msgstr[1] ""
"{folder} contiene già {n} elementi, che la sincronizzazione unirà a Proton "
"Drive."

#: ui/src/bridge.rs:237
msgid "Starting…"
msgstr "Avvio…"

#: ui/src/bridge.rs:288
msgid "Confirm the code {code} in your browser"
msgstr "Conferma il codice {code} nel browser"

#: ui/src/bridge.rs:302
msgid "Sign-in failed: {reason}"
msgstr "Accesso non riuscito: {reason}"

#: ui/src/bridge.rs:314
msgid "Signed out"
msgstr "Disconnesso"

#: ui/src/bridge.rs:317
msgid "Sign-out failed: {reason}"
msgstr "Disconnessione non riuscita: {reason}"

#: ui/src/bridge.rs:382
msgid "{note}. Restart the sync daemon to use it."
msgstr ""
"{note}. Riavvia il servizio di sincronizzazione per applicare la modifica."

#: ui/src/bridge.rs:385
msgid "Cannot change the folder: {reason}"
msgstr "Impossibile cambiare la cartella: {reason}"

#: ui/src/bridge.rs:392
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "Nessuna cartella di sincronizzazione. Esegui: kpdrive setup"

#: ui/src/bridge.rs:396
msgid "Cannot create the ignore file: {reason}"
msgstr "Impossibile creare il file di esclusione: {reason}"

#: ui/src/bridge.rs:434
msgid "Checking the account…"
msgstr "Controllo dell'account…"

#: ui/src/bridge.rs:440
msgid "Opening the browser…"
msgstr "Apertura del browser…"

#: ui/src/bridge.rs:446
msgid "Signing out…"
msgstr "Disconnessione…"

#: ui/src/bridge.rs:472
msgid "Cannot read the log: {reason}"
msgstr "Impossibile leggere il registro: {reason}"

#: ui/src/bridge.rs:482 ui/src/bridge.rs:510 ui/src/bridge.rs:524
#: ui/src/bridge.rs:539 ui/src/bridge.rs:573 ui/src/bridge.rs:614
#: ui/src/bridge.rs:627 ui/src/bridge.rs:645
msgid "Cannot save the setting: {reason}"
msgstr "Impossibile salvare l'impostazione: {reason}"

#: ui/src/bridge.rs:490
msgid "Proton Photos will be downloaded with the next sync"
msgstr "Proton Photos verrà scaricato con la prossima sincronizzazione"

#: ui/src/bridge.rs:491
msgid "Proton Photos will be left alone"
msgstr "Proton Photos non verrà scaricato"

#: ui/src/bridge.rs:516
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr "Le foto messe in quella cartella verranno caricate su Proton Photos"

#: ui/src/bridge.rs:517
msgid "No longer uploading photos"
msgstr "Le foto non vengono più caricate"

#: ui/src/bridge.rs:607
msgid "Photos will be downloaded into that folder from the next pass"
msgstr "Le foto verranno scaricate in quella cartella dal prossimo passaggio"

#: ui/src/bridge.rs:632
msgid "Storing everything from now on"
msgstr "D'ora in poi verrà registrato tutto"

#: ui/src/bridge.rs:633
msgid "Storing warnings and errors from now on"
msgstr "D'ora in poi verranno registrati avvisi ed errori"

#: ui/src/bridge.rs:634
msgid "Storing errors from now on"
msgstr "D'ora in poi verranno registrati solo gli errori"

#: ui/src/bridge.rs:650
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "rimosso {n} file di registro più vecchio di {days} giorni"
msgstr[1] "rimossi {n} file di registro più vecchi di {days} giorni"

#: ui/src/bridge.rs:651
msgid "Cannot prune the log: {reason}"
msgstr "Impossibile ripulire il registro: {reason}"

#: ui/qml/main.qml:28
msgid "Choose the Proton Drive folder"
msgstr "Scegli la cartella di Proton Drive"

#: ui/qml/main.qml:35
msgid "Choose where Proton Photos are downloaded"
msgstr "Scegli dove scaricare Proton Photos"

#: ui/qml/main.qml:42
msgid "Choose the folder to upload photos from"
msgstr "Scegli la cartella da cui caricare le foto"

#: ui/qml/main.qml:53
msgid "The folder is not empty"
msgstr "La cartella non è vuota"

#: ui/qml/main.qml:104
msgid "Opened {what}"
msgstr "{what} aperto"

#: ui/qml/main.qml:106
msgid "Could not open {what} ({url})"
msgstr "Impossibile aprire {what} ({url})"

#: ui/qml/main.qml:186
msgid "Account & activity"
msgstr "Account e attività"

#: ui/qml/main.qml:187
msgid "Settings"
msgstr "Impostazioni"

#: ui/qml/main.qml:188 ui/qml/main.qml:633
msgid "Logs"
msgstr "Registri"

#: ui/qml/main.qml:189
msgid "About"
msgstr "Informazioni"

#: ui/qml/main.qml:269
msgid "Not signed in"
msgstr "Accesso non effettuato"

#: ui/qml/main.qml:276
msgid "Signed in to Proton Drive"
msgstr "Accesso effettuato a Proton Drive"

#: ui/qml/main.qml:277
msgid "Sign in to sync this computer with Proton Drive."
msgstr "Accedi per sincronizzare questo computer con Proton Drive."

#: ui/qml/main.qml:294
msgid "Storage:"
msgstr "Spazio di archiviazione:"

#: ui/qml/main.qml:323
msgid "{used} of {total} used"
msgstr "{used} di {total} utilizzati"

#: ui/qml/main.qml:331
msgid "Account:"
msgstr "Account:"

#: ui/qml/main.qml:334
msgid "Sign in"
msgstr "Accedi"

#. TRANSLATORS: button that reloads the account details from Proton
#: ui/qml/main.qml:341
msgid "Refresh"
msgstr "Aggiorna"

#: ui/qml/main.qml:350
msgid "On the web:"
msgstr "Sul web:"

#: ui/qml/main.qml:353
msgid "Drive on the web"
msgstr "Drive sul web"

#: ui/qml/main.qml:358
msgid "Proton account"
msgstr "Account Proton"

#: ui/qml/main.qml:366
msgid "Activity"
msgstr "Attività"

#: ui/qml/main.qml:373
msgid "Sync:"
msgstr "Sincronizzazione:"

#: ui/qml/main.qml:404
msgid "Resume"
msgstr "Riprendi"

#: ui/qml/main.qml:404
msgid "Pause"
msgstr "Sospendi"

#: ui/qml/main.qml:429
msgid "Files"
msgstr "File"

#: ui/qml/main.qml:433
msgid "Sync folder:"
msgstr "Cartella sincronizzata:"

#: ui/qml/main.qml:437
msgid "nowhere yet"
msgstr "ancora nessuna posizione"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:443 ui/qml/main.qml:490 ui/qml/main.qml:533
msgid "Change…"
msgstr "Cambia…"

#: ui/qml/main.qml:450
msgid "Ignored paths:"
msgstr "Percorsi esclusi:"

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves
#. alone
#: ui/qml/main.qml:452
msgid "Ignore file…"
msgstr "File di esclusione…"

#: ui/qml/main.qml:459
msgid "Photos"
msgstr "Foto"

#: ui/qml/main.qml:463
msgid "Download:"
msgstr "Scaricamento:"

#: ui/qml/main.qml:467
msgid "Also download Proton Photos"
msgstr "Scarica anche Proton Photos"

#: ui/qml/main.qml:473
msgid ""
"Your timeline is copied here every half hour. Nothing in Proton Photos is "
"changed or deleted by it."
msgstr ""
"La tua cronologia viene copiata qui ogni mezz'ora. Nulla in Proton Photos "
"viene modificato o eliminato."

#: ui/qml/main.qml:481
msgid "Download folder:"
msgstr "Cartella di scaricamento:"

#: ui/qml/main.qml:485
msgid "your Pictures folder"
msgstr "la tua cartella Immagini"

#: ui/qml/main.qml:497
msgid "Upload:"
msgstr "Caricamento:"

#: ui/qml/main.qml:501
msgid "Upload photos from a folder"
msgstr "Carica foto da una cartella"

#: ui/qml/main.qml:515
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""
"Foto e video messi in questa cartella vengono caricati su Proton Photos "
"entro un minuto, poi lasciano la cartella. Ciò che non può essere caricato "
"resta."

#: ui/qml/main.qml:523
msgid "Upload folder:"
msgstr "Cartella di caricamento:"

#: ui/qml/main.qml:540
msgid "After upload:"
msgstr "Dopo il caricamento:"

#: ui/qml/main.qml:542
msgid "Delete instead of moving to the trash"
msgstr "Elimina invece di spostare nel cestino"

#: ui/qml/main.qml:549
msgid "Network"
msgstr "Rete"

#: ui/qml/main.qml:553 ui/qml/main.qml:598
msgid "Pause while on:"
msgstr "Sospendi con:"

#: ui/qml/main.qml:573
msgid "{network} (connected)"
msgstr "{network} (connessa)"

#: ui/qml/main.qml:584
msgid ""
"Syncing pauses while any ticked network is connected, such as a phone's "
"hotspot. A sync already under way finishes first."
msgstr ""
"La sincronizzazione si sospende finché è connessa una qualsiasi rete "
"selezionata, come l'hotspot di un telefono. Una sincronizzazione già in "
"corso termina prima."

#: ui/qml/main.qml:585
msgid "NetworkManager lists no networks to choose from."
msgstr "NetworkManager non elenca alcuna rete tra cui scegliere."

#: ui/qml/main.qml:594
msgid "Power"
msgstr "Alimentazione"

#: ui/qml/main.qml:604
msgid "AC power"
msgstr "Alimentazione da rete"

#: ui/qml/main.qml:605
msgid "Battery"
msgstr "Batteria"

#: ui/qml/main.qml:606
msgid "Low battery"
msgstr "Batteria scarica"

#: ui/qml/main.qml:614
msgid "{power} (now)"
msgstr "{power} (ora)"

#: ui/qml/main.qml:624
msgid ""
"Low battery is the level set in the system's power management settings. A "
"sync already under way finishes first."
msgstr ""
"Batteria scarica è il livello impostato nelle impostazioni di gestione "
"energetica del sistema. Una sincronizzazione già in corso termina prima."

#: ui/qml/main.qml:637
msgid "Keep logs for:"
msgstr "Conserva i registri per:"

#. TRANSLATORS: after the number in "Keep logs for: [30] days"
#: ui/qml/main.qml:646
msgid "days"
msgstr "giorni"

#. TRANSLATORS: label before a dropdown choosing which log levels are written
#. to disk
#: ui/qml/main.qml:651
msgid "Store:"
msgstr "Memorizza:"

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:656
msgid "Warnings and errors"
msgstr "Avvisi ed errori"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:658
msgid "Everything"
msgstr "Tutto"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:660
msgid "Errors only"
msgstr "Solo errori"

#: ui/qml/main.qml:681
msgid "Search the log"
msgstr "Cerca nel registro"

#: ui/qml/main.qml:686
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n} riga"
msgstr[1] "{n} righe"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:736
msgid "Copy"
msgstr "Copia"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:742
msgid "Select all"
msgstr "Seleziona tutto"

#: ui/qml/main.qml:759
msgid "No lines match"
msgstr "Nessuna riga corrispondente"

#: ui/qml/main.qml:759
msgid "Nothing logged yet"
msgstr "Nessun evento registrato"

#: ui/qml/main.qml:761
msgid "No line since the sync daemon started contains “{term}”."
msgstr ""
"Nessuna riga dall'avvio del servizio di sincronizzazione contiene «{term}»."

#: ui/qml/main.qml:762
msgid "This shows what has happened since the sync daemon started."
msgstr ""
"Qui viene mostrato cosa è successo dall'avvio del servizio di "
"sincronizzazione."

#: ui/qml/main.qml:794
msgid "Proton Drive sync client for KDE Plasma"
msgstr "Client di sincronizzazione Proton Drive per KDE Plasma"


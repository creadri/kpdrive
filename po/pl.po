msgstr "Ostrzeżenia i błędy"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:658
msgid "Everything"
msgstr "Wszystko"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:660
msgid "Errors only"
msgstr "Tylko błędy"

#: ui/qml/main.qml:681
msgid "Search the log"
msgstr "Szukaj w dzienniku"


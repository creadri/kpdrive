#: ui/qml/main.qml:341
msgid "Refresh"
msgstr "刷新"

#: ui/qml/main.qml:350
msgid "On the web:"
msgstr "网页版："

#: ui/qml/main.qml:353
msgid "Drive on the web"
msgstr "网页版 Drive"

#: ui/qml/main.qml:358
msgid "Proton account"
msgstr "Proton 账户"

#: ui/qml/main.qml:366
msgid "Activity"
msgstr "活动"

#: ui/qml/main.qml:373
msgid "Sync:"
msgstr "同步："

#: ui/qml/main.qml:404
msgid "Resume"
msgstr "继续"

#: ui/qml/main.qml:404
msgid "Pause"
msgstr "暂停"

#: ui/qml/main.qml:429
msgid "Files"
msgstr "文件"

#: ui/qml/main.qml:433
msgid "Sync folder:"
msgstr "同步文件夹："

#: ui/qml/main.qml:437
msgid "nowhere yet"
msgstr "尚未设置"

#. TRANSLATORS: button that opens a folder picker to sync somewhere else
#: ui/qml/main.qml:443 ui/qml/main.qml:490 ui/qml/main.qml:533
msgid "Change…"
msgstr "更改…"

#: ui/qml/main.qml:450
msgid "Ignored paths:"
msgstr "忽略的路径："

#. TRANSLATORS: button that opens .protonignore, the list of paths sync leaves
#. alone
#: ui/qml/main.qml:452
msgid "Ignore file…"
msgstr "忽略文件…"

#: ui/qml/main.qml:459
msgid "Photos"
msgstr "照片"

#: ui/qml/main.qml:463
msgid "Download:"
msgstr "下载："

#: ui/qml/main.qml:467
msgid "Also download Proton Photos"
msgstr "同时下载 Proton Photos"

#: ui/qml/main.qml:473
msgid ""
"Your timeline is copied here every half hour. Nothing in Proton Photos is "
"changed or deleted by it."
msgstr ""
"您的时间线每半小时复制到此处一次。这不会更改或删除 Proton Photos 中的任何内"
"容。"

#: ui/qml/main.qml:481
msgid "Download folder:"
msgstr "下载文件夹："

#: ui/qml/main.qml:485
msgid "your Pictures folder"
msgstr "您的图片文件夹"

#: ui/qml/main.qml:497
msgid "Upload:"
msgstr "上传："

#: ui/qml/main.qml:501
msgid "Upload photos from a folder"
msgstr "从文件夹上传照片"

#: ui/qml/main.qml:515
msgid ""
"Photos and videos put in this folder go up to Proton Photos within a minute, "
"then leave the folder. Anything that cannot be uploaded stays."
msgstr ""
"放入此文件夹的照片和视频会在一分钟内上传到 Proton Photos，然后从该文件夹中移"
"除。无法上传的内容会保留。"

#: ui/qml/main.qml:523
msgid "Upload folder:"
msgstr "上传文件夹："

#: ui/qml/main.qml:540
msgid "After upload:"
msgstr "上传后："

#: ui/qml/main.qml:542
msgid "Delete instead of moving to the trash"
msgstr "直接删除，而不是移到回收站"

#: ui/qml/main.qml:549
msgid "Network"
msgstr "网络"

#: ui/qml/main.qml:553 ui/qml/main.qml:598
msgid "Pause while on:"
msgstr "以下情况时暂停："

#: ui/qml/main.qml:573
msgid "{network} (connected)"
msgstr "{network}（已连接）"

#: ui/qml/main.qml:584
msgid ""
"Syncing pauses while any ticked network is connected, such as a phone's "
"hotspot. A sync already under way finishes first."
msgstr ""
"连接到任一勾选的网络（例如手机热点）时，同步会暂停。已在进行的同步会先完成。"

#: ui/qml/main.qml:585
msgid "NetworkManager lists no networks to choose from."
msgstr "NetworkManager 未列出可供选择的网络。"

#: ui/qml/main.qml:594
msgid "Power"
msgstr "电源"

#: ui/qml/main.qml:604
msgid "AC power"
msgstr "交流电源"

#: ui/qml/main.qml:605
msgid "Battery"
msgstr "电池"

#: ui/qml/main.qml:606
msgid "Low battery"
msgstr "电量低"

#: ui/qml/main.qml:614
msgid "{power} (now)"
msgstr "{power}（当前）"

#: ui/qml/main.qml:624
msgid ""
"Low battery is the level set in the system's power management settings. A "
"sync already under way finishes first."
msgstr "电量低是指系统电源管理设置中设定的电量水平。已在进行的同步会先完成。"

#: ui/qml/main.qml:637
msgid "Keep logs for:"
msgstr "日志保留："

#. TRANSLATORS: after the number in "Keep logs for: [30] days"
#: ui/qml/main.qml:646
msgid "days"
msgstr "天"

#. TRANSLATORS: label before a dropdown choosing which log levels are written
#. to disk
#: ui/qml/main.qml:651
msgid "Store:"
msgstr "保存："

#. TRANSLATORS: dropdown choice, store warnings and errors only
#: ui/qml/main.qml:656
msgid "Warnings and errors"
msgstr "警告和错误"

#. TRANSLATORS: dropdown choice, store every log line
#: ui/qml/main.qml:658
msgid "Everything"
msgstr "所有内容"

#. TRANSLATORS: dropdown choice, store errors only
#: ui/qml/main.qml:660
msgid "Errors only"
msgstr "仅错误"

#: ui/qml/main.qml:681
msgid "Search the log"
msgstr "搜索日志"

#: ui/qml/main.qml:686
msgid "{n} line"
msgid_plural "{n} lines"
msgstr[0] "{n}条"

#. TRANSLATORS: right-click menu item, copies the selected log text
#: ui/qml/main.qml:736
msgid "Copy"
msgstr "复制"

#. TRANSLATORS: right-click menu item, selects the whole log view
#: ui/qml/main.qml:742
msgid "Select all"
msgstr "全选"

#: ui/qml/main.qml:759
msgid "No lines match"
msgstr "没有匹配的行"

#: ui/qml/main.qml:759
msgid "Nothing logged yet"
msgstr "尚无日志记录"

#: ui/qml/main.qml:761
msgid "No line since the sync daemon started contains “{term}”."
msgstr "自同步守护进程启动以来，没有包含“{term}”的日志行。"

#: ui/qml/main.qml:762
msgid "This shows what has happened since the sync daemon started."
msgstr "此处显示同步守护进程启动以来发生的事件。"

#: ui/qml/main.qml:794
msgid "Proton Drive sync client for KDE Plasma"
msgstr "适用于 KDE Plasma 的 Proton Drive 同步客户端"


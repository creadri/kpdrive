#: src/daemon.rs:102
msgid "Signed out. Sign in from the account window."
msgstr "已退出登录。请在账户窗口中登录。"

#: src/daemon.rs:104 src/daemon.rs:371
msgid "Syncing…"
msgstr "正在同步…"

#: src/daemon.rs:106 src/daemon.rs:374
msgid "{n} item in sync"
msgid_plural "{n} items in sync"
msgstr[0] "{n}项已同步"

#: src/daemon.rs:116 ui/qml/main.qml:382
msgid "Open folder"
msgstr "打开文件夹"

#: src/daemon.rs:126
msgid "Account and logs…"
msgstr "账户与日志…"

#: src/daemon.rs:133 ui/qml/main.qml:360
msgid "Sync now"
msgstr "立即同步"

#: src/daemon.rs:143
msgid "Quit"
msgstr "退出"

#. TRANSLATORS: {reason} is a sentence, e.g. "cannot reach Proton Drive: no route"
#: src/daemon.rs:303
msgid "{reason}; retrying"
msgstr "{reason}；正在重试"

#: src/daemon.rs:314
msgid "Proton Drive is reachable again, after {duration}"
msgstr "经过{duration}后，Proton Drive 恢复连接"

#: src/daemon.rs:325
msgid "{n} second"
msgid_plural "{n} seconds"
msgstr[0] "{n}秒"

#: src/daemon.rs:326
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n}分钟"

#: src/daemon.rs:327
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n}小时"

#: src/daemon.rs:355
msgid "The sync daemon is not running. Start it with: kpdrive sync --watch"
msgstr "同步守护进程未运行。请使用以下命令启动：kpdrive sync --watch"

#: src/daemon.rs:358
msgid ""
"A sync daemon is running but is too old to say what it is doing. Restart it."
msgstr "同步守护进程正在运行，但版本过旧，无法报告当前状态。请重新启动。"

#: src/daemon.rs:361
msgid "Signed out. Syncing resumes once you sign in."
msgstr "已退出登录。登录后将恢复同步。"

#: src/daemon.rs:365
msgid "{reason}. Still trying."
msgstr "{reason}。仍在重试。"

#: src/daemon.rs:366
msgid "Last sync failed: {reason}"
msgstr "上次同步失败：{reason}"

#. TRANSLATORS: how long ago the last sync ran; fills {ago} below
#: src/daemon.rs:380
msgid "just now"
msgstr "刚刚"

#: src/daemon.rs:382
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n}分钟前"

#: src/daemon.rs:385
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n}小时前"

#. TRANSLATORS: {items} is "5 items in sync", {ago} is "just now" or "3 minutes ago"
#: src/daemon.rs:389
msgid "{items}, checked {ago}"
msgstr "{items}，{ago}检查过"

#: src/daemon.rs:606
msgid "Signed in again. Syncing resumed."
msgstr "已重新登录。同步已恢复。"

#: src/daemon.rs:660
msgid "Signed out. Sign in from the account window to resume syncing."
msgstr "已退出登录。请在账户窗口中登录以恢复同步。"

#: src/daemon.rs:693
msgid "Sync resumed"
msgstr "同步已恢复"

#: src/daemon.rs:710
msgid "{n} photo downloaded"
msgid_plural "{n} photos downloaded"
msgstr[0] "已下载{n}张照片"

#: src/daemon.rs:731
#, fuzzy
msgid "{n} photo uploaded to Proton Photos"
msgid_plural "{n} photos uploaded to Proton Photos"
msgstr[0] "同时下载 Proton Photos"

#: src/i18n.rs:155 ui/qml/main.qml:405
msgid "Sign out"
msgstr "退出登录"

#: src/i18n.rs:156 src/i18n.rs:157
msgid "{n} photo"
msgid_plural "{n} photos"
msgstr[0] "{n}张照片"

#: src/sync.rs:121
msgid "Sync into it and keep what is already there"
msgstr "同步到该文件夹并保留其中已有的内容"

#: src/sync.rs:122
msgid "Move it aside and start from an empty folder"
msgstr "将该文件夹移到一旁，从空文件夹开始"

#: src/sync.rs:160
msgid ""
"{folder} already holds {n} item, which syncing will merge with Proton Drive."
msgid_plural ""
"{folder} already holds {n} items, which syncing will merge with Proton Drive."
msgstr[0] "{folder} 中已有{n}项内容，同步时会将其与 Proton Drive 合并。"

#: ui/src/bridge.rs:189
msgid "Starting…"
msgstr "正在启动…"

#: ui/src/bridge.rs:233
msgid "Confirm the code {code} in your browser"
msgstr "请在浏览器中确认代码 {code}"

#: ui/src/bridge.rs:247
msgid "Sign-in failed: {reason}"
msgstr "登录失败：{reason}"

#: ui/src/bridge.rs:259
msgid "Signed out"
msgstr "已退出登录"

#: ui/src/bridge.rs:262
msgid "Sign-out failed: {reason}"
msgstr "退出登录失败：{reason}"

#: ui/src/bridge.rs:324
msgid "{note}. Restart the sync daemon to use it."
msgstr "{note}。请重新启动同步守护进程以使其生效。"

#: ui/src/bridge.rs:327
msgid "Cannot change the folder: {reason}"
msgstr "无法更改文件夹：{reason}"

#: ui/src/bridge.rs:334
msgid "No sync folder yet. Run: kpdrive setup"
msgstr "尚未设置同步文件夹。请运行：kpdrive setup"

#: ui/src/bridge.rs:338
msgid "Cannot create the ignore file: {reason}"
msgstr "无法创建忽略文件：{reason}"

#: ui/src/bridge.rs:375
msgid "Checking the account…"
msgstr "正在检查账户…"

#: ui/src/bridge.rs:381
msgid "Opening the browser…"
msgstr "正在打开浏览器…"

#: ui/src/bridge.rs:387
msgid "Signing out…"
msgstr "正在退出登录…"

#: ui/src/bridge.rs:413
msgid "Cannot read the log: {reason}"
msgstr "无法读取日志：{reason}"

#: ui/src/bridge.rs:423 ui/src/bridge.rs:451 ui/src/bridge.rs:467
#: ui/src/bridge.rs:480 ui/src/bridge.rs:498
msgid "Cannot save the setting: {reason}"
msgstr "无法保存设置：{reason}"

#: ui/src/bridge.rs:431
msgid "Proton Photos will be downloaded with the next sync"
msgstr "将在下次同步时下载 Proton Photos"

#: ui/src/bridge.rs:432
msgid "Proton Photos will be left alone"
msgstr "将不会同步 Proton Photos"

#: ui/src/bridge.rs:457
msgid "Photos put in that folder will be uploaded to Proton Photos"
msgstr ""

#: ui/src/bridge.rs:458
msgid "No longer uploading photos"
msgstr ""

#: ui/src/bridge.rs:485
msgid "Storing everything from now on"
msgstr "此后将记录所有内容"

#: ui/src/bridge.rs:486
msgid "Storing warnings and errors from now on"
msgstr "此后将记录警告和错误"

#: ui/src/bridge.rs:487
msgid "Storing errors from now on"
msgstr "此后将仅记录错误"

#: ui/src/bridge.rs:503
msgid "removed {n} log file older than {days} days"
msgid_plural "removed {n} log files older than {days} days"
msgstr[0] "已删除{n}个超过{days}天的日志文件"

#: ui/src/bridge.rs:504
msgid "Cannot prune the log: {reason}"
msgstr "无法清理日志：{reason}"

#: ui/qml/main.qml:26
msgid "Choose the Proton Drive folder"
msgstr "选择 Proton Drive 文件夹"

#: ui/qml/main.qml:34
msgid "Choose the folder to upload photos from"
msgstr ""

#: ui/qml/main.qml:45
msgid "The folder is not empty"
msgstr "该文件夹不为空"

#: ui/qml/main.qml:80
msgid "Opened {what}"
msgstr "已打开{what}"

#: ui/qml/main.qml:82
msgid "Could not open {what} ({url})"
msgstr "无法打开{what}（{url}）"


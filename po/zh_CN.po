msgstr "该文件夹不为空"

#: ui/qml/main.qml:80
msgid "Remove {account}?"
msgstr "移除 {account}？"

#: ui/qml/main.qml:81
msgid ""
"kpdrive signs this account out and forgets what it synced. The files in "
"{folder} stay where they are."
msgstr ""
"kpdrive 会退出此账户的登录并忘记已同步的内容。{folder} 中的文件会保留在原处。"

#: ui/qml/main.qml:82
msgid "its folder"
msgstr "其文件夹"

#: ui/qml/main.qml:86
msgid "Remove account"
msgstr "移除账户"


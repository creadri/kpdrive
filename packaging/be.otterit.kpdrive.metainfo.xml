<?xml version="1.0" encoding="UTF-8"?>
<!-- What Discover and GNOME Software show for kpdrive. The release list is
     written by scripts/changelog.sh from CHANGELOG.md. -->
<component type="desktop-application">
  <id>be.otterit.kpdrive</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>kpdrive</name>
  <summary>Proton Drive sync client for KDE Plasma</summary>
  <developer id="be.otterit">
    <name>Adrien Nelis</name>
  </developer>
  <description>
    <p>
      kpdrive keeps a local folder in step with Proton Drive, in both
      directions and end to end encrypted. It runs as a daemon with a Plasma
      tray icon and is not affiliated with Proton AG.
    </p>
    <ul>
      <li>Two-way sync of the Proton Drive main folder</li>
      <li>Public links, copied from the Dolphin context menu</li>
      <li>Overlay icons in Dolphin showing what is up to date</li>
      <li>Download of the Photos timeline</li>
      <li>A .protonignore file with the same syntax as .gitignore</li>
    </ul>
  </description>
  <launchable type="desktop-id">be.otterit.kpdrive.desktop</launchable>
  <url type="homepage">https://github.com/creadri/kpdrive</url>
  <url type="bugtracker">https://github.com/creadri/kpdrive/issues</url>
  <url type="vcs-browser">https://github.com/creadri/kpdrive</url>
  <screenshots>
    <screenshot type="default">
      <caption>Account, storage in use and the activity log</caption>
      <image>https://raw.githubusercontent.com/creadri/kpdrive/dev/docs/screenshots/kpdrive-main-ui-0.2.0.png</image>
    </screenshot>
  </screenshots>
  <categories>
    <category>Utility</category>
    <category>FileTools</category>
  </categories>
  <provides>
    <binary>kpdrive</binary>
    <binary>kpdrive-ui</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.4.1" date="2026-09-23"/>
    <release version="0.4.0" date="2026-09-23"/>
    <release version="0.3.0" date="2026-09-21"/>
    <release version="0.2.0" date="2026-09-20"/>
    <release version="0.1.0" date="2026-09-20"/>
  </releases>
</component>
